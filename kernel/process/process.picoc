#include "../process.header"
#include "../process_arguments.header"
#include "../process_loader.header"
#include "../kernel.header"
#include "../kmalloc.header"
#include "../pmalloc.header"
#include "../shared_memory.header"
#include "../signal.header"
#include "../dispatcher.header"
#include "../filesystem/file_descriptor.header"
#include "../filesystem/filesystem.header"
#include "../filesystem/host_filesystem.header"
#include "../../common/file.header"
#include "../../common/uart_protocol.header"

struct Process *process_list_head = NULL;
struct Process *process_list_tail = NULL;
struct Process *active_process = NULL;
int next_process_id = 1;

void initialize_process_table(void) {
    process_list_head = NULL;
    process_list_tail = NULL;
    active_process = NULL;
    next_process_id = 1;
}

struct Process *first_process(void) {
    return process_list_head;
}

void list_processes(void) {
    struct Process *process = first_process();
    struct IoRequest request;
    char line[PATH_MAX + 16];
    int index;
    int path_index;

    while (process != NULL) {
        index = uart_append_decimal(line, 0, process->pid);
        line[index] = ' ';
        index = index + 1;
        path_index = 0;
        while (process->binary_path[path_index] != '\0') {
            line[index] = process->binary_path[path_index];
            index = index + 1;
            path_index = path_index + 1;
        }
        line[index] = '\n';
        request.file_descriptor = STDOUT_FILENO;
        request.buffer = line;
        request.count = index + 1;
        request.show_loading_bar = false;
        write_file_descriptor(&request);
        process = process->next;
    }
}

struct Process *current_process(void) {
    return active_process;
}

void set_current_process(struct Process *process) {
    active_process = process;
}

char *copy_process_path(char *path) {
    int length = 0;
    int index = 0;
    char *copy;

    while (path[length] != '\0') {
        length = length + 1;
    }

    // The caller's path buffer need not outlive the process, so the PCB owns a copy
    copy = (char *)kmalloc(length + 1);
    while (index < length) {
        copy[index] = path[index];
        index = index + 1;
    }
    copy[index] = '\0';
    return copy;
}

struct Process *create_process(
    int base_address,
    int size,
    int code_start,
    int data_start,
    int heap_start,
    int heap_size,
    char *binary_path
) {
    struct Process *process = (struct Process *)kmalloc(sizeof(struct Process));
    struct Process *parent = current_process();
    int stack_pointer = base_address + size - 1;

    process->pid = next_process_id;
    next_process_id = next_process_id + 1;
    process->state = PROCESS_STATE_NEW;
    process->base_address = base_address;
    process->size = size;
    process->heap_start = heap_start;
    process->heap_size = heap_size;
    process->binary_path = copy_process_path(binary_path);
    process->file_descriptors = create_file_descriptor_table();

    process->activation.in1 = 0;
    process->activation.in2 = 0;
    process->activation.acc = 0;
    /*
     * RTI loads PC from memory[SP + 1], increments SP, and then advances PC.
     * Store CS - 1 so a new process starts at the first instruction of _start.
     * BAF represents an imaginary outer stack frame
     */
    process->activation.sp = stack_pointer - 1;
    process->activation.baf = stack_pointer;
    process->activation.cs = base_address + code_start;
    process->activation.ds = base_address + data_start;
    process->waiting_status_ptr = NULL;
    process->waiters.head = NULL;
    process->waiters.tail = NULL;
    process->waiting_queue_ptr = NULL;
    process->wait_next = NULL;
    process->shared_memory_attachments = NULL;
    process->parent_pid = 0;
    process->parent_death_signal = 0;
    if (parent != NULL) {
        process->parent_pid = parent->pid;
        process->parent_death_signal = parent->parent_death_signal;
        process->working_directory = copy_process_path(
            parent->working_directory
        );
    } else {
        process->working_directory = NULL;
        initialize_working_directory(process);
    }
    if (process->working_directory == NULL) {
        destroy_file_descriptor_table(process->file_descriptors);
        kfree(process->binary_path);
        kfree(process);
        return NULL;
    }
    process->exit_status = 0;
    process->stop_signal = 0;
    process->stopped_from_state = PROCESS_STATE_READY;
    process->pending_termination_signal = 0;
    process->pending_terminal_read_buffer = NULL;
    process->pending_terminal_read_count = 0;
    process->pending_load = NULL;
    *((int *)stack_pointer) = process->activation.cs - 1;

    process->next = NULL;
    if (process_list_head == NULL) {
        process_list_head = process;
        process_list_tail = process;
    } else {
        process_list_tail->next = process;
        process_list_tail = process;
    }

    return process;
}

struct Process *find_process_by_pid(int pid) {
    struct Process *process = process_list_head;

    while (process != NULL) {
        if (process->pid == pid) {
            return process;
        }

        process = process->next;
    }

    return NULL;
}

void remove_from_wait_queue(struct Process *process) {
    if (process->waiting_queue_ptr == NULL) {
        return;
    }

    struct wait_queue *queue = process->waiting_queue_ptr;
    struct Process *previous = NULL;
    struct Process *candidate = queue->head;

    // A wait queue is intrusive: a process can be on only one queue at a time
    while (candidate != NULL && candidate != process) {
        previous = candidate;
        candidate = candidate->wait_next;
    }

    if (candidate == NULL) {
        return;
    }

    if (previous == NULL) {
        queue->head = candidate->wait_next;
    } else {
        previous->wait_next = candidate->wait_next;
    }

    if (queue->tail == candidate) {
        queue->tail = previous;
    }

    candidate->waiting_queue_ptr = NULL;
    candidate->wait_next = NULL;
}

void remove_process(struct Process *process) {
    struct Process *previous = NULL;
    struct Process *candidate = process_list_head;

    while (candidate != NULL && candidate != process) {
        previous = candidate;
        candidate = candidate->next;
    }

    if (candidate == NULL) {
        return;
    }

    // A blocked process must be unlinked before its PCB is freed; otherwise a
    // later wakeup would follow a dangling queue entry
    remove_from_wait_queue(candidate);

    if (previous == NULL) {
        process_list_head = candidate->next;
    } else {
        previous->next = candidate->next;
    }

    if (process_list_tail == candidate) {
        process_list_tail = previous;
    }

    if (active_process == candidate) {
        active_process = previous;
    }

    release_process_shared_memory(candidate);
    cancel_process_load(candidate);
    pfree(candidate->base_address);
    destroy_file_descriptor_table(candidate->file_descriptors);
    kfree(candidate->binary_path);
    kfree(candidate->working_directory);
    kfree(candidate);
}

bool process_has_waiting_parent(struct Process *process) {
    struct Process *waiting_process = process->waiters.head;

    while (waiting_process != NULL) {
        if (waiting_process->pid == process->parent_pid) {
            return true;
        }
        waiting_process = waiting_process->wait_next;
    }
    return false;
}

void wake_parent_waiting_for_process(
    struct Process *process,
    int status
) {
    struct Process *waiting_process;

    while (process->waiters.head != NULL) {
        waiting_process = process->waiters.head;
        if (waiting_process->pid == process->parent_pid) {
            if (waiting_process->waiting_status_ptr != NULL) {
                *(waiting_process->waiting_status_ptr) = status;
            }
            waiting_process->waiting_status_ptr = NULL;
        }
        wakeup_wait_queue(&(process->waiters));
    }
}

void orphan_and_signal_children(struct Process *parent) {
    struct Process *child;

    while (true) {
        child = process_list_head;
        while (child != NULL &&
               child->parent_pid != parent->pid) {
            child = child->next;
        }
        if (child == NULL) {
            return;
        }

        child->parent_pid = 0;
        if (child->state == PROCESS_STATE_ZOMBIE) {
            remove_process(child);
        } else if (child->parent_death_signal != 0) {
            send_signal_to_process(
                child,
                child->parent_death_signal
            );
        }
    }
}

void terminate_process(struct Process *process, int status) {
    struct Process *parent;
    bool parent_is_waiting;

    if (process == NULL ||
        process->state == PROCESS_STATE_ZOMBIE) {
        return;
    }

    orphan_and_signal_children(process);
    parent = find_process_by_pid(process->parent_pid);
    parent_is_waiting =
        parent != NULL && process_has_waiting_parent(process);

    process->exit_status = status;
    process->state = PROCESS_STATE_ZOMBIE;
    wake_parent_waiting_for_process(process, status);
    // A parent that was already waiting has received the status, while an
    // orphan has nobody that could collect it
    if (parent == NULL || parent_is_waiting) {
        remove_process(process);
    }
}

bool unload_process_by_pid(int pid) {
    struct Process *process = process_list_head;

    while (process != NULL && process->pid != pid) {
        process = process->next;
    }

    // Removing the running process requires the exit path to switch context
    if (process == NULL || process == active_process) {
        return false;
    }

    terminate_process(process, PROCESS_EXIT_STATUS_SUCCESS);
    process = find_process_by_pid(pid);
    if (process != NULL) {
        remove_process(process);
    }
    return true;
}

void remove_test_processes(void) {
    struct Process *process = process_list_head;
    struct Process *next_process;

    while (process != NULL) {
        next_process = process->next;
        // Init, the shell, and the syscall caller keep the test session alive
        if (process->pid != 1 &&
            process->pid != 2 &&
            process != active_process) {
            remove_process(process);
        }
        process = next_process;
    }

    // A shell reset restores the PID sequence of a freshly started shell
    if (active_process != NULL && active_process->pid == 2) {
        next_process_id = 3;
    }
}

bool wait_for_process_by_pid(struct WaitPidRequest *request, int *caller_context) {
    struct Process *process = current_process();
    struct Process *waited_process;

    waited_process = find_process_by_pid(request->pid);
    if (waited_process == NULL ||
        waited_process->parent_pid != process->pid) {
        *(request->status) = -1;
        return true;
    }
    if (waited_process->state == PROCESS_STATE_ZOMBIE) {
        *(request->status) = waited_process->exit_status;
        remove_process(waited_process);
        return true;
    }
    if (waited_process->state == PROCESS_STATE_STOPPED) {
        *(request->status) = 128 + waited_process->stop_signal;
        return true;
    }

    // waitpid() stores a pointer to its stack-local return status in request->status.
    // When the target exits, it writes its status back through this pointer
    process->waiting_status_ptr = request->status;
    sleep_on_wait_queue(&(waited_process->waiters), caller_context);
    return false;
}

void enqueue_current_process_on_wait_queue(struct wait_queue *queue) {
    struct Process *process = current_process();

    // wait_next is shared by all wait queues
    process->wait_next = NULL;
    process->waiting_queue_ptr = queue;
    if (queue->tail == NULL) {
        queue->head = process;
    } else {
        queue->tail->wait_next = process;
    }
    queue->tail = process;
    process->state = PROCESS_STATE_BLOCKED;
}

void sleep_on_wait_queue(struct wait_queue *queue, int *caller_context) {
    enqueue_current_process_on_wait_queue(queue);
    dispatcher_switch_from_context(caller_context);
}

bool wakeup_wait_queue(struct wait_queue *queue) {
    struct Process *process;

    if (queue->head == NULL) {
        return false;
    }

    process = queue->head;
    queue->head = process->wait_next;
    if (queue->head == NULL) {
        queue->tail = NULL;
    }

    process->wait_next = NULL;
    process->waiting_queue_ptr = NULL;
    if (process->state == PROCESS_STATE_STOPPED) {
        process->stopped_from_state = PROCESS_STATE_READY;
    } else {
        process->state = PROCESS_STATE_READY;
    }
    return true;
}

int process_heap_start(void) {
    struct Process *process = current_process();

    return process->base_address + process->heap_start;
}

int process_heap_size(void) {
    struct Process *process = current_process();

    return process->heap_size;
}

void exit_process(int status) {
    terminate_process(current_process(), status);
    dispatcher_start_next_process();
    // Switching to a next process returns via RTI; shutdown is only reached when none remain
    shutdown();
}
