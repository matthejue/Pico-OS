#include "standard_input.header"
#include "../dispatcher.header"
#include "../interrupt_controller.header"
#include "../periphery.header"
#include "../process.header"

#define UART_RECEIVE_REGISTER 1
#define UART_STATUS_REGISTER 2
#define UART_RECEIVE_READY 2

int pop_stdin_byte(struct FileDescriptorTable *table) {
    int value = table->stdin_buffer[table->stdin_head];

    table->stdin_head = (table->stdin_head + 1) % STDIN_BUFFER_CAPACITY;
    table->stdin_count = table->stdin_count - 1;
    return value;
}

int copy_stdin_bytes(
    struct FileDescriptorTable *table,
    char *buffer,
    int count
) {
    int copied = 0;

    while (copied < count && table->stdin_count > 0) {
        buffer[copied] = pop_stdin_byte(table);
        copied = copied + 1;
    }
    return copied;
}

int begin_stdin_read(
    struct FileDescriptorTable *table,
    char *buffer,
    int count,
    bool character_read,
    int *caller_context
) {
    int uart_interrupt_index;
    int uart_interrupt_priority;

    uart_interrupt_index = periphery_read_register(
        INTERRUPT_CONTROLLER_UART_DEVICE_TO_ISR_REGISTER
    );
    uart_interrupt_priority = periphery_read_register(
        INTERRUPT_CONTROLLER_UART_DEVICE_PRIORITY_REGISTER
    );
    interrupt_controller_disable_device(INTERRUPT_DEVICE_UART);

    if (table->stdin_count > 0) {
        interrupt_controller_assign_device(
            INTERRUPT_DEVICE_UART,
            uart_interrupt_index,
            uart_interrupt_priority
        );
        if (character_read) {
            return pop_stdin_byte(table);
        }
        return copy_stdin_bytes(table, buffer, count);
    }

    table->pending_read_buffer = buffer;
    table->pending_read_count = count;
    table->pending_character_read = character_read;
    enqueue_current_process_on_wait_queue(&(table->stdin_waiters));
    interrupt_controller_assign_device(
        INTERRUPT_DEVICE_UART,
        uart_interrupt_index,
        uart_interrupt_priority
    );
    dispatcher_switch_from_context(caller_context);
    return 1;
}

int read_stdin_character(int *caller_context) {
    struct FileDescriptorTable *table = current_process()->file_descriptors;

    return begin_stdin_read(table, NULL, 1, true, caller_context);
}

void enqueue_stdin_byte(struct FileDescriptorTable *table, int value) {
    if (table->stdin_count == STDIN_BUFFER_CAPACITY) {
        table->stdin_head =
            (table->stdin_head + 1) % STDIN_BUFFER_CAPACITY;
        table->stdin_count = table->stdin_count - 1;
    }

    table->stdin_buffer[table->stdin_tail] = value;
    table->stdin_tail =
        (table->stdin_tail + 1) % STDIN_BUFFER_CAPACITY;
    table->stdin_count = table->stdin_count + 1;
}

void complete_pending_stdin_read(
    struct Process *process,
    struct FileDescriptorTable *table
) {
    int result;

    if (table->stdin_waiters.head == NULL) {
        return;
    }

    if (table->pending_character_read) {
        result = pop_stdin_byte(table);
    } else {
        result = copy_stdin_bytes(
            table,
            table->pending_read_buffer,
            table->pending_read_count
        );
    }

    process->activation.acc = result;
    table->pending_read_buffer = NULL;
    table->pending_read_count = 0;
    table->pending_character_read = false;
    wakeup_wait_queue(&(table->stdin_waiters));
}

void handle_uart_interrupt(void) {
    struct Process *process = current_process();
    struct FileDescriptorTable *table;
    int value;
    int status;

    value = periphery_read_register(UART_RECEIVE_REGISTER) & 255;
    status = periphery_read_register(UART_STATUS_REGISTER);
    periphery_write_register(
        UART_STATUS_REGISTER,
        status | UART_RECEIVE_READY
    );

    if (process == NULL || process->file_descriptors == NULL) {
        return;
    }

    table = process->file_descriptors;
    enqueue_stdin_byte(table, value);
    complete_pending_stdin_read(process, table);
}
