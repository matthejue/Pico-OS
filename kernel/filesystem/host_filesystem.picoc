#include "host_filesystem.header"
#include "../kmalloc.header"
#include "../process/process.header"
#include "../../common/file.header"
#include "../../common/string.header"
#include "../../common/uart_protocol.header"

int receive_byte_over_uart(void);

int uart_receive_string(char *buffer, int capacity) {
    int byte_count = receive_word();
    int index = 0;
    int value;

    if (byte_count < 0) {
        buffer[0] = '\0';
        return -1;
    }
    while (index < byte_count) {
        value = receive_byte_over_uart();
        if (index < capacity - 1) {
            buffer[index] = value;
        }
        index = index + 1;
    }
    if (byte_count < capacity) {
        buffer[byte_count] = '\0';
    } else {
        buffer[capacity - 1] = '\0';
    }
    if (byte_count >= capacity) {
        return -1;
    }
    return byte_count;
}

bool append_path_segments(
    char *path,
    char *result,
    int *result_length,
    int capacity
) {
    int index = 0;
    int segment_start;
    int segment_length;
    int copy_index;

    while (path[index] != '\0') {
        while (path[index] == '/') {
            index = index + 1;
        }
        segment_start = index;
        while (path[index] != '\0' && path[index] != '/') {
            index = index + 1;
        }
        segment_length = index - segment_start;
        if (segment_length > 0 && !(
                segment_length == 1 && path[segment_start] == '.'
            )) {
            if (segment_length == 2 &&
                path[segment_start] == '.' &&
                path[segment_start + 1] == '.') {
                while (*result_length > 1 &&
                       result[*result_length - 1] != '/') {
                    *result_length = *result_length - 1;
                }
                if (*result_length > 1) {
                    *result_length = *result_length - 1;
                }
            } else {
                if (*result_length > 1) {
                    if (*result_length + segment_length + 1 >= capacity) {
                        return false;
                    }
                    result[*result_length] = '/';
                    *result_length = *result_length + 1;
                } else if (*result_length + segment_length >= capacity) {
                    return false;
                }
                copy_index = 0;
                while (copy_index < segment_length) {
                    result[*result_length] = path[segment_start + copy_index];
                    *result_length = *result_length + 1;
                    copy_index = copy_index + 1;
                }
            }
        }
    }
    return true;
}

bool build_process_path(char *path, char *result, int capacity) {
    int result_length = 1;

    result[0] = '/';
    if (path[0] != '/') {
        if (!append_path_segments(
                current_process()->working_directory,
                result,
                &result_length,
                capacity
            )) {
            return false;
        }
    }
    if (!append_path_segments(
            path,
            result,
            &result_length,
            capacity
        )) {
        return false;
    }
    result[result_length] = '\0';
    return true;
}

char *system_relative_path(char *path) {
    char *directory = system_working_directory();
    int index = 0;

    if (directory == NULL || path[0] != '/') {
        return path;
    }
    while (directory[index] != '\0' &&
           directory[index] == path[index]) {
        index = index + 1;
    }
    if (directory[index] != '\0') {
        return path;
    }
    if (path[index] == '\0') {
        return ".";
    }
    if (index == 1 && directory[0] == '/') {
        return path + 1;
    }
    if (path[index] != '/') {
        return path;
    }
    return path + index + 1;
}

void set_process_working_directory(struct Process *process, char *path) {
    int length = string_length(path);
    int index = 0;
    char *copy = (char *)kmalloc(length + 1);

    while (index <= length) {
        copy[index] = path[index];
        index = index + 1;
    }
    if (process->working_directory != NULL) {
        kfree(process->working_directory);
    }
    process->working_directory = copy;
}

int initialize_working_directory(struct Process *process) {
    char path[512];

    uart_send_host_request("pwd", "");
    if (uart_receive_string(path, PATH_MAX) < 0) {
        return -1;
    }
    set_process_working_directory(process, path);
    return 0;
}

int copy_working_directory(
    char *working_directory,
    struct GetCwdRequest *request
) {
    int length;
    int index = 0;

    if (working_directory == NULL || request->size <= 0) {
        return -1;
    }
    length = string_length(working_directory);
    if (length >= request->size) {
        return -1;
    }
    while (index <= length) {
        request->buffer[index] = working_directory[index];
        index = index + 1;
    }
    return 0;
}

int get_working_directory(struct GetCwdRequest *request) {
    return copy_working_directory(
        current_process()->working_directory,
        request
    );
}

int get_system_working_directory(struct GetCwdRequest *request) {
    return copy_working_directory(system_working_directory(), request);
}

int change_working_directory(char *path) {
    char absolute_path[512];

    if (!build_process_path(path, absolute_path, PATH_MAX)) {
        return -1;
    }
    uart_send_host_request("is-directory ", absolute_path);
    if (receive_word() < 0) {
        return -1;
    }
    set_process_working_directory(current_process(), absolute_path);
    return 0;
}

int make_host_directory(char *path) {
    char absolute_path[512];

    if (!build_process_path(path, absolute_path, PATH_MAX)) {
        return -1;
    }
    uart_send_host_request("mkdir ", absolute_path);
    return receive_word();
}

int read_host_directory(struct ReadDirectoryRequest *request) {
    char absolute_path[512];

    if (request->capacity <= 0 ||
        !build_process_path(request->path, absolute_path, PATH_MAX)) {
        return -1;
    }
    uart_send_host_request("ls ", absolute_path);
    return uart_receive_string(request->buffer, request->capacity);
}

int request_host_path_operation(char *command, char *path) {
    char absolute_path[512];

    if (!build_process_path(path, absolute_path, PATH_MAX)) {
        return -1;
    }
    uart_send_host_request(command, absolute_path);
    return receive_word();
}

int unlink_host_file(char *path) {
    return request_host_path_operation("unlink ", path);
}

int remove_host_directory(char *path) {
    return request_host_path_operation("rmdir ", path);
}

int move_host_path(struct MoveRequest *request) {
    char old_path[512];
    char new_path[512];

    if (!build_process_path(request->old_path, old_path, PATH_MAX) ||
        !build_process_path(request->new_path, new_path, PATH_MAX)) {
        return -1;
    }
    uart_print_character(27);
    uart_print_string("move ");
    uart_print_string(old_path);
    uart_print_character('\n');
    uart_print_string(new_path);
    uart_print_character(27);
    uart_print_character('/');
    return receive_word();
}

int touch_host_file(char *path) {
    return request_host_path_operation("touch ", path);
}
