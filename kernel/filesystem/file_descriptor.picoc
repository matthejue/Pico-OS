#include "file_descriptor.header"
#include "../kmalloc.header"
#include "../process.header"

char *copy_file_path(char *path) {
    int length = 0;
    int index = 0;
    char *copy;

    while (path[length] != 0) {
        length = length + 1;
    }

    copy = (char *)kmalloc(length + 1);
    if (copy == NULL) {
        return NULL;
    }

    while (index < length) {
        copy[index] = path[index];
        index = index + 1;
    }
    copy[index] = 0;
    return copy;
}

void initialize_file_descriptor(
    struct FileDescriptor *descriptor,
    int kind,
    int flags
) {
    descriptor->kind = kind;
    descriptor->flags = flags;
    descriptor->offset = 0;
    descriptor->path = NULL;
}

struct FileDescriptorTable *create_file_descriptor_table(void) {
    struct FileDescriptorTable *table;
    int index;

    table = (struct FileDescriptorTable *)kmalloc(
        sizeof(struct FileDescriptorTable)
    );
    if (table == NULL) {
        return NULL;
    }

    table->entries = (struct FileDescriptor *)kmalloc(
        sizeof(struct FileDescriptor) * FILE_DESCRIPTOR_COUNT
    );
    table->stdin_buffer = (char *)kmalloc(STDIN_BUFFER_CAPACITY);
    if (table->entries == NULL || table->stdin_buffer == NULL) {
        kfree(table->entries);
        kfree(table->stdin_buffer);
        kfree(table);
        return NULL;
    }

    index = 0;
    while (index < FILE_DESCRIPTOR_COUNT) {
        initialize_file_descriptor(
            table->entries + index,
            FILE_DESCRIPTOR_FREE,
            0
        );
        index = index + 1;
    }
    initialize_file_descriptor(
        table->entries + STDIN_FILENO,
        FILE_DESCRIPTOR_STDIN,
        O_RDONLY
    );
    initialize_file_descriptor(
        table->entries + STDOUT_FILENO,
        FILE_DESCRIPTOR_STDOUT,
        O_WRONLY
    );
    initialize_file_descriptor(
        table->entries + STDERR_FILENO,
        FILE_DESCRIPTOR_STDERR,
        O_WRONLY
    );

    table->stdin_head = 0;
    table->stdin_tail = 0;
    table->stdin_count = 0;
    table->stdin_waiters.head = NULL;
    table->stdin_waiters.tail = NULL;
    table->pending_read_buffer = NULL;
    table->pending_read_count = 0;
    table->pending_character_read = false;
    return table;
}

struct FileDescriptorTable *inherit_standard_file_descriptors(
    struct FileDescriptorTable *source
) {
    struct FileDescriptorTable *copy = create_file_descriptor_table();
    int index = 0;

    if (copy == NULL || source == NULL) {
        return copy;
    }

    // Only standard descriptors pass to a newly started process
    while (index <= STDERR_FILENO) {
        copy->entries[index].kind = source->entries[index].kind;
        copy->entries[index].flags = source->entries[index].flags;
        copy->entries[index].offset = source->entries[index].offset;
        if (source->entries[index].path != NULL) {
            copy->entries[index].path = copy_file_path(
                source->entries[index].path
            );
            if (copy->entries[index].path == NULL) {
                destroy_file_descriptor_table(copy);
                return NULL;
            }
        }
        index = index + 1;
    }
    return copy;
}

void destroy_file_descriptor_table(struct FileDescriptorTable *table) {
    int index = 0;

    if (table == NULL) {
        return;
    }

    while (index < FILE_DESCRIPTOR_COUNT) {
        kfree(table->entries[index].path);
        index = index + 1;
    }
    kfree(table->entries);
    kfree(table->stdin_buffer);
    kfree(table);
}

bool file_descriptor_is_valid(int file_descriptor) {
    return file_descriptor >= 0 &&
           file_descriptor < FILE_DESCRIPTOR_COUNT;
}

bool file_descriptor_can_read(struct FileDescriptor *descriptor) {
    int access_mode = descriptor->flags & O_ACCMODE;

    return access_mode == O_RDONLY || access_mode == O_RDWR;
}

bool file_descriptor_can_write(struct FileDescriptor *descriptor) {
    int access_mode = descriptor->flags & O_ACCMODE;

    return access_mode == O_WRONLY || access_mode == O_RDWR;
}

int close_file_descriptor(int file_descriptor) {
    struct FileDescriptorTable *table = current_process()->file_descriptors;
    struct FileDescriptor *descriptor;

    if (file_descriptor < 3 ||
        !file_descriptor_is_valid(file_descriptor)) {
        return -1;
    }

    descriptor = table->entries + file_descriptor;
    if (descriptor->kind == FILE_DESCRIPTOR_FREE) {
        return -1;
    }
    kfree(descriptor->path);
    initialize_file_descriptor(descriptor, FILE_DESCRIPTOR_FREE, 0);
    return 0;
}

int duplicate_file_descriptor(struct Dup2Request *request) {
    struct FileDescriptorTable *table = current_process()->file_descriptors;
    struct FileDescriptor *source;
    struct FileDescriptor *target;
    char *path = NULL;

    if (request == NULL ||
        !file_descriptor_is_valid(request->old_file_descriptor) ||
        !file_descriptor_is_valid(request->new_file_descriptor)) {
        return -1;
    }

    source = table->entries + request->old_file_descriptor;
    if (source->kind == FILE_DESCRIPTOR_FREE) {
        return -1;
    }
    if (request->old_file_descriptor == request->new_file_descriptor) {
        return request->new_file_descriptor;
    }

    if (source->path != NULL) {
        path = copy_file_path(source->path);
        if (path == NULL) {
            return -1;
        }
    }

    target = table->entries + request->new_file_descriptor;
    kfree(target->path);
    target->kind = source->kind;
    target->flags = source->flags;
    target->offset = source->offset;
    target->path = path;
    return request->new_file_descriptor;
}
