#include "syscall.header"
#include "kernel.header"
#include "process.header"
#include "process_arguments.header"
#include "process_loader.header"

int handle_syscall(int syscall_number, int argument) {
    if (syscall_number == SYSCALL_SHUTDOWN) {
        shutdown();
        return 1;
    } else if (syscall_number == SYSCALL_LOAD_PROCESS) {
        return load_process((char *)argument);
    } else if (syscall_number == SYSCALL_RUN_PROCESS) {
        return mark_process_ready_by_pid(argument);
    } else if (syscall_number == SYSCALL_RUN_PROCESS_WITH_ARGUMENTS) {
        return mark_process_ready_with_arguments((struct RunProcessRequest *)argument);
    } else if (syscall_number == SYSCALL_LIST_PROCESSES) {
        list_processes();
        return 1;
    } else if (syscall_number == SYSCALL_UNLOAD_PROCESS) {
        return unload_process_by_pid(argument);
    } else if (syscall_number == SYSCALL_PROCESS_HEAP_START) {
        return process_heap_start();
    } else if (syscall_number == SYSCALL_PROCESS_HEAP_SIZE) {
        return process_heap_size();
    } else if (syscall_number == SYSCALL_EXIT) {
        exit_process(argument);
        return 1;
    } else if (syscall_number == SYSCALL_WAIT_PROCESS) {
        struct WaitProcessRequest *request = (struct WaitProcessRequest *)argument;

        if (request == NULL) {
            return 0;
        }
        return wait_for_process_by_pid(request->pid, request->status);
    }

    return 0;
}
