#include "syscall.header"
#include "dispatcher.header"
#include "exception.header"
#include "filesystem/file_descriptor.header"
#include "filesystem/filesystem.header"
#include "filesystem/host_filesystem.header"
#include "kernel.header"
#include "process.header"
#include "process_arguments.header"
#include "process_loader.header"
#include "shared_memory.header"
#include "signal.header"

void send_byte_over_uart(int value);

int handle_syscall(int syscall_number, int argument, int *caller_context) {
    if (syscall_number == SYSCALL_SEND_BYTE_OVER_UART) {
        send_byte_over_uart(argument);
        return 1;
    } else if (syscall_number == SYSCALL_SHUTDOWN) {
        shutdown();
        return 1;
    } else if (syscall_number == SYSCALL_LOAD_PROCESS) {
        return load_process(
            ((struct LoadProcessRequest *)argument)->path,
            ((struct LoadProcessRequest *)argument)->show_loading_bar
        );
    } else if (syscall_number == SYSCALL_RUN_PROCESS_WITH_ARGUMENTS) {
        return mark_process_ready_with_arguments((struct RunProcessRequest *)argument);
    } else if (syscall_number == SYSCALL_LIST_PROCESSES) {
        list_processes();
        return 1;
    } else if (syscall_number == SYSCALL_UNLOAD_PROCESS) {
        return unload_process_by_pid(argument);
    } else if (syscall_number == SYSCALL_PROCESS_HEAP_START) {
        return process_heap_start();
    } else if (syscall_number == SYSCALL_PROCESS_HEAP_SIZE) {
        return process_heap_size();
    } else if (syscall_number == SYSCALL_EXIT) {
        exit_process(argument);
        return 1;
    } else if (syscall_number == SYSCALL_WAITPID) {
        return wait_for_process_by_pid(
            (struct WaitPidRequest *)argument,
            caller_context
        );
    } else if (syscall_number == SYSCALL_SLEEP) {
        sleep_on_wait_queue((struct wait_queue *)argument, caller_context);
        return 1;
    } else if (syscall_number == SYSCALL_WAKEUP) {
        return wakeup_wait_queue((struct wait_queue *)argument);
    } else if (syscall_number == SYSCALL_YIELD) {
        dispatcher_switch_from_context(caller_context);
        return 1;
    } else if (syscall_number == SYSCALL_GETPID) {
        return current_process()->pid;
    } else if (syscall_number == SYSCALL_OPEN) {
        return open_file_descriptor((struct OpenRequest *)argument);
    } else if (syscall_number == SYSCALL_READ) {
        return read_file_descriptor(
            (struct IoRequest *)argument,
            caller_context
        );
    } else if (syscall_number == SYSCALL_WRITE) {
        return write_file_descriptor((struct IoRequest *)argument);
    } else if (syscall_number == SYSCALL_CLOSE) {
        return close_file_descriptor(argument);
    } else if (syscall_number == SYSCALL_LSEEK) {
        return seek_file_descriptor((struct SeekRequest *)argument);
    } else if (syscall_number == SYSCALL_FILE_DESCRIPTORS_AVAILABLE) {
        return 1;
    } else if (syscall_number == SYSCALL_SHM_OPEN) {
        return open_shared_memory((struct ShmOpenRequest *)argument);
    } else if (syscall_number == SYSCALL_MMAP) {
        return (int)map_shared_memory(argument);
    } else if (syscall_number == SYSCALL_SHM_UNLINK) {
        return unlink_shared_memory((char *)argument);
    } else if (syscall_number == SYSCALL_DUP2) {
        return duplicate_file_descriptor((struct Dup2Request *)argument);
    } else if (syscall_number == SYSCALL_RESET_PROCESSES) {
        remove_test_processes();
        return 1;
    } else if (syscall_number == SYSCALL_KILL) {
        return send_signal_by_pid((struct KillRequest *)argument);
    } else if (syscall_number == SYSCALL_PRCTL) {
        return set_parent_death_signal(
            (struct PrctlRequest *)argument
        );
    } else if (syscall_number == SYSCALL_SET_FOREGROUND_PROCESS) {
        return set_foreground_process(argument);
    } else if (syscall_number == SYSCALL_CHDIR) {
        return change_working_directory((char *)argument);
    } else if (syscall_number == SYSCALL_GETCWD) {
        return get_working_directory((struct GetCwdRequest *)argument);
    } else if (syscall_number == SYSCALL_MKDIR) {
        return make_host_directory((char *)argument);
    } else if (syscall_number == SYSCALL_READ_DIRECTORY) {
        return read_host_directory(
            (struct ReadDirectoryRequest *)argument
        );
    } else if (syscall_number == SYSCALL_UNLINK) {
        return unlink_host_file((char *)argument);
    } else if (syscall_number == SYSCALL_RMDIR) {
        return remove_host_directory((char *)argument);
    } else if (syscall_number == SYSCALL_MOVE) {
        return move_host_path((struct MoveRequest *)argument);
    } else if (syscall_number == SYSCALL_TOUCH) {
        return touch_host_file((char *)argument);
    } else if (syscall_number == SYSCALL_PROCESS_HEAP_FULL) {
        handle_process_heap_full_exception();
        return 1;
    }

    return 0;
}
