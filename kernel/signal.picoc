#include "signal.header"
#include "process/process.header"
#include "filesystem/terminal.header"
#include "../common/prctl.header"
#include "../common/signal.header"

#define TERMINAL_INTERRUPT_CHARACTER 3
#define TERMINAL_STOP_CHARACTER 26

int foreground_process_id = 0;
int terminal_input_process_id = 0;

bool signal_number_is_valid(int signal_number) {
    return signal_number == SIGINT ||
           signal_number == SIGKILL ||
           signal_number == SIGCONT ||
           signal_number == SIGSTOP ||
           signal_number == SIGTSTP ||
           signal_number == SIGTTIN;
}

void notify_process_stopped(struct Process *process) {
    struct Process *waiting_process;

    while (process->waiters.head != NULL) {
        waiting_process = process->waiters.head;
        if (waiting_process->waiting_status_ptr != NULL) {
            *(waiting_process->waiting_status_ptr) =
                128 + process->stop_signal;
        }
        waiting_process->waiting_status_ptr = NULL;
        wakeup_wait_queue(&(process->waiters));
    }
}

void stop_process(struct Process *process, int signal_number) {
    if (process->state == PROCESS_STATE_STOPPED ||
        process->state == PROCESS_STATE_ZOMBIE) {
        return;
    }

    process->stop_signal = signal_number;
    process->stopped_from_state = process->state;
    suspend_pending_terminal_read(process);
    process->state = PROCESS_STATE_STOPPED;
    notify_process_stopped(process);
}

void continue_process(struct Process *process) {
    if (process->state != PROCESS_STATE_STOPPED) {
        return;
    }

    if (process->pending_terminal_read_buffer != NULL) {
        if (!process_has_terminal_input(process)) {
            process->stop_signal = SIGTTIN;
            return;
        }
        resume_pending_terminal_read(process);
    }

    if (process->stopped_from_state == PROCESS_STATE_BLOCKED &&
        process->waiting_queue_ptr != NULL) {
        process->state = PROCESS_STATE_BLOCKED;
    } else {
        process->state = PROCESS_STATE_READY;
    }
}

void kill_process(struct Process *process, int signal_number) {
    terminate_process(process, 128 + signal_number);
}

void send_signal_to_process(
    struct Process *process,
    int signal_number
) {
    if (process == NULL ||
        process->state == PROCESS_STATE_ZOMBIE ||
        !signal_number_is_valid(signal_number)) {
        return;
    }

    if (signal_number == SIGCONT) {
        continue_process(process);
        return;
    }
    if (signal_number == SIGSTOP ||
        signal_number == SIGTSTP ||
        signal_number == SIGTTIN) {
        stop_process(process, signal_number);
        return;
    }

    // A running process is still on the interrupt return path, so its
    // termination is deferred until the next dispatch
    if (process == current_process() &&
        process->state == PROCESS_STATE_RUNNING) {
        process->pending_termination_signal = signal_number;
        return;
    }

    kill_process(process, signal_number);
}

int send_signal_by_pid(struct KillRequest *request) {
    struct Process *process;

    if (request->signal_number != 0 &&
        !signal_number_is_valid(request->signal_number)) {
        return -1;
    }

    process = find_process_by_pid(request->pid);
    if (process == NULL || process->state == PROCESS_STATE_ZOMBIE) {
        return -1;
    }
    if (request->signal_number != 0) {
        send_signal_to_process(process, request->signal_number);
    }
    return 0;
}

bool prepare_process_termination(struct Process *process) {
    int signal_number = process->pending_termination_signal;

    if (signal_number == 0) {
        return true;
    }
    process->pending_termination_signal = 0;
    kill_process(process, signal_number);
    return false;
}

int set_parent_death_signal(struct PrctlRequest *request) {
    if (request->option != PR_SET_PDEATHSIG ||
        (request->argument != 0 &&
         !signal_number_is_valid(request->argument))) {
        return -1;
    }

    current_process()->parent_death_signal = request->argument;
    return 0;
}

int set_foreground_process(int pid) {
    struct Process *process;

    if (pid == 0) {
        foreground_process_id = 0;
        terminal_input_process_id = current_process()->pid;
        return 0;
    }

    process = find_process_by_pid(pid);
    if (process == NULL ||
        process->parent_pid != current_process()->pid) {
        return -1;
    }

    foreground_process_id = pid;
    terminal_input_process_id = pid;
    return 0;
}

bool process_has_terminal_input(struct Process *process) {
    return process != NULL && process->pid == terminal_input_process_id;
}

struct Process *terminal_input_process(void) {
    struct Process *process;

    if (terminal_input_process_id != 0) {
        process = find_process_by_pid(terminal_input_process_id);
        if (process != NULL &&
            process->state != PROCESS_STATE_ZOMBIE) {
            return process;
        }
    }
    return current_process();
}

bool handle_terminal_signal_character(int value) {
    struct Process *foreground_process;
    int signal_number;

    if (value == TERMINAL_INTERRUPT_CHARACTER) {
        signal_number = SIGINT;
    } else if (value == TERMINAL_STOP_CHARACTER) {
        signal_number = SIGTSTP;
    } else {
        return false;
    }

    foreground_process = find_process_by_pid(
        foreground_process_id
    );
    if (foreground_process != NULL) {
        send_signal_to_process(
            foreground_process,
            signal_number
        );
    }
    return true;
}
