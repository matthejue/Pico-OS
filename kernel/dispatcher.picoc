#include "dispatcher.header"
#include "process.header"
#include "scheduler.header"

void dispatcher_save_current(
    int saved_sp,
    int saved_ds,
    int saved_cs,
    int saved_baf,
    int saved_in2,
    int saved_in1,
    int saved_acc
) {
    if (current_process() == NULL) {
        return;
    }

    current_process()->activation.sp = saved_sp;
    current_process()->activation.ds = saved_ds;
    current_process()->activation.cs = saved_cs;
    current_process()->activation.baf = saved_baf;
    current_process()->activation.in2 = saved_in2;
    current_process()->activation.in1 = saved_in1;
    current_process()->activation.acc = saved_acc;

    if (current_process()->state == PROCESS_STATE_RUNNING) {
        current_process()->state = PROCESS_STATE_READY;
    }
}

struct Process *dispatcher_tick(
    int saved_sp,
    int saved_ds,
    int saved_cs,
    int saved_baf,
    int saved_in2,
    int saved_in1,
    int saved_acc
) {
    struct Process *next_process;

    dispatcher_save_current(
        saved_sp,
        saved_ds,
        saved_cs,
        saved_baf,
        saved_in2,
        saved_in1,
        saved_acc
    );

    next_process = scheduler_next_process();
    if (next_process == NULL) {
        return current_process();
    }

    set_current_process(next_process);
    current_process()->state = PROCESS_STATE_RUNNING;
    return current_process();
}

__attribute__((naked))
void dispatcher_jump_to_process(struct Process *process) {
    asm("LOADIN SP BAF 2");
    asm("LOADIN BAF SP 14");
    asm("LOADIN BAF CS 16");
    asm("LOADIN BAF DS 17");
    asm("LOADIN BAF IN1 11");
    asm("LOADIN BAF IN2 12");
    asm("LOADIN BAF ACC 13");
    asm("LOADIN BAF BAF 15");
    asm("RTI");
}

void dispatcher_switch_to_process(struct Process *process) {
    if (current_process() != NULL && current_process()->state == PROCESS_STATE_RUNNING) {
        current_process()->state = PROCESS_STATE_READY;
    }

    set_current_process(process);
    current_process()->state = PROCESS_STATE_RUNNING;

    dispatcher_jump_to_process(current_process());
}

void dispatcher_start_next_process(void) {
    struct Process *next_process = scheduler_next_process();

    if (next_process == NULL) {
        return;
    }

    dispatcher_switch_to_process(next_process);
}
