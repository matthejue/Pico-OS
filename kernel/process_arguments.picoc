#include "process_arguments.header"
#include "../common/stddef.header"

int process_argument_is_space(int value) {
    return value == ' ' || value == '\t';
}

// Counts the space- or tab-separated argument tokens in the input string
int process_argument_token_count(char *arguments) {
    // Current position in the input argument string
    int index = 0;
    // Number of whitespace-separated arguments found so far
    int token_count = 0;

    while (arguments[index] != 0) {
        // Ignore separators before the next argument
        while (process_argument_is_space(arguments[index])) {
            index = index + 1;
        }

        if (arguments[index] != 0) {
            token_count = token_count + 1;
        }

        while (arguments[index] != 0 &&
               !process_argument_is_space(arguments[index])) {
            // Move past the current argument before looking for the next one
            index = index + 1;
        }
    }

    return token_count;
}

// Counts cells needed to copy all argument tokens as null-terminated strings
int process_argument_string_cell_count(char *arguments) {
    // Current position in the input argument string
    int index = 0;
    // Number of cells needed for the separated argument strings
    int string_cells = 0;

    while (arguments[index] != 0) {
        // Ignore separators before the next argument
        while (process_argument_is_space(arguments[index])) {
            index = index + 1;
        }

        if (arguments[index] != 0) {
            // Count the characters that will be copied into this argument
            while (arguments[index] != 0 &&
                   !process_argument_is_space(arguments[index])) {
                string_cells = string_cells + 1;
                index = index + 1;
            }
            // Each copied argument needs a trailing '\0' character
            string_cells = string_cells + 1;
        }
    }

    return string_cells;
}

void store_process_arguments(struct Process *process, char *arguments) {
    // Number of arguments, including the binary path in argv[0]
    int argc;
    // Cells for the entry PC, argc, argv, entries, and strings
    int required_cells;
    // Process-relative offset where the argument data will begin
    int argument_base_offset;
    // Pointers into the process's initial stack layout
    int *entry_pc_cell;
    int *argc_cell;
    char **argv;
    // Next character where a copied argument will be stored
    char *string_target;
    // Index of the next argv entry to point at a copied argument string
    int argument_index = 1;
    int path_index = 0;
    // Current position in the original argument string
    int source_index = 0;

    // Counts the arguments, calculates the memory cells needed for the initial
    // process argument layout, and determines its starting offset
    // Adds one for argv[0], which stores the path used to load the process
    argc = process_argument_token_count(arguments) + 1;
    // The argv table has one extra entry for the required NULL sentinel
    required_cells = 1 + 2 + argc + 1 +
                     process_argument_string_cell_count(arguments);
    // Counts the cells needed to store the binary path in argv[0]
    while (process->binary_path[path_index] != 0) {
        required_cells = required_cells + 1;
        path_index = path_index + 1;
    }
    // Includes the trailing '\0' for argv[0]
    required_cells = required_cells + 1;
    argument_base_offset = process->size - required_cells;

    // Calculates the addresses of the process entry data, argv table, and
    // string storage within the reserved memory area
    // [entry PC][argc][argv][entries ...][NULL][strings ...]
    entry_pc_cell = (int *)(process->base_address + argument_base_offset);
    argc_cell = entry_pc_cell + 1;
    argv = (char **)(argc_cell + 2);
    string_target = (char *)(argv + argc + 1);

    // Initializes the entry PC, argc, and argv pointer
    *entry_pc_cell = process->activation.cs - 1;
    *argc_cell = argc;
    *(argc_cell + 1) = (int)argv;
    argv[argc] = NULL;

    // Stores argv[0] and copies the process binary path into the string area
    // argv[0] always contains the path used to load the process
    argv[0] = string_target;
    path_index = 0;
    while (process->binary_path[path_index] != 0) {
        *string_target = process->binary_path[path_index];
        string_target = string_target + 1;
        path_index = path_index + 1;
    }

    // Terminates the copied path as a C string and advances to the next string
    *string_target = 0;
    string_target = string_target + 1;

    // Parses each whitespace-separated argument and copies it into process
    // memory while adding a pointer to it in the argv table.
    while (arguments[source_index] != 0) {
        // Skips separators before the next argument
        while (process_argument_is_space(arguments[source_index])) {
            source_index = source_index + 1;
        }

        // Ignores trailing whitespace: 0 marks the end of the input C string
        if (arguments[source_index] != 0) {
            // Stores a pointer to the separately stored copy of this argument
            argv[argument_index] = string_target;
            argument_index = argument_index + 1;

            // Copies one whitespace-separated argument into process memory
            while (arguments[source_index] != 0 &&
                   !process_argument_is_space(arguments[source_index])) {
                *string_target = arguments[source_index];
                string_target = string_target + 1;
                source_index = source_index + 1;
            }

            // Terminates the copied argument as a C string
            *string_target = 0;
            string_target = string_target + 1;
        }
    }

    // Saves the initial base address and stack pointer used by the dispatcher
    // to enter the process with its arguments
    // Naked _start uses BAF + 3 and BAF + 4 for argc and argv
    process->activation.baf = (int)entry_pc_cell - 2;
    process->activation.sp = (int)entry_pc_cell - 1;
}

int mark_process_ready_with_arguments(struct RunProcessRequest *request) {
    struct Process *process;

    // Only a newly created process can be started
    process = find_process_by_pid(request->pid);
    if (process == NULL ||
        process->state != PROCESS_STATE_NEW) {
        return 0;
    }

    // Arguments must be placed on the process stack before its first start
    store_process_arguments(process, request->arguments);

    // This makes the process eligible for scheduling
    process->state = PROCESS_STATE_READY;
    return 1;
}
