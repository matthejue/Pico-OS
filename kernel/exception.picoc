#include "exception.header"
#include "filesystem/filesystem.header"
#include "kernel.header"
#include "kmalloc.header"
#include "memory_constants.header"
#include "periphery.header"
#include "process.header"
#include "../common/file.header"
#include "../common/uart_protocol.header"

void activate_kernel_stack_boundary(void) {
    periphery_write_register(
        STACK_HEAP_BOUNDARY_REGISTER,
        KERNEL_HEAP_START + KERNEL_HEAP_SIZE - 1
    );
}

int process_stack_boundary(struct Process *process) {
    return process->base_address + process->heap_start + process->heap_size - 1;
}

void activate_current_process_stack_boundary(void) {
    periphery_write_register(
        STACK_HEAP_BOUNDARY_REGISTER,
        process_stack_boundary(current_process())
    );
}

void write_process_exception_message(char *message) {
    struct IoRequest request;
    int length = 0;

    while (message[length] != 0) {
        length = length + 1;
    }
    request.file_descriptor = STDOUT_FILENO;
    request.buffer = message;
    request.count = length;
    request.show_loading_bar = false;
    write_file_descriptor(&request);
}

void print_cpu_exception_message(int cause, bool kernel_exception) {
    if (kernel_exception) {
        if (cause == CPU_EXCEPTION_DIVIDE_BY_ZERO) {
            uart_print_string("Kernel panic: division by zero\n");
        } else if (cause == CPU_EXCEPTION_STACK_OVERFLOW) {
            uart_print_string("Kernel panic: kernel stack overflow\n");
        } else {
            uart_print_string("Kernel panic: illegal instruction\n");
        }
    } else {
        if (cause == CPU_EXCEPTION_DIVIDE_BY_ZERO) {
            write_process_exception_message(
                "Process terminated: division by zero\n"
            );
        } else if (cause == CPU_EXCEPTION_STACK_OVERFLOW) {
            write_process_exception_message(
                "Process terminated: stack overflow\n"
            );
        } else {
            write_process_exception_message(
                "Process terminated: illegal instruction\n"
            );
        }
    }
}

void handle_cpu_exception(int interrupted_kernel_cs_difference) {
    int cause = periphery_read_register(CPU_EXCEPTION_CAUSE_REGISTER);
    bool kernel_exception = interrupted_kernel_cs_difference == 0;

    print_cpu_exception_message(cause, kernel_exception);
    if (kernel_exception) {
        shutdown();
    }

    exit_process(PROCESS_EXIT_STATUS_EXCEPTION);
}

void handle_process_heap_full_exception(void) {
    write_process_exception_message(
        "Process terminated: heap full\n"
    );
    exit_process(PROCESS_EXIT_STATUS_EXCEPTION);
}

void panic_kernel_heap_full(void) {
    uart_print_string("Kernel panic: kernel heap full\n");
    shutdown();
}
