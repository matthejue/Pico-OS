#include "kernel.header"
#include "dispatcher.header"
#include "interrupt_controller.header"
#include "process.header"
#include "process_loader.header"
#include "kmalloc.header"
#include "pmalloc.header"

#define INIT_BINARY_PATH "system/init.bin"

void shutdown(void) {
    asm("JUMP 0");
}

int main(void) {
    int init_pid;

    debug;
    init_kernel_heap();
    initialize_process_table();
    init_process_memory_heap();
    interrupt_controller_initialize();
    init_pid = load_process(INIT_BINARY_PATH);
    if (mark_process_ready_by_pid(init_pid)) {
        interrupt_controller_activate_timer();
        dispatcher_start_next_process();
    }
    return 0;
}
