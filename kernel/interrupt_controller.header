#pragma once

#include "periphery.header"

#define INTERRUPT_DEVICE_COUNT 3
#define INTERRUPT_DEVICE_INTTIMER 0
#define INTERRUPT_DEVICE_DMA 1
#define INTERRUPT_DEVICE_UART 2

#define INTERRUPT_CONTROLLER_DISABLED 255
#define INTERRUPT_CONTROLLER_TIMER_DEVICE_TO_ISR_REGISTER 3
#define INTERRUPT_CONTROLLER_DMA_DEVICE_TO_ISR_REGISTER 4
#define INTERRUPT_CONTROLLER_UART_DEVICE_TO_ISR_REGISTER 5
#define INTERRUPT_CONTROLLER_TIMER_DEVICE_PRIORITY_REGISTER 6
#define INTERRUPT_CONTROLLER_DMA_DEVICE_PRIORITY_REGISTER 7
#define INTERRUPT_CONTROLLER_UART_DEVICE_PRIORITY_REGISTER 8
#define INTERRUPT_CONTROLLER_TIMER_INTERVAL_REGISTER 9
#define INTERRUPT_CONTROLLER_TIMER_INTERVAL 1000

void interrupt_controller_disable_device(int device);
void interrupt_controller_assign_device(int device, int interrupt_index, int priority);
void interrupt_controller_activate_timer(void);
void interrupt_controller_initialize(void);
