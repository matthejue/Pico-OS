#pragma once

#include "../common/stddef.header"
#include "../common/syscall.header"
#include "../common/signal.header"
#include "../common/wait_queue.header"

struct FileDescriptorTable;
struct SharedMemoryAttachment;

#define PROCESS_STATE_NEW 0
#define PROCESS_STATE_READY 1
#define PROCESS_STATE_RUNNING 2
#define PROCESS_STATE_BLOCKED 3
#define PROCESS_STATE_STOPPED 4
#define PROCESS_STATE_ZOMBIE 5
#define PROCESS_EXIT_STATUS_SUCCESS 0
#define PROCESS_EXIT_STATUS_EXCEPTION 1

struct ActivationRecord {
    int in1;
    int in2;
    int acc;
    int sp;
    int baf;
    int cs;
    int ds;
};

struct Process {
    int pid;
    int state;
    int base_address;
    int size;
    int heap_start;
    int heap_size;
    int word_count;
    char *binary_path;
    char *working_directory;
    struct ActivationRecord activation;
    // Kept after activation because the dispatcher loads that record by fixed offsets
    struct FileDescriptorTable *file_descriptors;
    // Pointer to the exit-status storage supplied by this process's waitpid() call
    int *waiting_status_ptr;
    // Queue of processes waiting for this process to exit and receive its status
    struct wait_queue waiters;
    // Pointer to the wait queue containing this process while it is blocked
    struct wait_queue *waiting_queue_ptr;
    // A process can be blocked on only one wait queue at a time, so this
    // intrusive link is sufficient to connect it to its queue successor
    struct Process *wait_next;
    // Link to this process's successor in the global process list
    struct Process *next;
    // Shared-memory mappings released when this process is removed
    struct SharedMemoryAttachment *shared_memory_attachments;
    // PID of the process that loaded this process
    int parent_pid;
    // Signal inherited by children and received when their parent terminates
    int parent_death_signal;
    int exit_status;
    int stopped_from_state;
    bool pending_termination;
};

void initialize_process_table(void);
struct Process *create_process(
    int base_address,
    int size,
    int code_start,
    int data_start,
    int heap_start,
    int heap_size,
    int word_count,
    char *binary_path
);
bool unload_process_by_pid(int pid);
void remove_test_processes(void);
bool wait_for_process_by_pid(struct WaitPidRequest *request, int *caller_context);
void sleep_on_wait_queue(struct wait_queue *queue, int *caller_context);
void enqueue_current_process_on_wait_queue(struct wait_queue *queue);
bool wakeup_wait_queue(struct wait_queue *queue);
void remove_from_wait_queue(struct Process *process);
int process_heap_start(void);
int process_heap_size(void);
void exit_process(int status);
void terminate_process(struct Process *process, int status);
void list_processes(void);
struct Process *first_process(void);
struct Process *current_process(void);
struct Process *find_process_by_pid(int pid);
void set_current_process(struct Process *process);
