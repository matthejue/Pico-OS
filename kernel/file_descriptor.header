#pragma once

#include "../common/file.header"
#include "../common/stddef.header"
#include "../common/wait_queue.header"

#define FILE_DESCRIPTOR_COUNT 8
#define STDIN_BUFFER_CAPACITY 128

#define FILE_DESCRIPTOR_FREE 0
#define FILE_DESCRIPTOR_STDIN 1
#define FILE_DESCRIPTOR_STDOUT 2
#define FILE_DESCRIPTOR_STDERR 3
#define FILE_DESCRIPTOR_FILE 4

struct FileDescriptor {
    int kind;
    int flags;
    int offset;
    char *path;
};

struct FileDescriptorTable {
    struct FileDescriptor *entries;
    char *stdin_buffer;
    int stdin_head;
    int stdin_tail;
    int stdin_count;
    struct wait_queue stdin_waiters;
    char *pending_read_buffer;
    int pending_read_count;
    bool pending_character_read;
};

struct FileDescriptorTable *create_file_descriptor_table(void);
struct FileDescriptorTable *inherit_standard_file_descriptors(
    struct FileDescriptorTable *source
);
void destroy_file_descriptor_table(struct FileDescriptorTable *table);
int close_file_descriptor(int file_descriptor);
int duplicate_file_descriptor(struct Dup2Request *request);
char *copy_file_path(char *path);
bool file_descriptor_is_valid(int file_descriptor);
bool file_descriptor_can_read(struct FileDescriptor *descriptor);
bool file_descriptor_can_write(struct FileDescriptor *descriptor);
