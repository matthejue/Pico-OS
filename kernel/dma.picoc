#include "dma.header"
#include "dispatcher.header"
#include "process/process.header"
#include "../common/syscall.header"

struct wait_queue dma_waiters;
bool dma_initialized = false;

void initialize_dma(void) {
    if (dma_initialized || !dma_is_active()) {
        return;
    }
    dma_waiters.head = NULL;
    dma_waiters.tail = NULL;
    dma_initialized = true;
}

bool start_dma_uart_receive(
    int destination,
    int word_count,
    int *caller_context
) {
    if (!dma_is_active()) {
        return false;
    }

    initialize_dma();
    if (dma_transfer_status() == DMA_STATUS_BUSY ||
        dma_waiters.head != NULL) {
        return false;
    }

    caller_context[4] = SYSCALL_LOAD_PROCESS_CONTINUE;
    enqueue_current_process_on_wait_queue(&dma_waiters);
    start_dma_uart_transfer(destination, word_count);
    dispatcher_switch_from_context(caller_context);
    return true;
}

void handle_dma_interrupt(void) {
    wakeup_wait_queue(&dma_waiters);
}
