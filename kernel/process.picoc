#include "process.header"
#include "kernel.header"
#include "kmalloc.header"
#include "memory_constants.header"
#include "pmalloc.header"
#include "dispatcher.header"
#include "../common/uart_protocol.header"

struct Process *process_list_head = NULL;
struct Process *process_list_tail = NULL;
struct Process *active_process = NULL;
int next_process_id = 1;

void initialize_process_table(void) {
    process_list_head = NULL;
    process_list_tail = NULL;
    active_process = NULL;
    next_process_id = 1;
}

struct Process *first_process(void) {
    return process_list_head;
}

void list_processes(void) {
    struct Process *process = first_process();

    while (process != NULL) {
        uart_print_integer(process->pid);
        uart_print_character(' ');
        uart_print_string(process->binary_path);
        uart_print_character('\n');
        process = process->next;
    }
}

struct Process *current_process(void) {
    return active_process;
}

void set_current_process(struct Process *process) {
    active_process = process;
}

char *copy_process_path(char *path) {
    int length = 0;
    int index = 0;
    char *copy;

    while (path[length] != 0) {
        length = length + 1;
    }

    // The loader's path buffer need not outlive the process, so the PCB owns a copy
    copy = (char *)kmalloc(length + 1);
    if (copy == NULL) {
        return NULL;
    }

    while (index < length) {
        copy[index] = path[index];
        index = index + 1;
    }
    copy[index] = 0;
    return copy;
}

struct Process *create_process(
    int base_address,
    int size,
    int code_start,
    int data_start,
    int heap_start,
    int heap_size,
    int stack_start,
    int word_count,
    char *binary_path
) {
    struct Process *process = (struct Process *)kmalloc(sizeof(struct Process));
    int stack_pointer = SRAM_BASE + base_address + stack_start;

    if (process == NULL) {
        return NULL;
    }

    process->pid = next_process_id;
    next_process_id = next_process_id + 1;
    process->state = PROCESS_STATE_NEW;
    process->base_address = base_address;
    process->size = size;
    process->heap_start = heap_start;
    process->heap_size = heap_size;
    process->word_count = word_count;
    process->binary_path = copy_process_path(binary_path);
    if (process->binary_path == NULL) {
        kfree(process);
        return NULL;
    }

    process->activation.in1 = 0;
    process->activation.in2 = 0;
    process->activation.acc = 0;
    /*
     * dispatcher_jump_to_process() restores this SP and finishes with RTI, which
     * loads PC from memory[SP + 1] on the restored process stack. Thus SP has to
     * be kept one cell below the stored entry point. At this point BAF is just
     * for optics: it represents an imaginary outer stack frame, so the first
     * generated function prologue saves that instead of a random register value
     */
    process->activation.sp = stack_pointer - 1;
    process->activation.baf = stack_pointer;
    process->activation.cs = SRAM_BASE + base_address + code_start;
    process->activation.ds = SRAM_BASE + base_address + data_start;
    process->waiting_status_ptr = NULL;
    process->waiters.head = NULL;
    process->waiters.tail = NULL;
    process->waiting_queue_ptr = NULL;
    process->wait_next = NULL;
    *((int *)stack_pointer) = process->activation.cs;

    process->next = NULL;
    if (process_list_head == NULL) {
        process_list_head = process;
        process_list_tail = process;
    } else {
        process_list_tail->next = process;
        process_list_tail = process;
    }

    return process;
}

int mark_process_ready_by_pid(int pid) {
    struct Process *process = find_process_by_pid(pid);

    if (process == NULL ||
        process->state != PROCESS_STATE_NEW) {
        return 0;
    }

    process->state = PROCESS_STATE_READY;

    return 1;
}

struct Process *find_process_by_pid(int pid) {
    struct Process *process = process_list_head;

    while (process != NULL) {
        if (process->pid == pid) {
            return process;
        }

        process = process->next;
    }

    return NULL;
}

void remove_from_wait_queue(struct Process *process) {
    if (process->waiting_queue_ptr == NULL) {
        return;
    }

    struct wait_queue *queue = process->waiting_queue_ptr;
    struct Process *previous = NULL;
    struct Process *candidate = queue->head;

    // A wait queue is intrusive: a process can be on only one queue at a time
    while (candidate != NULL && candidate != process) {
        previous = candidate;
        candidate = candidate->wait_next;
    }

    if (candidate == NULL) {
        return;
    }

    if (previous == NULL) {
        queue->head = candidate->wait_next;
    } else {
        previous->wait_next = candidate->wait_next;
    }

    if (queue->tail == candidate) {
        queue->tail = previous;
    }

    candidate->waiting_queue_ptr = NULL;
    candidate->wait_next = NULL;
}

void remove_process(struct Process *process, int status) {
    struct Process *previous = NULL;
    struct Process *candidate = process_list_head;
    struct Process *waiting_process;

    while (candidate != NULL && candidate != process) {
        previous = candidate;
        candidate = candidate->next;
    }

    if (candidate == NULL) {
        return;
    }

    // A blocked process must be unlinked before its PCB is freed; otherwise a
    // later wakeup would follow a dangling queue entry
    remove_from_wait_queue(candidate);

    // Store the status before waking each waiter, whose execution may resume
    // as soon as the scheduler next selects it
    while (candidate->waiters.head != NULL) {
        waiting_process = candidate->waiters.head;
        if (waiting_process->waiting_status_ptr != NULL) {
            *(waiting_process->waiting_status_ptr) = status;
        }
        waiting_process->waiting_status_ptr = NULL;
        wakeup_wait_queue(&(candidate->waiters));
    }

    if (previous == NULL) {
        process_list_head = candidate->next;
    } else {
        previous->next = candidate->next;
    }

    if (process_list_tail == candidate) {
        process_list_tail = previous;
    }

    if (active_process == candidate) {
        active_process = previous;
    }

    pfree(candidate->base_address);
    kfree(candidate->binary_path);
    kfree(candidate);
}

int unload_process_by_pid(int pid) {
    struct Process *process = process_list_head;

    while (process != NULL && process->pid != pid) {
        process = process->next;
    }

    // Removing the running process requires the exit path to switch context
    if (process == NULL || process == active_process) {
        return 0;
    }

    remove_process(process, PROCESS_EXIT_STATUS_SUCCESS);
    return 1;
}

int wait_for_process_by_pid(struct WaitProcessRequest *request) {
    struct Process *process = current_process();
    struct Process *waited_process;

    waited_process = find_process_by_pid(request->pid);
    if (waited_process == NULL) {
        return 1;
    }

    // wait() stores a pointer to its stack-local return status in request->status.
    // When the target exits, it writes its status back through this pointer
    process->waiting_status_ptr = request->status;
    sleep_on_wait_queue(&(waited_process->waiters));
    return 0;
}

void sleep_on_wait_queue(struct wait_queue *queue) {
    struct Process *process = current_process();

    // wait_next is shared by all wait queues
    process->wait_next = NULL;
    process->waiting_queue_ptr = queue;
    if (queue->tail == NULL) {
        queue->head = process;
    } else {
        queue->tail->wait_next = process;
    }
    queue->tail = process;
    process->state = PROCESS_STATE_BLOCKED;
}

int wakeup_wait_queue(struct wait_queue *queue) {
    struct Process *process;

    if (queue->head == NULL) {
        return 0;
    }

    process = queue->head;
    queue->head = process->wait_next;
    if (queue->head == NULL) {
        queue->tail = NULL;
    }

    process->wait_next = NULL;
    process->waiting_queue_ptr = NULL;
    process->state = PROCESS_STATE_READY;
    return 1;
}

int process_heap_start(void) {
    struct Process *process = current_process();

    return SRAM_BASE + process->base_address + process->heap_start;
}

int process_heap_size(void) {
    struct Process *process = current_process();

    return process->heap_size;
}

void exit_process(int status) {
    remove_process(current_process(), status);
    dispatcher_start_next_process();
    // Switching to a next process returns via RTI; shutdown is only reached when none remain
    shutdown();
}
