#include "interrupt_controller.header"

int interrupt_device_isrs[INTERRUPT_DEVICE_COUNT] = {
    2,
    1
};

int interrupt_device_priorities[INTERRUPT_DEVICE_COUNT] = {
    1,
    2
};

int interrupt_controller_device_to_isr_register(int device) {
    return INTERRUPT_CONTROLLER_TIMER_DEVICE_TO_ISR_REGISTER + device;
}

int interrupt_controller_device_to_priority_register(int device) {
    return INTERRUPT_CONTROLLER_TIMER_DEVICE_PRIORITY_REGISTER + device;
}

void interrupt_controller_disable_device(int device) {
    periphery_write_register(
        interrupt_controller_device_to_isr_register(device),
        INTERRUPT_CONTROLLER_DISABLED
    );
    periphery_write_register(
        interrupt_controller_device_to_priority_register(device),
        0
    );
}

void interrupt_controller_activate_timer(void) {
    periphery_write_register(
        INTERRUPT_CONTROLLER_TIMER_INTERVAL_REGISTER,
        INTERRUPT_CONTROLLER_TIMER_INTERVAL
    );
}

void interrupt_controller_initialize(void) {
    int device = 0;
    int interrupt_index;
    int priority;

    while (device < INTERRUPT_DEVICE_COUNT) {
        interrupt_controller_disable_device(device);
        interrupt_index = interrupt_device_isrs[device];
        priority = interrupt_device_priorities[device];

        interrupt_controller_assign_device(device, interrupt_index, priority);

        device = device + 1;
    }
}

void interrupt_controller_assign_device(int device, int interrupt_index, int priority) {
    periphery_write_register(
        interrupt_controller_device_to_isr_register(device),
        interrupt_index
    );
    periphery_write_register(
        interrupt_controller_device_to_priority_register(device),
        priority
    );
}
