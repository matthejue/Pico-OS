// dependencies: ../common/heap.reti_blocks

#include "kmalloc.header"
#include "exception.header"
#include "memory_constants.header"

struct Heap kernel_heap;

void *require_kernel_heap_allocation(void *memory, int size) {
    if (memory == NULL && size > 0) {
        panic_kernel_heap_full();
    }

    return memory;
}

void init_kernel_heap(void) {
    int heap_start = KERNEL_HEAP_START;

    heap_init_region(&kernel_heap, (void *)heap_start, DEFAULT_KERNEL_HEAP_CELLS);
}

void *kmalloc(int size) {
    return require_kernel_heap_allocation(
        heap_alloc_from(&kernel_heap, size),
        size
    );
}

void *krealloc(void *ptr, int size) {
    return require_kernel_heap_allocation(
        heap_realloc_from(&kernel_heap, ptr, size),
        size
    );
}

void kfree(void *ptr) {
    heap_free_from(&kernel_heap, ptr);
}
