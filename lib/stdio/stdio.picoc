#include "stdio.header"
#include "../../common/stddef.header"
#include "../../common/syscall.header"
#include "../../common/uart_protocol.header"

#define PRINTF_BUFFER_CAPACITY 10

int has_unread_input = false;
int unread_input = 0;

void send_byte_over_uart(int value) {
    asm("LOADIN BAF IN1 3");
    asm("LOADI ACC 0"); // SYSCALL_SEND_BYTE_OVER_UART
    asm("INT 0");
}

int receive_byte_over_uart(void) {
    int value = 0;

    asm("LOADI ACC 1"); // SYSCALL_RECEIVE_BYTE_OVER_UART
    asm("INT 0");
    asm("STOREIN BAF ACC 0");
    return value;
}

void flush_printf_buffer(char *buffer, int *buffer_index) {
    if (*buffer_index == 0) {
        return;
    }

    buffer[*buffer_index] = 0;
    uart_print_string(buffer);
    *buffer_index = 0;
}

int append_character_buffered(char *buffer, int buffer_index, int value) {
    if (buffer_index == PRINTF_BUFFER_CAPACITY - 1) {
        flush_printf_buffer(buffer, &buffer_index);
    }

    buffer[buffer_index] = value;
    return buffer_index + 1;
}

int append_decimal_buffered(char *buffer, int buffer_index, int value) {
    char digits[12];
    int index = 0;
    int digit_count = uart_append_decimal(digits, 0, value);

    while (index != digit_count) {
        buffer_index = append_character_buffered(buffer, buffer_index, digits[index]);
        index = index + 1;
    }

    return buffer_index;
}

int is_decimal_digit(int value) { return value >= '0' && value <= '9'; }

int is_whitespace(int value) {
    return value == ' ' || value == '\n' ||
           value == '\r' || value == '\t';
}

int read_input(void) {
    if (has_unread_input) {
        has_unread_input = false;
        return unread_input;
    }

    return receive_byte_over_uart();
}

void unread(int value) {
    has_unread_input = true;
    unread_input = value;
}

void skip_whitespace(void) {
    int current = read_input();

    while (is_whitespace(current)) {
        current = read_input();
    }

    unread(current);
}

int read_decimal(int *target) {
    int current;
    int sign = 1;
    int value = 0;
    int read_any_digit = false;

    skip_whitespace();
    current = read_input();

    if (!is_decimal_digit(current) && current != '-' && current != '+') {
        unread(current);
        return 0;
    }

    if (current == '-' || current == '+') {
        if (current == '-') {
            sign = -1;
        }

        current = read_input();

        if (!is_decimal_digit(current)) {
            unread(current);
            return 0;
        }
    }

    while (is_decimal_digit(current)) {
        value = (value * 10) + (current - '0');
        read_any_digit = true;
        current = read_input();
    }

    unread(current);

    if (!read_any_digit) {
        return 0;
    }

    *target = value * sign;
    return 1;
}

int read_string(char *target) {
    int index = 0;
    int current;

    skip_whitespace();
    current = read_input();

    if (is_whitespace(current)) {
        unread(current);
        target[0] = 0;
        return 0;
    }

    while (current != 0 && !is_whitespace(current)) {
        target[index] = current;
        index++;
        current = read_input();
    }

    unread(current);
    target[index] = 0;
    return index != 0;
}

int next_argument(int argument_index) {
    int base = 0;

    asm("LOADIN BAF IN1 1");
    asm("STOREIN BAF IN1 0");
    // 4 and not 3 because first argument is the format string
    return *((int *)(base + argument_index + 4));
}

int printf(char *format, ...) {
    char buffer[PRINTF_BUFFER_CAPACITY];
    int index = 0;
    int buffer_index = 0;
    int current;
    int argument_index = 0;
    int argument_value;

    while (format[index] != 0) {
        current = format[index];

        if (current == '%') {
            index = index + 1;
            current = format[index];

            if (current == 'd') {
                argument_value = next_argument(argument_index);
                buffer_index = append_decimal_buffered(buffer, buffer_index, argument_value);
                argument_index = argument_index + 1;
            } else if (current == 'c') {
                argument_value = next_argument(argument_index);
                buffer_index = append_character_buffered(buffer, buffer_index, argument_value);
                argument_index = argument_index + 1;
            } else if (current == 's') {
                argument_value = next_argument(argument_index);
                flush_printf_buffer(buffer, &buffer_index);
                uart_print_string((char *)argument_value);
                argument_index = argument_index + 1;
            } else if (current == '%') {
                buffer_index = append_character_buffered(buffer, buffer_index, '%');
            }
        } else {
            buffer_index = append_character_buffered(buffer, buffer_index, current);
        }

        index = index + 1;
    }

    flush_printf_buffer(buffer, &buffer_index);
    return 0;
}

int scanf(char *format, ...) {
    int index = 0;
    int current;
    int argument_index = 0;
    int assigned_count = 0;
    int *target;
    int input;

    while (format[index] != 0) {
        current = format[index];

        if (current == '%') {
            index++;
            current = format[index];

            if (current == 'd') {
                target = (int *)next_argument(argument_index);
                if (!read_decimal(target)) {
                    return assigned_count;
                }
                argument_index++;
                assigned_count++;
            } else if (current == 'c') {
                target = (int *)next_argument(argument_index);
                *target = read_input();
                argument_index++;
                assigned_count++;
            } else if (current == 's') {
                target = (int *)next_argument(argument_index);
                if (!read_string((char *)target)) {
                    return assigned_count;
                }
                argument_index++;
                assigned_count++;
            } else if (current == '%') {
                input = read_input();
                if (input != '%') {
                    unread(input);
                    return assigned_count;
                }
            } else if (current != '%') {
                return assigned_count;
            }
        } else if (is_whitespace(current)) {
            while (is_whitespace(format[index + 1])) {
                index++;
            }

            skip_whitespace();
        } else {
            input = read_input();
            if (input != current) {
                unread(input);
                return assigned_count;
            }
        }

        index = index + 1;
    }

    return assigned_count;
}
