#include "args.header"
#include "../../common/stddef.header"

// Stores the caller's BAF in the first local variable of an args helper
static inline void load_main_frame(void) {
    asm("LOADIN BAF IN1 1");
    asm("STOREIN BAF IN1 0");
}

int args_argc(void) {
    int main_frame;

    load_main_frame();
    return *((int *)(main_frame + 3));
}

char **args_argv(void) {
    int main_frame;

    load_main_frame();
    return (char **)(*((int *)(main_frame + 4)));
}

char *args_get(int index) {
    int main_frame;
    int argc;
    char **argv;

    load_main_frame();
    argc = *((int *)(main_frame + 3));
    argv = (char **)(*((int *)(main_frame + 4)));

    if (index < 0 || index >= argc) {
        return NULL;
    }

    return argv[index];
}

int atoi(char *text) {
    int index = 0; // Current character position in text
    int value = 0;
    int negative = false;

    if (text == NULL) {
        return 0;
    }

    if (text[index] == '-' || text[index] == '+') {
        negative = text[index] == '-';
        index = index + 1;
    }

    while (text[index] != 0) {
        if (negative) {
            // Accumulate negatives directly so -2147483648 remains representable
            value = (value * 10) - (text[index] - '0');
        } else {
            value = (value * 10) + (text[index] - '0');
        }
        index = index + 1;
    }

    return value;
}
