#include "unistd.header"
#include "../../common/syscall.header"

void wait_queue_init(struct wait_queue *wq) {
    wq->head = NULL;
    wq->tail = NULL;
}

void sleep(struct wait_queue *wq) {
    if (wq == NULL) {
        return;
    }

    asm("LOADIN BAF ACC -2");
    asm("MOVE ACC IN1");
    asm("LOADI ACC 12"); // SYSCALL_SLEEP
    asm("INT 0");
}

void wakeup(struct wait_queue *wq) {
    if (wq == NULL) {
        return;
    }

    asm("LOADIN BAF ACC -2");
    asm("MOVE ACC IN1");
    asm("LOADI ACC 13"); // SYSCALL_WAKEUP
    asm("INT 0");
}
