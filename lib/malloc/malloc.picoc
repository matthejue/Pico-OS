// dependencies: ../../common/heap.picoc

#include "malloc.header"

void init_process_heap(void) {
    int heap_start;
    int heap_size;

    // SYSCALL_PROCESS_HEAP_START
    asm("LOADI ACC 6");
    asm("INT 4");
    asm("STOREIN BAF ACC 0");

    // SYSCALL_PROCESS_HEAP_SIZE
    asm("LOADI ACC 7");
    asm("INT 4");
    asm("STOREIN BAF ACC -1");

    heap_init_at((void *)heap_start, heap_size);
}

void *malloc(int size) {
    return heap_alloc(size);
}

void free(void *ptr) {
    heap_free(ptr);
}
