// dependencies: ../../common/heap.reti_blocks

#include "stdlib.header"
#include "../../common/heap.header"

struct Heap process_heap;

void init_process_heap(void) {
    int heap_start;
    int heap_size;

    // SYSCALL_PROCESS_HEAP_START
    asm("LOADI ACC 6");
    asm("INT 0");
    asm("STOREIN BAF ACC 0");

    // SYSCALL_PROCESS_HEAP_SIZE
    asm("LOADI ACC 7");
    asm("INT 0");
    asm("STOREIN BAF ACC -1");

    heap_init_region(&process_heap, (void *)heap_start, heap_size);
}

void *malloc(int size) {
    return heap_alloc_from(&process_heap, size);
}

void *realloc(void *ptr, int size) {
    return heap_realloc_from(&process_heap, ptr, size);
}

void free(void *ptr) {
    heap_free_from(&process_heap, ptr);
}
