// dependencies: ../../lib/unistd/libunistd.reti_blocks ../../lib/sys/wait/libwait.reti_blocks

#include "../../lib/unistd/unistd.header"
#include "../../lib/sys/wait/wait.header"
#include "../../common/stddef.header"

void run_program(char *path, char *arguments) {
    int pid = load(path);

    if (pid != 0 && run(pid, arguments, NULL)) {
        waitpid(pid);
    }
}

int main(void) {
    dup2(STDOUT_FILENO, STDERR_FILENO);

    run_program("./user/cat.bin", NULL);
    run_program(
        "./user/cat.bin",
        "tests/user_program_error_messages/missing.txt"
    );
    run_program("./user/cat.bin", "user");
    run_program("./user/kill.bin", NULL);
    run_program("./user/kill.bin", "999");
    run_program("./user/kill.bin", "999 99");
    run_program("./user/kill.bin", "-9 3");
    return 0;
}
