// dependencies: ../../lib/signal/libsignal.reti_blocks ../../lib/schedule/libschedule.reti_blocks

#include "../../lib/signal/signal.header"
#include "../../lib/schedule/schedule.header"
#include "../../common/stddef.header"

bool continued = false;

void handle_sigcont(int signal_number) {
    if (signal_number == SIGCONT) {
        continued = true;
    }
}

int main(void) {
    if (signal(SIGCONT, handle_sigcont) == SIG_ERR) {
        return 1;
    }

    yield();
    while (!continued) {
        yield();
    }
    return 6;
}
