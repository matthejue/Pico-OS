// dependencies: ../../lib/unistd/libunistd.reti_blocks ../../lib/sys/prctl/libprctl.reti_blocks ../../lib/schedule/libschedule.reti_blocks

#include "../../lib/unistd/unistd.header"
#include "../../lib/sys/prctl/prctl.header"
#include "../../lib/schedule/schedule.header"
#include "../../lib/signal/signal.header"
#include "../../common/stddef.header"

int main(void) {
    int child;

    if (prctl(PR_SET_PDEATHSIG, SIGTERM) == -1) {
        return -1;
    }

    child = load(
        "tests/parent_death_signal/undo_worker.bin"
    );
    run(child, NULL, NULL);

    // The child yields after disabling its inherited setting
    yield();
    return child;
}
