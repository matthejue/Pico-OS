// dependencies: ../../lib/unistd/libunistd.picoc ../../lib/sys/wait/libwait.picoc

#include "../../lib/unistd/unistd.header"
#include "../../lib/sys/wait/wait.header"

void deactivate_timer_interrupt(void) {
    asm("STOREIN BAF DS 0"); // Save DS before switching address spaces
    asm("LOADI DS 1048576"); // 2^20
    asm("MULTI DS 1024"); // 2^20 * 2^10 = 2^30, periphery base
    asm("LOADI ACC 0");
    asm("STORE ACC 9"); // Timer interval register
    asm("LOADIN BAF DS 0"); // Restore DS after periphery access
}

int main(void) {
    int red_worker;
    int green_worker;
    int blue_worker;

    deactivate_timer_interrupt();

    red_worker = load("tests/scheduler_round_robin/worker.bin");
    green_worker = load("tests/scheduler_round_robin/worker.bin");
    blue_worker = load("tests/scheduler_round_robin/worker.bin");

    run(red_worker, "red", NULL);
    run(green_worker, "green", NULL);
    run(blue_worker, "blue", NULL);

    waitpid(red_worker);
    waitpid(green_worker);
    waitpid(blue_worker);

    return 0;
}
