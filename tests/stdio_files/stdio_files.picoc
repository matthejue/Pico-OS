// dependencies: ../../lib/stdio/libstdio.reti_blocks ../../lib/fcntl/libfcntl.reti_blocks ../../lib/unistd/libunistd.reti_blocks

#include "../../lib/stdio/stdio.header"
#include "../../lib/fcntl/fcntl.header"
#include "../../lib/unistd/unistd.header"

#define TEST_PATH "/tmp/pico_os_stdio_files.txt"

int main(void) {
    char contents[32];
    FILE *stream;
    int file_descriptor;
    int count;

    stream = fopen(TEST_PATH, "w");
    if (stream == NULL) {
        return 1;
    }
    fprintf(stream, "%s %d%c", "value", 42, '\n');
    fclose(stream);

    stream = fopen(TEST_PATH, "a");
    if (stream == NULL) {
        return 2;
    }
    fputs("more", stream);
    fputc('\n', stream);
    fclose(stream);

    file_descriptor = open(TEST_PATH, O_RDONLY);
    if (file_descriptor < 0) {
        return 3;
    }
    count = read(file_descriptor, contents, 32);
    close(file_descriptor);
    if (count != 14) {
        return 4;
    }

    write(STDOUT_FILENO, contents, count);
    printf("stdio ok%c", '\n');
    return 0;
}
