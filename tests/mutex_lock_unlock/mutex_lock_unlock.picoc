// dependencies: ../../lib/mutex/libmutex.reti_blocks ../../lib/stdio/libstdio.reti_blocks

#include "../../lib/stdio/stdio.header"
#include "../../lib/mutex/mutex.header"

int main(void) {
    struct mutex m;

    mutex_init(&m);

    mutex_lock(&m);
    printf("%d ", 42);
    mutex_unlock(&m);

    mutex_lock(&m);
    printf("%d ", 84);
    mutex_unlock(&m);

    return 0;
}
