// dependencies: ../../lib/stdio/libstdio.picoc ../../lib/unistd/libunistd.picoc ../../lib/sys/wait/libwait.picoc ../../lib/sys/mman/libmman.picoc

#include "../../lib/stdio/stdio.header"
#include "../../lib/unistd/unistd.header"
#include "../../lib/sys/wait/wait.header"
#include "../../lib/sys/mman/mman.header"

int main(void) {
    int first_worker;
    int second_worker;
    int third_worker;
    int shared_memory_id;
    int *shared_values;

    first_worker = load("tests/shared_memory/worker.bin");
    second_worker = load("tests/shared_memory/worker.bin");
    third_worker = load("tests/shared_memory/worker.bin");

    run(first_worker, "worker-shared-memory 0", NULL);
    run(second_worker, "worker-shared-memory 1", NULL);
    run(third_worker, "worker-shared-memory 2", NULL);

    waitpid(first_worker);
    waitpid(second_worker);
    waitpid(third_worker);

    shared_memory_id = shm_open("worker-shared-memory", 3);
    shared_values = (int *)mmap(shared_memory_id);
    printf(
        "shared memory: %d %d %d\n",
        shared_values[0],
        shared_values[1],
        shared_values[2]
    );
    shm_unlink("worker-shared-memory");
    return 0;
}
