// dependencies: ../../lib/schedule/libschedule.reti_blocks

#include "../../lib/schedule/schedule.header"

int main(void) {
    int count = 0;
    int delay;

    while (count < 100) {
        delay = count % 17;
        while (delay > 0) {
            delay = delay - 1;
        }
        yield();
        count = count + 1;
    }
    return 0;
}
