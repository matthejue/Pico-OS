#include "../lib/process/process.header"
#include "../lib/stdio/stdio.header"
#include "../lib/string/string.header"
#include "../common/uart_protocol.header"
#include "../common/syscall.header"

#define INIT_COMMAND_BUFFER_CAPACITY 80

int read_line(char *buffer, int capacity) {
    int index = 0;
    int value = receive_byte_over_uart();

    while (value != '\n' && value != '\r') {
        if (index < capacity - 1) {
            buffer[index] = value;
            index = index + 1;
        }

        value = receive_byte_over_uart();
    }

    buffer[index] = 0;
    return index;
}

int parse_process_id(char *value) {
    int index = 0;
    int result = 0;

    while (value[index] >= '0' && value[index] <= '9') {
        result = result * 10 + value[index] - '0';
        index = index + 1;
    }

    return result;
}

char *run_arguments(char *command) {
    int index = 4;

    while (command[index] >= '0' && command[index] <= '9') {
        index = index + 1;
    }

    while (command[index] == ' ' || command[index] == '\t') {
        index = index + 1;
    }

    if (command[index] == 0) {
        return (char *)0;
    }

    return command + index;
}

int strip_background_operator(char *command) {
    int index = strlen(command);

    while (index > 0 &&
           (command[index - 1] == ' ' || command[index - 1] == '\t')) {
        index = index - 1;
    }

    if (index == 0 || command[index - 1] != '&') {
        return 0;
    }

    index = index - 1;
    while (index > 0 &&
           (command[index - 1] == ' ' || command[index - 1] == '\t')) {
        index = index - 1;
    }
    command[index] = 0;
    return 1;
}

void shutdown(void) {
    asm("LOADI ACC 2"); // SYSCALL_SHUTDOWN
    asm("INT 0");
}

void handle_command(char *command) {
    int pid;
    int background;

    if (strcmp(command, "quit") == 0 || strcmp(command, "exit") == 0) {
        shutdown();
    } else if (strncmp(command, "load ", 5) == 0 && command[5] != 0) {
        load(command + 5);
    } else if (strncmp(command, "run ", 4) == 0 && command[4] != 0) {
        background = strip_background_operator(command);
        pid = parse_process_id(command + 4);
        if (!run(pid, run_arguments(command))) {
            printf("error: process not found%c", '\n');
        } else if (!background) {
            wait(pid);
        }
    } else if (strncmp(command, "unload ", 7) == 0 && command[7] != 0) {
        pid = parse_process_id(command + 7);
        if (!unload(pid)) {
            printf("error: process not found%c", '\n');
        }
    } else if (strcmp(command, "list") == 0) {
        list();
    } else {
        printf("error: unknown command%c", '\n');
    }
}

int main(void) {
    char command[INIT_COMMAND_BUFFER_CAPACITY];

    while (1) {
        read_line(command, INIT_COMMAND_BUFFER_CAPACITY);
        handle_command(command);
    }

    return 0;
}
