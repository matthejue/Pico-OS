#include "../lib/unistd/unistd.header"
#include "../lib/stdlib/stdlib.header"
#include "../common/uart_protocol.header"

#define INIT_ENVIRONMENT_CAPACITY 256

bool read_environment(void) {
    char *contents;
    char *name;
    char *value;
    int length;
    int index = 0;

    contents = (char *)malloc(INIT_ENVIRONMENT_CAPACITY);
    if (contents == NULL) {
        return false;
    }

    length = uart_read_file(
        "./opts/environment.txt",
        contents,
        INIT_ENVIRONMENT_CAPACITY
    );
    if (length < 0) {
        free(contents);
        return false;
    }

    while (index < length) {
        name = contents + index;
        while (contents[index] != '=') {
            index = index + 1;
        }
        contents[index] = 0;
        index = index + 1;

        value = contents + index;
        while (index < length &&
               contents[index] != '\n' &&
               contents[index] != '\r') {
            index = index + 1;
        }
        contents[index] = 0;

        if (setenv(name, value, true) != 0) {
            free(contents);
            return false;
        }

        index = index + 1;
        while (index < length &&
               (contents[index] == '\n' || contents[index] == '\r')) {
            index = index + 1;
        }
    }

    free(contents);
    return true;
}

int main(void) {
    int shell_pid;

    if (!read_environment()) {
        return 1;
    }

    shell_pid = load("./system/shell.bin");
    if (shell_pid == 0) {
        return 1;
    }

    if (!run(shell_pid, NULL, NULL)) {
        return 1;
    }

    wait(shell_pid);
    return 0;
}
