#include "../lib/unistd/unistd.header"
#include "../lib/fcntl/fcntl.header"
#include "../lib/sys/wait/wait.header"
#include "../lib/stdlib/stdlib.header"
#include "../common/loading_bar.header"
#include "../opts/config.header"

#define INIT_ENVIRONMENT_CAPACITY 256

bool read_environment(void) {
    char *contents;
    char *name;
    char *value;
    int file_descriptor;
    int length;
    int index = 0;

    contents = (char *)malloc(INIT_ENVIRONMENT_CAPACITY);
    if (contents == NULL) {
        return false;
    }

    file_descriptor = open("./opts/environment.txt", O_RDONLY);
    if (file_descriptor < 0) {
        free(contents);
        return false;
    }
    length = read(
        file_descriptor,
        contents,
        INIT_ENVIRONMENT_CAPACITY - 1
    );
    close(file_descriptor);
    if (length < 0) {
        free(contents);
        return false;
    }
    contents[length] = 0;

    while (index < length) {
        name = contents + index;
        while (contents[index] != '=') {
            index = index + 1;
        }
        contents[index] = 0;
        index = index + 1;

        value = contents + index;
        while (index < length &&
               contents[index] != '\n' &&
               contents[index] != '\r') {
            index = index + 1;
        }
        contents[index] = 0;

        if (setenv(name, value, true) != 0) {
            free(contents);
            return false;
        }

        index = index + 1;
        while (index < length &&
               (contents[index] == '\n' || contents[index] == '\r')) {
            index = index + 1;
        }
    }

    free(contents);
    return true;
}

int main(void) {
    int shell_pid;

    if (!read_environment()) {
        return 1;
    }
    if (loading_bar_enabled) {
        if (setenv(
                LOADING_BAR_ENVIRONMENT_VARIABLE,
                "true",
                true
            ) != 0) {
            return 1;
        }
    }

    shell_pid = load("./user/shell.bin");
    if (shell_pid == 0) {
        return 1;
    }

    if (!run(shell_pid, NULL, NULL)) {
        return 1;
    }

    waitpid(shell_pid);
    return 0;
}
