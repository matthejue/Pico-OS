// dependencies: ../library/fcntl/libfcntl.reti_blocks ../library/unistd/libunistd.reti_blocks ../library/sys/wait/libwait.reti_blocks

#include "../common/loading_bar.header"
#include "../common/stddef.header"
#include "../library/fcntl/fcntl.header"
#include "../library/stdlib/stdlib.header"
#include "../library/sys/wait/wait.header"
#include "../library/unistd/unistd.header"

#define FAST_TEST_PATH_CAPACITY 160
#define FAST_TEST_SAVED_STDOUT_FILENO 7

void append_path(char *path, int *length, char *suffix) {
    int index = 0;

    while (suffix[index] != 0) {
        path[*length] = suffix[index];
        *length = *length + 1;
        index = index + 1;
    }
    path[*length] = 0;
}

void build_test_path(char *directory, char *suffix, char *path) {
    int length = 0;

    append_path(path, &length, directory);
    append_path(path, &length, suffix);
}

bool run_test_launcher(char *test_directory) {
    char launcher_path[FAST_TEST_PATH_CAPACITY];
    char output_path[FAST_TEST_PATH_CAPACITY];
    int launcher_pid;
    int output_file_descriptor;
    bool started = false;
    bool stdout_saved = false;

    build_test_path(test_directory, "/launcher.bin", launcher_path);
    build_test_path(test_directory, "/output.txt", output_path);

    output_file_descriptor = open(
        output_path,
        O_WRONLY | O_CREAT | O_TRUNC
    );
    if (output_file_descriptor >= 0) {
        stdout_saved =
            dup2(STDOUT_FILENO, FAST_TEST_SAVED_STDOUT_FILENO) >= 0;
        if (stdout_saved &&
            dup2(output_file_descriptor, STDOUT_FILENO) >= 0) {
            close(output_file_descriptor);
            launcher_pid = load(launcher_path);
            if (launcher_pid != 0) {
                started = run(launcher_pid, NULL, NULL);
            }
            dup2(FAST_TEST_SAVED_STDOUT_FILENO, STDOUT_FILENO);
            close(FAST_TEST_SAVED_STDOUT_FILENO);
            if (started) {
                waitpid(launcher_pid);
            }
        } else {
            close(output_file_descriptor);
            if (stdout_saved) {
                close(FAST_TEST_SAVED_STDOUT_FILENO);
            }
        }
    }

    reset_processes();
    return started;
}

char *read_manifest(char *path, int *size) {
    char *contents;
    int file_descriptor = open(path, O_RDONLY);

    if (file_descriptor < 0) {
        return NULL;
    }
    *size = lseek(file_descriptor, 0, SEEK_END);
    if (*size <= 0 ||
        lseek(file_descriptor, 0, SEEK_SET) < 0) {
        close(file_descriptor);
        return NULL;
    }

    contents = (char *)malloc(*size + 1);
    if (contents == NULL ||
        read(file_descriptor, contents, *size) != *size) {
        close(file_descriptor);
        free(contents);
        return NULL;
    }
    close(file_descriptor);
    contents[*size] = 0;
    return contents;
}

int main(int argc, char **argv) {
    char *manifest;
    int index = 0;
    int manifest_size;
    int test_start;
    bool passed = true;

    if (argc != 2) {
        return 1;
    }

    // Prevents test launchers and their children from inheriting loader UI
    unsetenv(LOADING_BAR_ENVIRONMENT_VARIABLE);
    manifest = read_manifest(argv[1], &manifest_size);
    if (manifest == NULL) {
        return 1;
    }

    while (index < manifest_size) {
        test_start = index;
        while (index < manifest_size && manifest[index] != '\n') {
            index = index + 1;
        }
        manifest[index] = 0;
        if (index > test_start &&
            !run_test_launcher(manifest + test_start)) {
            passed = false;
        }
        index = index + 1;
    }

    free(manifest);
    if (!passed) {
        return 1;
    }
    return 0;
}
