#include "syscall.header"

int syscall_call(int syscall_number, int argument) {
    int result;

    asm("LOADIN BAF ACC 3");
    asm("LOADIN BAF IN1 4");
    asm("INT 4");
    asm("STOREIN BAF ACC 0");
    return result;
}

int syscall_load_process(char *path) {
    return syscall_call(SYSCALL_LOAD_PROCESS, (int)path);
}

int syscall_run_process(int pid) {
    return syscall_call(SYSCALL_RUN_PROCESS, pid);
}

int syscall_run_process_with_arguments(int pid, char *arguments) {
    struct RunProcessRequest request;

    request.pid = pid;
    request.arguments = arguments;
    return syscall_call(SYSCALL_RUN_PROCESS_WITH_ARGUMENTS, (int)&request);
}

void syscall_list_processes(void) {
    syscall_call(SYSCALL_LIST_PROCESSES, 0);
}

int syscall_unload_process(int pid) {
    return syscall_call(SYSCALL_UNLOAD_PROCESS, pid);
}

int syscall_process_heap_start(void) {
    return syscall_call(SYSCALL_PROCESS_HEAP_START, 0);
}

int syscall_process_heap_size(void) {
    return syscall_call(SYSCALL_PROCESS_HEAP_SIZE, 0);
}

int syscall_exit(int status) {
    return syscall_call(SYSCALL_EXIT, status);
}

int syscall_wait_process(int pid, int *status) {
    struct WaitProcessRequest request;

    request.pid = pid;
    request.status = status;
    return syscall_call(SYSCALL_WAIT_PROCESS, (int)&request);
}

void syscall_shutdown(void) {
    syscall_call(SYSCALL_SHUTDOWN, 0);
}
