__attribute__((naked))
__attribute__((section("ivt")))
void send_byte_over_uart_interrupt(void) {
    // Save caller scratch regs and call the shared UART send routine.
    asm("PUSH IN1");
    asm("PUSH ACC");
    asm("PUSH ACC");
    asm("LOADI32 ACC send_byte_over_uart_interrupt_return");
    asm("ADD ACC CS");
    asm("PUSH ACC");
    asm("LOADI32 ACC send_byte_over_uart");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
__attribute__((section("ivt")))
void send_byte_over_uart_interrupt_return(void) {
    // Restore caller regs after UART send completes.
    asm("POP ACC");
    asm("POP ACC");
    asm("POP IN1");
    asm("RTI");
}

__attribute__((naked))
__attribute__((section("ivt")))
void receive_byte_over_uart_interrupt(void) {
    // Save caller scratch regs and call the shared UART receive routine.
    asm("PUSH IN1");
    asm("PUSH IN2");
    asm("LOADI32 ACC receive_byte_over_uart_interrupt_return");
    asm("ADD ACC CS");
    asm("PUSH ACC");
    asm("LOADI32 ACC receive_byte_over_uart");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
__attribute__((section("ivt")))
void receive_byte_over_uart_interrupt_return(void) {
    // Return received byte in ACC, then restore caller regs.
    asm("MOVE IN2 ACC");
    asm("POP IN2");
    asm("POP IN1");
    asm("RTI");
}
