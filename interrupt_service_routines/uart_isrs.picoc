__attribute__((naked))
__attribute__((section("ivt")))
void send_byte_over_uart_interrupt(void) {
    asm("PUSH IN1");
    asm("PUSH DS");
    asm("LOADI DS 1048576");
    asm("MULTI DS 1024");
    asm("ANDI ACC 255");
    asm("STORE ACC 0");
    asm("LOAD ACC 2");
    asm("ANDI ACC -2");
    asm("STORE ACC 2");
    asm("LOAD ACC 2");
    asm("ANDI ACC 1");
    asm("JUMP== -2");
    asm("POP DS");
    asm("POP IN1");
    asm("RTI");
}

__attribute__((naked))
__attribute__((section("ivt")))
void receive_byte_over_uart_interrupt(void) {
    asm("PUSH IN1");
    asm("PUSH DS");
    asm("LOADI DS 1048576");
    asm("MULTI DS 1024");
    asm("LOAD ACC 2");
    asm("ANDI ACC -3");
    asm("STORE ACC 2");
    asm("LOAD ACC 2");
    asm("ANDI ACC 2");
    asm("JUMP== -2");
    asm("LOAD ACC 1");
    asm("ANDI ACC 255");
    asm("POP DS");
    asm("POP IN1");
    asm("RTI");
}
