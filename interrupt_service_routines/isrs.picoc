#include "../common/stddef.header"

#define TEST_INTERRUPT_VECTOR_COUNT 2

__attribute__((section("ivt")))
void send_byte_over_uart(int value);

__attribute__((section("ivt")))
int receive_byte_over_uart(void);

void send_byte_over_uart_syscall(void);
void receive_byte_over_uart_syscall(void);
void timer_interrupt(void);
void syscall_interrupt(void);

__attribute__((section("ivt")))
void (*interrupt_vector_table[TEST_INTERRUPT_VECTOR_COUNT])(void) = {
    syscall_interrupt,
    timer_interrupt
};

__attribute__((naked))
__attribute__((section("ivt")))
void send_byte_over_uart_syscall(void) {
    // The syscall argument is in IN1. Build a normal PicoC call frame for
    // send_byte_over_uart and preserve the caller's IN1 register
    asm("PUSH IN1");
    asm("PUSH IN1");
    asm("LOADI32 ACC send_byte_over_uart_syscall_return");
    asm("ADD ACC CS");
    asm("PUSH ACC");
    asm("LOADI32 ACC send_byte_over_uart");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
__attribute__((section("ivt")))
void send_byte_over_uart_syscall_return(void) {
    asm("POP ACC");
    asm("POP IN1");
    asm("LOADI IN2 1");
    asm("RTI");
}

__attribute__((naked))
__attribute__((section("ivt")))
void receive_byte_over_uart_syscall(void) {
    // receive_byte_over_uart already returns in the syscall result register
    asm("PUSH IN1"); // Preserve the interrupted program's IN1 register
    asm("LOADI32 ACC receive_byte_over_uart_syscall_return");
    asm("ADD ACC CS");
    asm("PUSH ACC");
    asm("LOADI32 ACC receive_byte_over_uart");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
__attribute__((section("ivt")))
void receive_byte_over_uart_syscall_return(void) {
    asm("POP IN1");
    asm("RTI");
}

__attribute__((naked))
__attribute__((section("ivt")))
void timer_interrupt(void) {
    asm("RTI");
}

__attribute__((naked))
__attribute__((section("ivt")))
void syscall_interrupt(void) {
    // These test syscalls use ACC for the selector and IN2 for the result
    // The UART cases tail-jump to the call-frame adapters above
    asm("JUMP== 9");
    asm("SUBI ACC 1");
    asm("JUMP== 12");
    asm("SUBI ACC 5");
    asm("JUMP== 15");
    asm("SUBI ACC 1");
    asm("JUMP== 17");
    asm("LOADI IN2 0");
    asm("RTI");
    asm("LOADI32 ACC send_byte_over_uart_syscall");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
    asm("LOADI32 ACC receive_byte_over_uart_syscall");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
    asm("LOADI32 IN2 -2147450880");
    asm("RTI");
    asm("LOADI IN2 16000");
    asm("RTI");
}
