#include "../common/stddef.header"
#include "../common/uart_hardware_ivt.header"

#define TEST_INTERRUPT_VECTOR_COUNT 5

void send_byte_over_uart_interrupt(void);
void receive_byte_over_uart_interrupt(void);
void timer_interrupt(void);
void syscall_interrupt(void);

__attribute__((section("ivt")))
void (*interrupt_vector_table[TEST_INTERRUPT_VECTOR_COUNT])(void) = {
    send_byte_over_uart_interrupt,
    receive_byte_over_uart_interrupt,
    timer_interrupt,
    0,
    syscall_interrupt
};

__attribute__((naked))
__attribute__((section("ivt")))
void timer_interrupt(void) {
    asm("RTI");
}

__attribute__((naked))
__attribute__((section("ivt")))
void syscall_interrupt(void) {
    asm("SUBI ACC 6");
    asm("JUMP== 5");
    asm("SUBI ACC 1");
    asm("JUMP== 7");
    asm("LOADI ACC 0");
    asm("RTI");
    asm("LOADI32 ACC -2147450880");
    asm("RTI");
    asm("LOADI ACC 16000");
    asm("RTI");
}
