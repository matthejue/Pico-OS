#include "../common/stddef.header"
#include "../kernel/memory_constants.header"
#include "../kernel/dispatcher.header"
#include "../kernel/interrupt_controller.header"
#include "../kernel/syscall.header"

#define OS_INTERRUPT_VECTOR_COUNT 5

void send_byte_over_uart_interrupt_stub(void);
void receive_byte_over_uart_interrupt_stub(void);
void timer_interrupt(void);
void syscall_interrupt(void);

__attribute__((section("ivt")))
void (*interrupt_vector_table[OS_INTERRUPT_VECTOR_COUNT])(void) = {
    send_byte_over_uart_interrupt_stub,
    receive_byte_over_uart_interrupt_stub,
    timer_interrupt,
    NULL,
    syscall_interrupt
};

__attribute__((naked))
__attribute__((section("ivt")))
void send_byte_over_uart_interrupt_stub(void) {
    // The interrupt argument is in ACC; kernel functions receive arguments on
    // the stack and return through IN1. The interrupted process may use a
    // different CS, so run the handler in the kernel code segment.
    asm("PUSH IN1");
    asm("PUSH CS");
    asm("PUSH ACC");
    asm(KERNEL_CS_START_ASM);
    asm("LOADI32 ACC send_byte_over_uart_interrupt_return");
    asm("ADD ACC CS");
    asm("PUSH ACC");
    asm("LOADI32 ACC send_byte_over_uart");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
__attribute__((section("ivt")))
void send_byte_over_uart_interrupt_return(void) {
    asm("POP ACC"); // remove the kernel function argument
    asm("POP CS");
    asm("POP IN1");
    asm("RTI");
}

__attribute__((naked))
__attribute__((section("ivt")))
void receive_byte_over_uart_interrupt_stub(void) {
    // The kernel ABI returns values in IN2; the interrupted caller expects ACC.
    asm("PUSH IN1");
    asm("PUSH CS");
    asm(KERNEL_CS_START_ASM);
    asm("LOADI32 ACC receive_byte_over_uart_interrupt_return");
    asm("ADD ACC CS");
    asm("PUSH ACC");
    asm("LOADI32 ACC receive_byte_over_uart");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
__attribute__((section("ivt")))
void receive_byte_over_uart_interrupt_return(void) {
    asm("MOVE IN2 ACC");
    asm("POP CS");
    asm("POP IN1");
    asm("RTI");
}

static inline void load_kernel_context(void) {
    asm(KERNEL_CS_START_ASM);
    asm(KERNEL_DS_START_ASM);
    asm(KERNEL_SP_START_ASM);
}

__attribute__((naked))
void timer_interrupt(void) {
    asm("PUSH ACC");
    asm("PUSH IN1");
    asm("PUSH IN2");
    asm("PUSH BAF");
    asm("PUSH CS");
    asm("PUSH DS");

    asm(KERNEL_CS_ACC_ASM);
    asm("SUB ACC CS");
    asm("JUMP!= 14");
    asm("POP DS");
    asm("POP CS");
    asm("POP BAF");
    asm("POP IN2");
    asm("POP IN1");
    asm("POP ACC");
    asm("RTI");

    asm("MOVE SP BAF");
    load_kernel_context();

    asm("LOADIN BAF IN1 6");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 5");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 4");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 3");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 2");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 1");
    asm("PUSH IN1");
    asm("ADDI BAF 6");
    asm("PUSH BAF");

    asm("LOADI32 ACC timer_interrupt_return");
    asm("ADD ACC CS");
    asm("PUSH ACC");
    asm("LOADI32 ACC dispatcher_tick");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
void timer_interrupt_return(void) {
    asm("MOVE IN2 BAF");
    asm("LOADIN BAF SP 14");
    asm("LOADIN BAF CS 16");
    asm("LOADIN BAF DS 17");
    asm("LOADIN BAF IN1 11");
    asm("LOADIN BAF IN2 12");
    asm("LOADIN BAF ACC 13");
    asm("LOADIN BAF BAF 15");
    asm("RTI");
}

__attribute__((naked))
void syscall_interrupt(void) {
    asm("PUSH IN1");
    asm("PUSH BAF");
    asm("PUSH CS");
    asm("PUSH DS");
    asm("PUSH ACC");
    asm("MOVE SP BAF");
    load_kernel_context();

    asm("PUSH BAF");
    asm("LOADIN BAF IN2 5");
    asm("PUSH IN2");
    asm("LOADIN BAF IN2 1");
    asm("PUSH IN2");

    asm("LOADI32 ACC syscall_interrupt_return");
    asm("ADD ACC CS");
    asm("PUSH ACC");
    asm("LOADI32 ACC kernel_syscall_handle");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
void syscall_interrupt_return(void) {
    asm("ADDI SP 2");
    asm("LOADIN SP BAF 1");
    asm("ADDI SP 1");
    asm("MOVE BAF SP");
    asm("ADDI SP 1");
    asm("POP DS");
    asm("POP CS");
    asm("POP BAF");
    asm("POP IN1");
    asm("MOVE IN2 ACC");
    asm("RTI");
}
