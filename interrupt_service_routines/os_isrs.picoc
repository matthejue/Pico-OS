#include "../common/stddef.header"
#include "../kernel/memory_constants.header"
#include "../kernel/dispatcher.header"
#include "../kernel/interrupt_controller.header"
#include "../kernel/syscall.header"

#define OS_INTERRUPT_VECTOR_COUNT 2

void timer_interrupt(void);
void syscall_interrupt(void);

__attribute__((section("ivt")))
void (*interrupt_vector_table[OS_INTERRUPT_VECTOR_COUNT])(void) = {
    syscall_interrupt,
    timer_interrupt
};

static inline void load_kernel_context(void) {
    // Each time kernel code runs, it finishes its task before returning. Its stackframes
    // and stack values are then no longer needed, so SP is always set to the same
    // value here. The next kernel function call sets BAF to a suitable value,
    // so BAF does not need to be set here
    asm(KERNEL_CS_START_ASM); // LOADI32 CS kernel_codesegment_start
    asm(KERNEL_DS_START_ASM); // LOADI32 DS kernel_datasegment_start
    asm(KERNEL_SP_START_ASM); // LOADI32 SP kernel_stack_start
}

__attribute__((naked))
void timer_interrupt(void) {
    // Saves the interrupted context before deciding whether to enter the scheduler
    asm("PUSH ACC");
    asm("PUSH IN1");
    asm("PUSH IN2");
    asm("PUSH BAF");
    asm("PUSH CS");
    asm("PUSH DS");
    // SP is saved later. From then on, its value is called old_sp

    // Restores kernel regs and returns if CS == kernel_codesegment_start
    asm(KERNEL_CS_ACC_ASM); // LOADI32 ACC kernel_codesegment_start
    asm("SUB ACC CS");
    asm("JUMP!= 14"); // If CS != kernel_codesegment_start, enter the scheduler path
    asm("POP DS");
    asm("POP CS");
    asm("POP BAF");
    asm("POP IN2");
    asm("POP IN1");
    asm("POP ACC");
    asm("RTI");

    // BAF keeps old_sp while loading kernel CS, DS and SP
    asm("MOVE SP BAF");
    load_kernel_context();

    // Copies the interrupted context onto the kernel stack for dispatcher_tick
    asm("LOADIN BAF IN1 6");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 5");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 4");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 3");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 2");
    asm("PUSH IN1");
    asm("LOADIN BAF IN1 1");
    asm("PUSH IN1");
    // Passes old_sp above the six saved words. Old BAF cannot be used instead of
    // old_sp because the interrupted function's stack frame may have a varying sizes
    asm("ADDI BAF 6");
    asm("PUSH BAF"); // old_sp

    // Calls dispatcher_tick and returns through timer_interrupt_return
    asm("LOADI32 ACC timer_interrupt_return");
    asm("ADD ACC CS");
    asm("PUSH ACC"); // return address: context restoration stub
    asm("LOADI32 ACC dispatcher_tick");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
void timer_interrupt_return(void) {
    // ADDI SP 7 is not needed: SP is replaced by the selected process' saved SP

    // dispatcher_tick returns the selected Process* in IN2. Its saved context is
    // restored into the registers before returning from the interrupt
    asm("MOVE IN2 BAF"); // Use BAF to access the selected process's saved context
    asm("LOADIN BAF SP 11");
    asm("LOADIN BAF CS 13");
    asm("LOADIN BAF DS 14");
    asm("LOADIN BAF IN1 8");
    asm("LOADIN BAF IN2 9");
    asm("LOADIN BAF ACC 10");
    asm("LOADIN BAF BAF 12"); // Restore BAF last: otherwise the record address is lost
    asm("RTI"); // Restores PC from each process's own stack
}

__attribute__((naked))
void syscall_interrupt(void) {
    // Saves caller context before entering the kernel syscall handler
    asm("PUSH IN1"); // syscall argument
    asm("PUSH BAF");
    asm("PUSH CS");
    asm("PUSH DS");
    asm("PUSH ACC"); // syscall number
    // IN2 is not saved because it carries the kernel syscall return value

    // BAF keeps old_sp while loading kernel CS, DS and SP
    asm("MOVE SP BAF");
    load_kernel_context();

    // Moves the syscall arguments to the kernel stack for handle_syscall
    // Arguments are pushed in reverse order, so the saved frame is the third one
    asm("PUSH BAF"); // old_sp (caller_context), recovered in syscall_interrupt_return
    asm("LOADIN BAF IN2 5");
    asm("PUSH IN2"); // syscall number for handle_syscall
    asm("LOADIN BAF IN2 1");
    asm("PUSH IN2"); // syscall argument for handle_syscall

    // Calls handle_syscall and returns through syscall_interrupt_return
    asm("LOADI32 ACC syscall_interrupt_return");
    asm("ADD ACC CS");
    asm("PUSH ACC"); // return address: syscall restoration stub
    asm("LOADI32 ACC handle_syscall");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((naked))
void syscall_interrupt_return(void) {
    // Removes syscall handler arguments and recovers the saved caller frame pointer
    // The frame pointer of the process that made the syscall could only be recovered
    // from handle_syscall's stackframe because BAF still pointed to that process's
    // stackframe when the handle_syscall function call saved it, and
    // load_kernel_context did not overwrite it beforehand
    asm("ADDI SP 2");
    asm("LOADIN SP BAF 1");
    asm("ADDI SP 1");

    // Restores the interrupted syscall caller context. IN2 holds the syscall
    // return value and is copied into ACC after popping the saved registers
    asm("MOVE BAF SP");
    asm("ADDI SP 1");
    asm("POP DS");
    asm("POP CS");
    asm("POP BAF");
    asm("POP IN1");
    asm("MOVE IN2 ACC");
    asm("RTI");
}
