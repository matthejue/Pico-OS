// dependencies: ../../library/unistd/libunistd.reti_blocks ../../library/sys/prctl/libprctl.reti_blocks ../../library/signal/libsignal.reti_blocks

#include "../../library/unistd/unistd.header"
#include "../../library/sys/prctl/prctl.header"
#include "../../library/signal/signal.header"
#include "../../common/stddef.header"

int main(void) {
    if (prctl(PR_SET_PDEATHSIG, 0) == -1) {
        return 1;
    }

    kill(getpid(), SIGSTOP);
    while (true) {
    }
}
