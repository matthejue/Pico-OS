// dependencies: ../../library/unistd/libunistd.reti_blocks ../../library/sys/prctl/libprctl.reti_blocks ../../library/schedule/libschedule.reti_blocks

#include "../../library/unistd/unistd.header"
#include "../../library/sys/prctl/prctl.header"
#include "../../library/schedule/schedule.header"
#include "../../library/signal/signal.header"
#include "../../common/stddef.header"

int main(void) {
    int first_child;
    int second_child;

    if (prctl(PR_SET_PDEATHSIG, SIGKILL) == -1) {
        return -1;
    }

    first_child = load(
        "test/parent_death_signal/worker.bin"
    );
    second_child = load(
        "test/parent_death_signal/worker.bin"
    );
    run(first_child, NULL, NULL);
    run(second_child, NULL, NULL);

    // Gives both endless-loop children a chance to start
    yield();
    return first_child;
}
