// dependencies: ../../library/stdio/libstdio.reti_blocks ../../library/unistd/libunistd.reti_blocks ../../library/sys/wait/libwait.reti_blocks ../../library/signal/libsignal.reti_blocks

#include "../../library/stdio/stdio.header"
#include "../../library/unistd/unistd.header"
#include "../../library/sys/wait/wait.header"
#include "../../library/signal/signal.header"
#include "../../common/stddef.header"

int main(void) {
    int first_child;
    int parent;
    int survivor;
    bool children_terminated;
    bool child_survived;

    parent = load(
        "test/parent_death_signal/terminating_parent.bin"
    );
    run(parent, NULL, NULL);
    first_child = waitpid(parent);
    children_terminated =
        kill(first_child, 0) == -1 &&
        kill(first_child + 1, 0) == -1;
    printf(
        "parent terminated both children: %d\n",
        children_terminated
    );

    parent = load(
        "test/parent_death_signal/undoing_parent.bin"
    );
    run(parent, NULL, NULL);
    survivor = waitpid(parent);
    child_survived = kill(survivor, 0) == 0;
    printf(
        "child disabled parent-death signal: %d\n",
        child_survived
    );
    if (child_survived) {
        kill(survivor, SIGKILL);
    }

    return !(children_terminated && child_survived);
}
