// dependencies: ../../library/unistd/libunistd.reti_blocks ../../library/sys/prctl/libprctl.reti_blocks ../../library/sys/wait/libwait.reti_blocks

#include "../../library/unistd/unistd.header"
#include "../../library/sys/prctl/prctl.header"
#include "../../library/sys/wait/wait.header"
#include "../../library/signal/signal.header"
#include "../../common/stddef.header"

int main(void) {
    int child;

    if (prctl(PR_SET_PDEATHSIG, SIGKILL) == -1) {
        return -1;
    }

    child = load(
        "test/parent_death_signal/undo_worker.bin"
    );
    run(child, NULL, NULL);

    // The child stops itself after disabling its inherited setting
    waitpid(child);
    return child;
}
