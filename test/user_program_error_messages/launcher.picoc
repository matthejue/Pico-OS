// dependencies: ../../library/unistd/libunistd.reti_blocks ../../library/sys/wait/libwait.reti_blocks

#include "../../library/unistd/unistd.header"
#include "../../library/sys/wait/wait.header"
#include "../../common/stddef.header"

void run_program(char *path, char *arguments) {
    int pid = load(path);

    if (pid != 0 && run(pid, arguments, NULL)) {
        waitpid(pid);
    }
}

int main(void) {
    dup2(STDOUT_FILENO, STDERR_FILENO);

    run_program(
        "./user/cat.bin",
        "test/user_program_error_messages/missing.txt"
    );
    run_program("./user/cat.bin", "user");
    run_program("./user/kill.bin", NULL);
    run_program("./user/kill.bin", "999");
    run_program("./user/kill.bin", "SIGKILL 999");
    run_program("./user/kill.bin", "99 999");
    run_program("./user/kill.bin", "SIGKILL");
    run_program("./user/kill.bin", "SIGBOGUS 3");
    run_program("./user/ls.bin", "-x");
    run_program("./user/ls.bin", ". extra");
    return 0;
}
