// dependencies: ../../library/stdio/libstdio.reti_blocks ../../library/unistd/libunistd.reti_blocks ../../library/sys/wait/libwait.reti_blocks ../../library/signal/libsignal.reti_blocks ../../library/schedule/libschedule.reti_blocks

#include "../../library/stdio/stdio.header"
#include "../../library/unistd/unistd.header"
#include "../../library/sys/wait/wait.header"
#include "../../library/signal/signal.header"
#include "../../library/schedule/schedule.header"
#include "../../common/stddef.header"

int run_and_yield(char *path) {
    int pid = load(path);

    run(pid, NULL, NULL);
    yield();
    return pid;
}

int main(void) {
    int non_child;
    int parent;
    int pid;
    int status;

    pid = run_and_yield(
        "test/signals_waitpid/endless.bin"
    );
    kill(pid, SIGKILL);
    printf("SIGKILL status: %d\n", waitpid(pid));

    pid = run_and_yield(
        "test/signals_waitpid/endless.bin"
    );
    kill(pid, SIGINT);
    printf("SIGINT status: %d\n", waitpid(pid));

    pid = run_and_yield(
        "test/signals_waitpid/stop_target.bin"
    );
    kill(pid, SIGTSTP);
    status = waitpid(pid);
    printf("SIGTSTP stopped: %d\n", WIFSTOPPED(status));
    kill(pid, SIGCONT);
    printf("SIGCONT status: %d\n", waitpid(pid));

    pid = run_and_yield(
        "test/signals_waitpid/stop_target.bin"
    );
    kill(pid, SIGSTOP);
    status = waitpid(pid);
    printf("SIGSTOP stopped: %d, status: %d\n",
           WIFSTOPPED(status), status);
    kill(pid, SIGCONT);
    printf("SIGSTOP continued status: %d\n", waitpid(pid));

    pid = run_and_yield(
        "test/signals_waitpid/background_reader.bin"
    );
    status = waitpid(pid);
    printf("SIGTTIN stopped: %d, status: %d\n",
           WIFSTOPPED(status), status);
    kill(pid, SIGCONT);
    status = waitpid(pid);
    printf("SIGTTIN background continue stopped: %d\n",
           status == SIGNAL_TERMINAL_INPUT_STATUS);
    set_foreground_process(pid);
    kill(pid, SIGCONT);
    yield();
    kill(pid, SIGKILL);
    set_foreground_process(0);
    printf("SIGTTIN foreground wait status: %d\n", waitpid(pid));

    pid = load(
        "test/signals_waitpid/background_reader.bin"
    );
    set_foreground_process(pid);
    run(pid, NULL, NULL);
    yield();
    kill(pid, SIGTSTP);
    status = waitpid(pid);
    printf("blocked reader SIGTSTP stopped: %d\n",
           status == SIGNAL_STOPPED_STATUS);
    set_foreground_process(0);
    kill(pid, SIGCONT);
    status = waitpid(pid);
    printf("blocked reader background continue SIGTTIN: %d\n",
           status == SIGNAL_TERMINAL_INPUT_STATUS);
    set_foreground_process(pid);
    kill(pid, SIGCONT);
    yield();
    kill(pid, SIGKILL);
    set_foreground_process(0);
    printf("blocked reader foreground wait status: %d\n", waitpid(pid));

    parent = load(
        "test/signals_waitpid/grandchild_parent.bin"
    );
    run(parent, NULL, NULL);
    non_child = waitpid(parent);
    printf("waitpid rejects non-child: %d\n",
           waitpid(non_child) == -1);
    kill(non_child, SIGKILL);
    return 0;
}
