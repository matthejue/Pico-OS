// dependencies: ../../library/fcntl/libfcntl.reti_blocks ../../library/stdio/libstdio.reti_blocks ../../library/unistd/libunistd.reti_blocks

#include "../../library/fcntl/fcntl.header"
#include "../../library/stdio/stdio.header"
#include "../../library/unistd/unistd.header"

int main(void) {
    int value;
    int character;
    int input;

    input = open("test/stdio_scanf/values.txt", O_RDONLY);
    if (input < 0 || dup2(input, STDIN_FILENO) != STDIN_FILENO) {
        return 1;
    }
    close(input);

    scanf("%d %c", &value, &character);
    printf("read %d %c\n", value, character);
    return 0;
}
