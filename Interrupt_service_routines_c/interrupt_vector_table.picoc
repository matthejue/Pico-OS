#include "interrupt_service_routines.header"

void send_byte_over_uart_interrupt(void);
void send_integer_over_uart_interrupt(void);
void send_string_over_uart_interrupt(void);
void receive_byte_over_uart_interrupt(void);
void receive_integer_over_uart_interrupt(void);
void receive_string_over_uart_interrupt(void);

void handle_send_byte_over_uart_interrupt(int value);
void handle_send_integer_over_uart_interrupt(int value);
void handle_send_string_over_uart_interrupt(char *value);
int handle_receive_byte_over_uart_interrupt(void);
int handle_receive_integer_over_uart_interrupt(void);
char *handle_receive_string_over_uart_interrupt(char *value);

__attribute__((section("interrupt_vector_table")))
void (*interrupt_vector_table[INTERRUPT_VECTOR_COUNT])(void) = {
    send_byte_over_uart_interrupt,
    send_integer_over_uart_interrupt,
    send_string_over_uart_interrupt,
    receive_byte_over_uart_interrupt,
    receive_integer_over_uart_interrupt,
    receive_string_over_uart_interrupt
};

int interrupt_vector_devices[INTERRUPT_VECTOR_COUNT] = {
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_NONE
};

int interrupt_vector_priorities[INTERRUPT_VECTOR_COUNT] = {
    0,
    0,
    0,
    0,
    0,
    0
};

int isr_uart_read_register(int register_index);
void isr_uart_write_register(int register_index, int value);
void isr_uart_wait_until_send_ready(void);
void isr_uart_wait_until_receive_ready(void);
void isr_uart_send_8_bit_packet(int value);
int isr_uart_receive_8_bit_packet(void);
void isr_uart_send_byte_value(int value);
void isr_uart_send_integer_value(int value);
void isr_uart_send_string_value(char *value);
int isr_uart_receive_byte_value(void);
int isr_uart_receive_integer_value(void);
char *isr_uart_receive_string_value(char *value);

__attribute__((section("interrupt_vector_table")))
__attribute__((naked))
void send_byte_over_uart_interrupt(void) {
    asm("SUBI SP 4");
    asm("STOREIN SP DS 1");
    asm("STOREIN SP IN1 2");
    asm("STOREIN SP IN2 3");
    asm("STOREIN SP ACC 4");
    asm("LOADI DS 1048576");
    asm("MULTI DS 1024");
    asm("SUBI SP 1");
    asm("STOREIN SP ACC 1");
    asm("LOADI32 ACC uart_send_interrupt_return");
    asm("ADD ACC CS");
    asm("SUBI SP 1");
    asm("STOREIN SP ACC 1");
    asm("LOADI32 ACC handle_send_byte_over_uart_interrupt");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((section("interrupt_vector_table")))
__attribute__((naked))
void send_integer_over_uart_interrupt(void) {
    asm("SUBI SP 4");
    asm("STOREIN SP DS 1");
    asm("STOREIN SP IN1 2");
    asm("STOREIN SP IN2 3");
    asm("STOREIN SP ACC 4");
    asm("LOADI DS 1048576");
    asm("MULTI DS 1024");
    asm("SUBI SP 1");
    asm("STOREIN SP ACC 1");
    asm("LOADI32 ACC uart_send_interrupt_return");
    asm("ADD ACC CS");
    asm("SUBI SP 1");
    asm("STOREIN SP ACC 1");
    asm("LOADI32 ACC handle_send_integer_over_uart_interrupt");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

