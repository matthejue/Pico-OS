    asm("MOVE ACC PC");
}

__attribute__((section("interrupt_vector_table")))
__attribute__((naked))
void uart_receive_value_interrupt_return(void) {
    asm("MOVE IN2 ACC");
    asm("LOADIN SP DS 1");
    asm("LOADIN SP IN1 2");
    asm("LOADIN SP IN2 3");
    asm("ADDI SP 3");
    asm("RTI");
}

__attribute__((section("interrupt_vector_table")))
__attribute__((naked))
void receive_string_over_uart_interrupt(void) {
    asm("SUBI SP 3");
    asm("STOREIN SP DS 1");
    asm("STOREIN SP IN1 2");
    asm("STOREIN SP IN2 3");
    asm("LOADI DS 1048576");
    asm("MULTI DS 1024");
    asm("SUBI SP 1");
    asm("STOREIN SP ACC 1");
    asm("LOADI32 ACC uart_receive_string_interrupt_return");
    asm("ADD ACC CS");
    asm("SUBI SP 1");
    asm("STOREIN SP ACC 1");
    asm("LOADI32 ACC handle_receive_string_over_uart_interrupt");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

__attribute__((section("interrupt_vector_table")))
__attribute__((naked))
void uart_receive_string_interrupt_return(void) {
    asm("ADDI SP 1");
    asm("MOVE IN2 ACC");
    asm("LOADIN SP DS 1");
    asm("LOADIN SP IN1 2");
    asm("LOADIN SP IN2 3");
    asm("ADDI SP 3");
    asm("RTI");
}

void handle_send_byte_over_uart_interrupt(int value) {
    isr_uart_send_byte_value(value);
}

void handle_send_integer_over_uart_interrupt(int value) {
    isr_uart_send_integer_value(value);
}

void handle_send_string_over_uart_interrupt(char *value) {
    isr_uart_send_string_value(value);
}

int handle_receive_byte_over_uart_interrupt(void) {
    return isr_uart_receive_byte_value();
}

int handle_receive_integer_over_uart_interrupt(void) {
    return isr_uart_receive_integer_value();
}

char *handle_receive_string_over_uart_interrupt(char *value) {
    return isr_uart_receive_string_value(value);
}

int isr_uart_read_register(int register_index) {
    int *uart_register = (int *)(UART_BASE + register_index);
    return *uart_register & 255;
}

void isr_uart_write_register(int register_index, int value) {
    int *uart_register = (int *)(UART_BASE + register_index);
    *uart_register = value & 255;
}

void isr_uart_wait_until_send_ready(void) {
    while ((isr_uart_read_register(UART_STATUS_REGISTER) & UART_SEND_READY_BIT) == 0) {
    }
}

void isr_uart_wait_until_receive_ready(void) {
    while ((isr_uart_read_register(UART_STATUS_REGISTER) & UART_RECEIVE_READY_BIT) == 0) {
    }
}

void isr_uart_send_8_bit_packet(int value) {
    isr_uart_write_register(UART_SEND_REGISTER, value);
    isr_uart_write_register(
        UART_STATUS_REGISTER,
        isr_uart_read_register(UART_STATUS_REGISTER) & -2
    );
    isr_uart_wait_until_send_ready();
}

int isr_uart_receive_8_bit_packet(void) {
    isr_uart_write_register(
        UART_STATUS_REGISTER,
        isr_uart_read_register(UART_STATUS_REGISTER) & -3
    );
    isr_uart_wait_until_receive_ready();
    return isr_uart_read_register(UART_RECEIVE_REGISTER);
}

void isr_uart_send_byte_value(int value) {
    isr_uart_send_8_bit_packet(UART_TYPE_BYTE);
    isr_uart_send_8_bit_packet(value);
}

void isr_uart_send_integer_value(int value) {
    int value_without_sign_bit = value & 2147483647;
    int first_byte = value_without_sign_bit / 16777216;

    if (value < 0) {
        first_byte = first_byte | 128;
    }

    isr_uart_send_8_bit_packet(UART_TYPE_INTEGER);
    isr_uart_send_8_bit_packet(first_byte);
    isr_uart_send_8_bit_packet((value_without_sign_bit / 65536) & 255);
    isr_uart_send_8_bit_packet((value_without_sign_bit / 256) & 255);
    isr_uart_send_8_bit_packet(value_without_sign_bit & 255);
}

void isr_uart_send_string_value(char *value) {
    int index = 0;
    int current;

    isr_uart_send_8_bit_packet(UART_TYPE_STRING);

    current = value[index];
    while (current != 0) {
        isr_uart_send_8_bit_packet(current);
        index = index + 1;
        current = value[index];
    }

    isr_uart_send_8_bit_packet(0);
}

int isr_uart_receive_byte_value(void) {
    isr_uart_receive_8_bit_packet();
    return isr_uart_receive_8_bit_packet();
}

int isr_uart_receive_integer_value(void) {
    isr_uart_receive_8_bit_packet();

    int first_byte = isr_uart_receive_8_bit_packet();
    int value = first_byte;

    if ((value & 128) != 0) {
        value = value | -256;
    }

    value = value * 16777216;
    value = value | (isr_uart_receive_8_bit_packet() * 65536);
    value = value | (isr_uart_receive_8_bit_packet() * 256);
    value = value | isr_uart_receive_8_bit_packet();
    return value;
}

char *isr_uart_receive_string_value(char *value) {
    int index = 0;
    int current;

    isr_uart_receive_8_bit_packet();

    current = isr_uart_receive_8_bit_packet();
    value[index] = current;
    while (current != 0) {
        index = index + 1;
        current = isr_uart_receive_8_bit_packet();
        value[index] = current;
    }

    return value;
}
