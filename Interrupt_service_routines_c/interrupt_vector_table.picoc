}

__attribute__((section("interrupt_vector_table")))
__attribute__((naked))
void uart_send_interrupt_return(void) {
    asm("ADDI SP 1");
    asm("LOADIN SP DS 1");
    asm("LOADIN SP IN1 2");
    asm("LOADIN SP IN2 3");
    asm("LOADIN SP ACC 4");
    asm("ADDI SP 4");
    asm("RTI");
}

__attribute__((section("interrupt_vector_table")))
__attribute__((naked))
void receive_byte_over_uart_interrupt(void) {
    asm("SUBI SP 3");
    asm("STOREIN SP DS 1");
    asm("STOREIN SP IN1 2");
    asm("STOREIN SP IN2 3");
    asm("LOADI DS 1048576");
    asm("MULTI DS 1024");
    asm("LOADI32 ACC uart_receive_value_interrupt_return");
    asm("ADD ACC CS");
    asm("SUBI SP 1");
    asm("STOREIN SP ACC 1");
    asm("LOADI32 ACC handle_receive_byte_over_uart_interrupt");
    asm("ADD ACC CS");
    asm("MOVE ACC PC");
}

