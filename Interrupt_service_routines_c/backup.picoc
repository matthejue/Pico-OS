#include "interrupt_service_routines.header"

void print_integer_over_uart_interrupt();
void print_string_over_uart_interrupt();
void get_user_input_over_uart_interrupt();
void breakpoint_interrupt();
void sleep_interrupt();
void wakeup_interrupt();
void switch_to_scheduler_interrupt();

void (*interrupt_vector_table[INTERRUPT_VECTOR_COUNT])() = {
    print_integer_over_uart_interrupt,
    print_string_over_uart_interrupt,
    get_user_input_over_uart_interrupt,
    breakpoint_interrupt,
    sleep_interrupt,
    wakeup_interrupt,
    switch_to_scheduler_interrupt
};

int interrupt_vector_devices[INTERRUPT_VECTOR_COUNT] = {
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_NONE,
    INTERRUPT_DEVICE_KEYPRESS,
    INTERRUPT_DEVICE_INTTIMER
};

int interrupt_vector_priorities[INTERRUPT_VECTOR_COUNT] = {
    0,
    0,
    0,
    0,
    0,
    2,
    1
};

#include "../core/scheduler.header"
#include "../core/dispatcher.header"

/* Helper declarations: implementations are below the vector-table ISR functions. */

int isr_uart_read_register(int register_index);
void isr_uart_write_register(int register_index, int value);
void isr_uart_wait_until_send_ready();
void isr_uart_wait_until_receive_ready();
void isr_uart_send_8_bit_packet(int value);
int isr_uart_receive_8_bit_packet();
void isr_uart_send_integer_value(int value);
void isr_uart_send_string_value(char *value);
int isr_uart_receive_integer_value();

/* Interrupt service routines: these functions are inserted into the vector table. */

void print_integer_over_uart_interrupt(struct interrupt_context *context) {
    isr_uart_send_integer_value(context->acc);
}

void print_string_over_uart_interrupt(struct interrupt_context *context) {
    isr_uart_send_string_value((char *)context->acc);
}

void get_user_input_over_uart_interrupt(struct interrupt_context *context) {
    context->acc = isr_uart_receive_integer_value();
}

void breakpoint_interrupt(struct interrupt_context *context) {
}

void sleep_interrupt(struct interrupt_context *context) {
    dispatcher_save_context(
        scheduler_current_process(),
        context->stack_pointer,
        context->program_counter,
        context->status_word,
        context->acc,
        context->in1,
        context->in2,
        context->ds
    );

    scheduler_block_current_process((struct wait_queue *)context->acc);
}

void wakeup_interrupt(struct interrupt_context *context) {
    scheduler_wake_one((struct wait_queue *)context->acc);
}

void switch_to_scheduler_interrupt(struct interrupt_context *context) {
    dispatcher_save_context(
        scheduler_current_process(),
        context->stack_pointer,
        context->program_counter,
        context->status_word,
        context->acc,
        context->in1,
        context->in2,
        context->ds
    );

    scheduler_on_timer_interrupt();
}

/* Helper functions: these are not inserted into the interrupt vector table. */

int isr_uart_read_register(int register_index) {
    int *uart_register = (int *)(UART_BASE + register_index);
    return *uart_register & 255;
}

void isr_uart_write_register(int register_index, int value) {
    int *uart_register = (int *)(UART_BASE + register_index);
    *uart_register = value & 255;
}

void isr_uart_wait_until_send_ready() {
    while ((isr_uart_read_register(UART_STATUS_REGISTER) & UART_SEND_READY_BIT) == 0) {
    }
}

void isr_uart_wait_until_receive_ready() {
    while ((isr_uart_read_register(UART_STATUS_REGISTER) & UART_RECEIVE_READY_BIT) == 0) {
    }
}

void isr_uart_send_8_bit_packet(int value) {
    isr_uart_write_register(UART_SEND_REGISTER, value);
    isr_uart_write_register(
        UART_STATUS_REGISTER,
        isr_uart_read_register(UART_STATUS_REGISTER) & -2
    );
    isr_uart_wait_until_send_ready();
}

int isr_uart_receive_8_bit_packet() {
    isr_uart_write_register(
        UART_STATUS_REGISTER,
        isr_uart_read_register(UART_STATUS_REGISTER) & -3
    );
    isr_uart_wait_until_receive_ready();
    return isr_uart_read_register(UART_RECEIVE_REGISTER);
}

void isr_uart_send_integer_value(int value) {
    int value_without_sign_bit = value & 2147483647;
    int first_byte = value_without_sign_bit / 16777216;

    if (value < 0) {
        first_byte = first_byte | 128;
    }

    isr_uart_send_8_bit_packet(UART_TYPE_INTEGER);
    isr_uart_send_8_bit_packet(first_byte);
    isr_uart_send_8_bit_packet((value_without_sign_bit / 65536) & 255);
    isr_uart_send_8_bit_packet((value_without_sign_bit / 256) & 255);
    isr_uart_send_8_bit_packet(value_without_sign_bit & 255);
}

void isr_uart_send_string_value(char *value) {
    int index = 0;
    int current;

    isr_uart_send_8_bit_packet(UART_TYPE_STRING);

    current = value[index];
    while (current != 0) {
        isr_uart_send_8_bit_packet(current);
        index = index + 1;
        current = value[index];
    }

    isr_uart_send_8_bit_packet(0);
}

int isr_uart_receive_integer_value() {
    int first_byte = isr_uart_receive_8_bit_packet();
    int value = first_byte;

    if ((value & 128) != 0) {
        value = value | -256;
    }

    value = value * 16777216;
    value = value | (isr_uart_receive_8_bit_packet() * 65536);
    value = value | (isr_uart_receive_8_bit_packet() * 256);
    value = value | isr_uart_receive_8_bit_packet();
    return value;
}
