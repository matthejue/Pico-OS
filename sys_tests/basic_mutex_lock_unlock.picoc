// in:
// expected:42 84
// dependencies: ../lib/mutex/mutex.picoc ../lib/unistd/unistd.picoc ../lib/stdio/stdio.picoc

#include "../lib/stdio/stdio.header"
#include "../lib/mutex/mutex.header"


int main() {
    struct mutex m;

    mutex_init(&m);

    mutex_lock(&m);
    printf("%d ", 42);
    mutex_unlock(&m);

    m.lock = 1;
    mutex_lock(&m);
    printf("%d ", 84);
    mutex_unlock(&m);

    return 0;
}
