// in:
// expected:1 one one two other 1 other three 1 1
// dependencies: ../lib/stdlib/libstdlib.picoc ../lib/stdio/libstdio.picoc

#include "../lib/stdlib/stdlib.header"
#include "../lib/stdio/stdio.header"

void initialize_environment(char **environment);

int main() {
    init_process_heap();
    initialize_environment(NULL);

    printf("%d ", getenv("VALUE") == NULL);

    setenv("VALUE", "one", true);
    printf("%s ", getenv("VALUE"));

    setenv("VALUE", "ignored", false);
    printf("%s ", getenv("VALUE"));

    setenv("VALUE", "two", true);
    setenv("OTHER", "other", true);
    printf("%s %s ", getenv("VALUE"), getenv("OTHER"));

    unsetenv("VALUE");
    printf("%d %s ", getenv("VALUE") == NULL, getenv("OTHER"));

    putenv("VALUE=three");
    printf("%s ", getenv("VALUE"));

    clearenv();
    printf("%d %d", getenv("VALUE") == NULL, getenv("OTHER") == NULL);

    return 0;
}
