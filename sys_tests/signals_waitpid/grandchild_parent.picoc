// dependencies: ../../lib/unistd/libunistd.picoc ../../lib/sys/prctl/libprctl.picoc ../../lib/schedule/libschedule.picoc

#include "../../lib/unistd/unistd.header"
#include "../../lib/sys/prctl/prctl.header"
#include "../../lib/schedule/schedule.header"
#include "../../common/stddef.header"

int main(void) {
    int child;

    prctl(PR_SET_PDEATHSIG, 0);
    child = load("sys_tests/signals_waitpid/endless.bin");
    run(child, NULL, NULL);
    yield();
    return child;
}
