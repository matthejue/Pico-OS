// dependencies: ../../lib/stdio/libstdio.picoc ../../lib/unistd/libunistd.picoc ../../lib/sys/wait/libwait.picoc ../../lib/signal/libsignal.picoc ../../lib/schedule/libschedule.picoc

#include "../../lib/stdio/stdio.header"
#include "../../lib/unistd/unistd.header"
#include "../../lib/sys/wait/wait.header"
#include "../../lib/signal/signal.header"
#include "../../lib/schedule/schedule.header"
#include "../../common/stddef.header"

int sigchld_count = 0;

void child_exited(int signal_number) {
    if (signal_number == SIGCHLD) {
        sigchld_count = sigchld_count + 1;
    }
}

int run_and_yield(char *path) {
    int pid = load(path);

    run(pid, NULL, NULL);
    yield();
    return pid;
}

int main(void) {
    int non_child;
    int parent;
    int pid;
    int status;

    pid = run_and_yield(
        "sys_tests/signals_waitpid/sigterm_target.bin"
    );
    kill(pid, SIGTERM);
    status = waitpid(pid);
    printf("SIGTERM handler status: %d\n", status);

    if (signal(SIGCHLD, child_exited) == SIG_ERR) {
        return 1;
    }

    pid = run_and_yield(
        "sys_tests/signals_waitpid/sigkill_target.bin"
    );
    kill(pid, SIGTERM);
    printf("SIGKILL status: %d\n", waitpid(pid));
    yield();
    printf("SIGCHLD delivered: %d\n", sigchld_count);

    pid = run_and_yield(
        "sys_tests/signals_waitpid/stop_target.bin"
    );
    kill(pid, SIGTSTP);
    status = waitpid(pid);
    printf("SIGTSTP stopped: %d\n", WIFSTOPPED(status));
    kill(pid, SIGCONT);
    printf("SIGCONT status: %d\n", waitpid(pid));

    parent = load(
        "sys_tests/signals_waitpid/grandchild_parent.bin"
    );
    run(parent, NULL, NULL);
    non_child = waitpid(parent);
    printf("waitpid rejects non-child: %d\n",
           waitpid(non_child) == -1);
    kill(non_child, SIGKILL);
    return 0;
}
