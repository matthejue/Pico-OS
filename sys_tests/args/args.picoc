// dependencies: ../../lib/stdio/libstdio.picoc ../../lib/args/libargs.picoc

#include "../../lib/stdio/stdio.header"
#include "../../lib/args/args.header"

int main(int argc, char **argv) {
    int index = 0;

    printf("argc=%d\n", argc);
    while (index < argc) {
        printf("arg%d=%s\n", index, argv[index]);
        index = index + 1;
    }

    printf("helper=%d\n", args_argc());
    printf("helper1=%s\n", args_get(1));
    printf("number=%d\n", atoi(args_get(1)));
    return 0;
}
