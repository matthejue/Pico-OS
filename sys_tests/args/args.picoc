// dependencies: ../../lib/stdio/libstdio.picoc ../../lib/unistd/libunistd.picoc

#include "../../lib/stdio/stdio.header"
#include "../../lib/stdlib/stdlib.header"
#include "../../lib/unistd/unistd.header"

int main(int argc, char **argv) {
    int index = 0;

    printf("argc=%d\n", argc);
    // argc could also be used as the loop bound
    while (argv[index] != NULL) {
        printf("arg%d=%s\n", index, argv[index]);
        index = index + 1;
    }

    if (argv[argc] == NULL) {
        printf("argv_end=NULL\n");
    }
    printf("number=%d\n", atoi(argv[1]));
    return getpid();
}
