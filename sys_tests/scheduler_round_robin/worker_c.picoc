// dependencies: ../../lib/stdio/libstdio.picoc ../../lib/schedule/libschedule.picoc

#include "../../lib/stdio/stdio.header"
#include "../../lib/schedule/schedule.header"

int main(void) {
    int count = 0;

    while (count < 5) {
        printf("C");
        yield();
        count = count + 1;
    }

    return 0;
}
