// dependencies: ../common/user_command.reti_blocks

#include "../library/unistd/unistd.header"
#include "../library/fcntl/fcntl.header"
#include "../library/sys/wait/wait.header"
#include "../library/sys/prctl/prctl.header"
#include "../library/signal/signal.header"
#include "../library/stdlib/stdlib.header"
#include "../library/string/string.header"
#include "../common/decimal.header"
#include "../common/loading_bar.header"
#include "../common/user_command.header"

#define SHELL_COMMAND_BUFFER_CAPACITY 80
#define SHELL_PIPE_COMMAND_CAPACITY 160
#define SHELL_COMMAND_HISTORY_CAPACITY 8
#define SHELL_CTRL_U 21
#define SHELL_CTRL_W 23
#define SHELL_EXECUTABLE_PATH_CAPACITY 160
#define SHELL_SAVED_STDIN_FILENO 3
#define SHELL_SAVED_STDOUT_FILENO 5
#define SHELL_SAVED_STDERR_FILENO 6
#define SHELL_TEST_SAVED_STDOUT_FILENO 4
#define SHELL_TEST_SAVED_STDERR_FILENO 7
#define SHELL_PRIVATE_FILE_DESCRIPTOR_START 3
#define SHELL_FILE_DESCRIPTOR_COUNT 8
// 10 characters are needed for 2147483647, plus one character for the terminating '\0'
#define SHELL_SPECIAL_PARAMETER_BUFFER_CAPACITY 11

int last_command_exit_status = 0;
int last_background_process_id = 0;
char **initial_shell_environment = NULL;
char initial_shell_working_directory[PATH_MAX];
char shell_system_working_directory[PATH_MAX];
char shell_executable_path[PATH_MAX];
char shell_pipe_left_command[SHELL_PIPE_COMMAND_CAPACITY];
char shell_pipe_right_command[SHELL_PIPE_COMMAND_CAPACITY];
char shell_pipe_path[SHELL_COMMAND_BUFFER_CAPACITY];
// Keeps bounded command storage outside the process stack
char command_history[
    SHELL_COMMAND_HISTORY_CAPACITY
][SHELL_COMMAND_BUFFER_CAPACITY];
char command_history_draft[SHELL_COMMAND_BUFFER_CAPACITY];
// Keeps the complete erase sequence outside the process stack
char shell_line_erase_sequence[(SHELL_COMMAND_BUFFER_CAPACITY - 1) * 3];
int command_history_start = 0;
int command_history_count = 0;

bool eval(char *command);

void shell_write_character(char character) {
    write(STDOUT_FILENO, &character, 1);
}

void shell_write(int file_descriptor, char *text) {
    int length = 0;

    while (text[length] != '\0') {
        length = length + 1;
    }
    write(file_descriptor, text, length);
}

void shell_write_string(char *text) {
    shell_write(STDOUT_FILENO, text);
}

void shell_write_error_string(char *text) {
    shell_write(STDERR_FILENO, text);
}

void shell_usage(int file_descriptor) {
    command_write(file_descriptor, "Usage: shell.bin\n");
    command_write(
        file_descriptor,
        "Execute commands interactively or from redirected stdin.\n"
    );
}

void shell_write_decimal(int value) {
    char buffer[12];
    int length = append_decimal(buffer, value);

    write(STDOUT_FILENO, buffer, length);
}

void report_process_created(int pid) {
    shell_write_string("process with pid ");
    shell_write_decimal(pid);
    shell_write_string(" created\n");
}

void report_foreground_process_status(int pid, int status) {
    char *signal_name = NULL;
    char *action = NULL;

    if (status == SIGNAL_STOP_STATUS) {
        action = "stopped";
        signal_name = "SIGSTOP";
    } else if (status == SIGNAL_STOPPED_STATUS) {
        action = "stopped";
        signal_name = "SIGTSTP";
    } else if (status == SIGNAL_TERMINAL_INPUT_STATUS) {
        action = "stopped";
        signal_name = "SIGTTIN";
    } else if (status == SIGNAL_INTERRUPTED_STATUS) {
        action = "terminated";
        signal_name = "SIGINT";
    } else if (status == SIGNAL_KILLED_STATUS) {
        action = "terminated";
        signal_name = "SIGKILL";
    }

    if (signal_name != NULL) {
        shell_write_character('\n');
        shell_write_string("process with pid ");
        shell_write_decimal(pid);
        shell_write_character(' ');
        shell_write_string(action);
        shell_write_string(" by signal ");
        shell_write_string(signal_name);
        shell_write_character('\n');
    }
}

int erase_shell_line_suffix(int length, int retained_length) {
    int erased_length = length - retained_length;
    int index = 0;

    while (index < erased_length) {
        shell_line_erase_sequence[index] = '\b';
        shell_line_erase_sequence[erased_length + index] = ' ';
        shell_line_erase_sequence[erased_length * 2 + index] = '\b';
        index = index + 1;
    }
    if (erased_length > 0) {
        write(STDOUT_FILENO, shell_line_erase_sequence, erased_length * 3);
    }
    return retained_length;
}

int command_history_index(int position) {
    return (
        command_history_start + command_history_count - position
    ) % SHELL_COMMAND_HISTORY_CAPACITY;
}

void remember_shell_command(char *command) {
    int index;

    if (command_history_count > 0 && strcmp(
        command_history[command_history_index(1)],
        command
    ) == 0) {
        return;
    }

    if (command_history_count < SHELL_COMMAND_HISTORY_CAPACITY) {
        index = (
            command_history_start + command_history_count
        ) % SHELL_COMMAND_HISTORY_CAPACITY;
        command_history_count = command_history_count + 1;
    } else {
        index = command_history_start;
        command_history_start = (
            command_history_start + 1
        ) % SHELL_COMMAND_HISTORY_CAPACITY;
    }
    strcpy(command_history[index], command);
}

int replace_shell_line(
    char *buffer,
    int length,
    char *replacement,
    int capacity
) {
    int replacement_length = 0;

    length = erase_shell_line_suffix(length, 0);
    while (
        replacement[replacement_length] != '\0' &&
        replacement_length < capacity - 1
    ) {
        buffer[replacement_length] = replacement[replacement_length];
        replacement_length = replacement_length + 1;
    }
    buffer[replacement_length] = '\0';
    if (replacement_length > 0) {
        write(STDOUT_FILENO, buffer, replacement_length);
    }
    return replacement_length;
}

int navigate_command_history(
    char *buffer,
    int length,
    int capacity,
    int *history_position,
    int direction
) {
    int index;
    int new_position = *history_position + direction;
    char *replacement;

    if (new_position < 0 || new_position > command_history_count) {
        return length;
    }
    if (*history_position == 0 && direction == 1) {
        buffer[length] = '\0';
        strcpy(command_history_draft, buffer);
    }
    *history_position = new_position;
    if (*history_position == 0) {
        replacement = command_history_draft;
    } else {
        index = command_history_index(*history_position);
        replacement = command_history[index];
    }
    return replace_shell_line(
        buffer,
        length,
        replacement,
        capacity
    );
}

int append_shell_line_character(
    char *buffer,
    int length,
    int capacity,
    char character
) {
    if (length < capacity - 1) {
        buffer[length] = character;
        shell_write_character(character);
        return length + 1;
    }
    return length;
}

bool shell_reset(void) {
    int file_descriptor = SHELL_PRIVATE_FILE_DESCRIPTOR_START;

    set_foreground_process(0);
    reset_processes();
    while (file_descriptor < SHELL_FILE_DESCRIPTOR_COUNT) {
        close(file_descriptor);
        file_descriptor = file_descriptor + 1;
    }
    last_command_exit_status = 0;
    last_background_process_id = 0;
    return initial_shell_environment != NULL &&
        restore_environment(initial_shell_environment) == 0 &&
        chdir(initial_shell_working_directory) == 0;
}

bool is_line_whitespace(char value) {
    return value == ' ' || value == '\t';
}

int read_line(char *buffer, int capacity) {
    int length = 0;
    int history_position = 0;
    int escape_sequence_state = 0;
    char character;
    int read_result;
    int retained_length;
    bool complete = false;
    bool process_character;

    shell_write_string("PicoOS> ");
    while (!complete) {
        read_result = read(STDIN_FILENO, &character, 1);
        if (read_result == 1) {
            process_character = true;
            if (escape_sequence_state == 1) {
                if (character == '[' || character == 'O') {
                    escape_sequence_state = 2;
                    process_character = false;
                } else {
                    escape_sequence_state = 0;
                }
            } else if (escape_sequence_state == 2) {
                escape_sequence_state = 0;
                if (character == 'A') {
                    length = navigate_command_history(
                        buffer,
                        length,
                        capacity,
                        &history_position,
                        1
                    );
                    process_character = false;
                } else if (character == 'B') {
                    length = navigate_command_history(
                        buffer,
                        length,
                        capacity,
                        &history_position,
                        -1
                    );
                    process_character = false;
                } else if (character == 'C' || character == 'D') {
                    process_character = false;
                } else {
                    process_character = false;
                }
            } else if (character == 27) {
                escape_sequence_state = 1;
                process_character = false;
            }

            if (process_character) {
                if (character == '\n' || character == '\r') {
                    shell_write_character('\n');
                    complete = true;
                } else if (character == '\b' || character == 127) {
                    if (length > 0) {
                        length = erase_shell_line_suffix(
                            length,
                            length - 1
                        );
                    }
                } else if (character == SHELL_CTRL_U) {
                    length = erase_shell_line_suffix(length, 0);
                } else if (character == SHELL_CTRL_W) {
                    retained_length = length;
                    while (
                        retained_length > 0 &&
                        is_line_whitespace(
                            buffer[retained_length - 1]
                        )
                    ) {
                        retained_length = retained_length - 1;
                    }
                    while (
                        retained_length > 0 &&
                        !is_line_whitespace(
                            buffer[retained_length - 1]
                        )
                    ) {
                        retained_length = retained_length - 1;
                    }
                    length = erase_shell_line_suffix(
                        length,
                        retained_length
                    );
                } else if (
                    character == '\t' ||
                    character >= ' '
                ) {
                    if (character == '\t') {
                        character = ' ';
                    }
                    length = append_shell_line_character(
                        buffer,
                        length,
                        capacity,
                        character
                    );
                }
            }
        } else if (length == 0) {
            return -1;
        } else {
            complete = true;
        }
    }

    buffer[length] = '\0';
    return length;
}

// Reusing atoi would not make much sense: parses an unsigned digit prefix,
// while atoi handles signed numbers
int parse_process_id(char *value) {
    int process_id = 0;
    int index = 0;

    while (value[index] >= '0' && value[index] <= '9') {
        int digit = value[index] - '0';
        process_id = process_id * 10 + digit;
        index++;
    }

    // An empty string or a string starting with a non-digit produces 0.
    // Overflow is not checked because process IDs are expected to be small.
    return process_id;
}

char *command_arguments(char *command) {
    int index = 0;

    // Finds the end of the command name:
    // "print   hello world"
    //       ^ index == 5
    while (command[index] != '\0' &&
           !is_line_whitespace(command[index])) {
        index++;
    }

    // Terminates the command name and skips separating whitespace:
    // "print\0\0\0hello world"
    //             ^ index == 8
    while (is_line_whitespace(command[index])) {
        command[index] = '\0';
        index++;
    }

    // Returns null when the command has no arguments
    if (command[index] == '\0') {
        return NULL;
    }

    // Returns the beginning of the argument string
    return command + index;
}

bool is_environment_name_start(char value) {
    return (value >= 'a' && value <= 'z') ||
           (value >= 'A' && value <= 'Z') ||
           value == '_';
}

bool is_environment_name_character(char value) {
    return is_environment_name_start(value) ||
           (value >= '0' && value <= '9');
}

char *expand_variables(char *arguments, char *result, int capacity) {
    char special_parameter[SHELL_SPECIAL_PARAMETER_BUFFER_CAPACITY];
    int argument_index = 0;
    int result_index = 0;
    int name_start;
    int name_end;
    int special_parameter_index;
    int special_parameter_length;
    int special_parameter_value;
    int value_index;
    char saved_character;
    char *value;

    // Returns early when there are no arguments to expand
    if (arguments == NULL) {
        return NULL;
    }

    // Copies arguments while reserving one result position for the terminating '\0'
    while (arguments[argument_index] != '\0' &&
           result_index < capacity - 1) {
        // Replaces special shell parameters with their decimal values
        if (strncmp(arguments + argument_index, "$?", 2) == 0 ||
            strncmp(arguments + argument_index, "$!", 2) == 0) {
            if (arguments[argument_index + 1] == '?') {
                special_parameter_value = last_command_exit_status;
            } else {
                special_parameter_value = last_background_process_id;
            }
            special_parameter_length = append_decimal(
                special_parameter,
                special_parameter_value
            );
            special_parameter_index = 0;
            while (special_parameter_index < special_parameter_length &&
                   result_index < capacity - 1) {
                result[result_index] =
                    special_parameter[special_parameter_index];
                result_index++;
                special_parameter_index++;
            }

            // Advances past both characters of the expanded parameter
            argument_index = argument_index + 2;
        } else if (arguments[argument_index] == '$' &&
                   is_environment_name_start(
                       arguments[argument_index + 1])) {
            name_start = argument_index + 1;
            name_end = name_start;
            while (is_environment_name_character(arguments[name_end])) {
                name_end = name_end + 1;
            }

            saved_character = arguments[name_end];
            arguments[name_end] = '\0';
            value = getenv(arguments + name_start);
            arguments[name_end] = saved_character;

            value_index = 0;
            while (value != NULL &&
                   value[value_index] != '\0' &&
                   result_index < capacity - 1) {
                result[result_index] = value[value_index];
                result_index = result_index + 1;
                value_index = value_index + 1;
            }
            argument_index = name_end;
        } else {
            // Copies any other character unchanged and advances both indices
            result[result_index] = arguments[argument_index];
            result_index++;
            argument_index++;
        }
    }

    // Terminates the possibly truncated result
    result[result_index] = '\0';
    return result;
}

int export_environment_variable(char *assignment) {
    char expanded_assignment[SHELL_COMMAND_BUFFER_CAPACITY];
    int separator = 0;

    expand_variables(
        assignment,
        expanded_assignment,
        SHELL_COMMAND_BUFFER_CAPACITY
    );

    while (expanded_assignment[separator] != '\0' &&
           expanded_assignment[separator] != '=') {
        separator = separator + 1;
    }
    if (expanded_assignment[separator] != '=') {
        return 1;
    }

    expanded_assignment[separator] = '\0';
    if (setenv(
        expanded_assignment,
        expanded_assignment + separator + 1,
        true
    ) != 0) {
        return -1;
    }
    return 0;
}

char *skip_line_whitespace(char *value) {
    while (is_line_whitespace(*value)) {
        value = value + 1;
    }
    return value;
}

bool command_matches(char *command, char *name) {
    int name_length = strlen(name);

    return strncmp(command, name, name_length) == 0 &&
        (command[name_length] == '\0' ||
         is_line_whitespace(command[name_length]));
}

bool command_contains_path(char *command) {
    int index = 0;

    while (command[index] != '\0') {
        if (command[index] == '/') {
            return true;
        }
        index = index + 1;
    }
    return false;
}

char *command_operand(char *command, char *name) {
    char *operand = skip_line_whitespace(command + strlen(name));

    if (*operand == '\0') {
        return NULL;
    }
    return operand;
}

int single_command_operand(
    char *command,
    char *name,
    char **operand
) {
    char *end;

    *operand = command_operand(command, name);
    if (*operand == NULL) {
        return 0;
    }
    end = *operand;
    while (*end != '\0' && !is_line_whitespace(*end)) {
        end = end + 1;
    }
    if (*end == '\0') {
        return 1;
    }
    *end = '\0';
    end = skip_line_whitespace(end + 1);
    if (*end == '\0') {
        return 1;
    }
    return -1;
}

bool quotes_are_balanced(char *command) {
    int index = 0;
    char quote = '\0';

    while (command[index] != '\0') {
        if (quote == '\0' &&
            (command[index] == '"' || command[index] == '\'')) {
            quote = command[index];
        } else if (command[index] == quote) {
            quote = '\0';
        }
        index = index + 1;
    }
    return quote == '\0';
}

int find_pipeline_operator(char *command) {
    int index = 0;
    int pipeline = -1;
    char quote = '\0';

    while (command[index] != '\0') {
        if (quote == '\0' &&
            (command[index] == '"' || command[index] == '\'')) {
            quote = command[index];
        } else if (command[index] == quote) {
            quote = '\0';
        } else if (quote == '\0' && command[index] == '|') {
            if (pipeline != -1) {
                return -2;
            }
            pipeline = index;
        }
        index = index + 1;
    }
    return pipeline;
}

int find_output_redirection(char *command) {
    int index = 0;
    char quote = '\0';

    while (command[index] != '\0') {
        if (quote == '\0' &&
            (command[index] == '"' || command[index] == '\'')) {
            quote = command[index];
        } else if (command[index] == quote) {
            quote = '\0';
        } else if (quote == '\0' && command[index] == '>' &&
                   index > 0 &&
                   (is_line_whitespace(command[index - 1]) ||
                    command[index - 1] == '2')) {
            if (command[index - 1] == '2') {
                return index - 1;
            }
            return index;
        }
        index = index + 1;
    }
    return index;
}

bool insert_redirection(
    char *command,
    char *redirection,
    char *path,
    int position,
    char *result
) {
    int command_length = strlen(command);
    int redirection_length = strlen(redirection);
    int path_length = strlen(path);
    int suffix_length = command_length - position;
    int index = 0;
    int result_index = 0;

    if (command_length + redirection_length + path_length + 2 >=
        SHELL_PIPE_COMMAND_CAPACITY) {
        return false;
    }
    while (index < position) {
        result[result_index] = command[index];
        index = index + 1;
        result_index = result_index + 1;
    }
    result[result_index] = ' ';
    result_index = result_index + 1;
    index = 0;
    while (index < redirection_length) {
        result[result_index] = redirection[index];
        index = index + 1;
        result_index = result_index + 1;
    }
    result[result_index] = ' ';
    result_index = result_index + 1;
    index = 0;
    while (index < path_length) {
        result[result_index] = path[index];
        index = index + 1;
        result_index = result_index + 1;
    }
    if (suffix_length > 0) {
        result[result_index] = ' ';
        result_index = result_index + 1;
        index = position;
        while (index < command_length) {
            result[result_index] = command[index];
            index = index + 1;
            result_index = result_index + 1;
        }
    }
    result[result_index] = '\0';
    return true;
}

void build_shell_pipe_path(void) {
    int length;

    strcpy(shell_pipe_path, ".picoos-pipe-");
    length = strlen(shell_pipe_path);
    length = length + append_decimal(shell_pipe_path + length, getpid());
    strcpy(shell_pipe_path + length, ".tmp");
}

bool run_pipeline(char *command, int pipeline) {
    char *right_command;
    int left_end = pipeline;
    bool evaluating;

    while (left_end > 0 &&
           is_line_whitespace(command[left_end - 1])) {
        left_end = left_end - 1;
    }
    command[left_end] = '\0';
    right_command = skip_line_whitespace(command + pipeline + 1);
    if (left_end == 0 || *right_command == '\0') {
        shell_write_error_string("error: invalid pipeline\n");
        last_command_exit_status = 1;
        return true;
    }

    build_shell_pipe_path();
    if (!insert_redirection(
            command,
            ">",
            shell_pipe_path,
            strlen(command),
            shell_pipe_left_command
        ) || !insert_redirection(
            right_command,
            "<",
            shell_pipe_path,
            find_output_redirection(right_command),
            shell_pipe_right_command
        )) {
        shell_write_error_string("error: pipeline is too long\n");
        last_command_exit_status = 1;
        return true;
    }

    eval(shell_pipe_left_command);
    evaluating = eval(shell_pipe_right_command);
    unlink(shell_pipe_path);
    return evaluating;
}

bool strip_background_operator(char *command) {
    int end = strlen(command);

    // Skips trailing whitespace and leaves end after the last non-whitespace character
    while (end > 0 && is_line_whitespace(command[end - 1])) {
        end--;
    }

    // Leaves commands without '&' unchanged, reports there's no '&', and avoids command[-1]
    if (end == 0 || command[end - 1] != '&') {
        return false;
    }

    // Moves before the background operator
    end--;

    // Skips whitespace before the background operator and leaves end at the first trailing whitespace
    while (end > 0 && is_line_whitespace(command[end - 1])) {
        end--;
    }

    // Terminates the command before the removed operator
    command[end] = '\0';

    // Reports a trailing '&'
    return true;
}

bool redirection_starts_at(
    char *command,
    int index,
    int file_descriptor
) {
    if (index == 0 || !is_line_whitespace(command[index - 1])) {
        return false;
    }
    if (file_descriptor == STDIN_FILENO) {
        return command[index] == '<';
    }
    if (file_descriptor == STDOUT_FILENO) {
        return command[index] == '>';
    }
    return command[index] == '2' && command[index + 1] == '>';
}

int strip_redirection(
    char *command,
    int file_descriptor,
    char **path
) {
    bool append;
    int command_end;
    int index = 0;
    int operator_end;
    int path_end;
    int path_start;
    int redirect = -1;

    while (command[index] != '\0' && redirect == -1) {
        if (redirection_starts_at(command, index, file_descriptor)) {
            redirect = index;
        } else {
            index = index + 1;
        }
    }
    if (redirect == -1) {
        *path = NULL;
        return 0;
    }

    if (file_descriptor == STDERR_FILENO) {
        operator_end = redirect + 2;
    } else {
        operator_end = redirect + 1;
    }
    append = file_descriptor != STDIN_FILENO &&
        command[operator_end] == '>';
    path_start = operator_end;
    if (append) {
        path_start = path_start + 1;
    }
    while (is_line_whitespace(command[path_start])) {
        path_start = path_start + 1;
    }
    if (command[path_start] == '\0') {
        return -1;
    }

    path_end = path_start;
    while (command[path_end] != '\0' &&
           !is_line_whitespace(command[path_end])) {
        if (command[path_end] == '<' || command[path_end] == '>') {
            return -1;
        }
        path_end = path_end + 1;
    }
    index = path_end;
    while (is_line_whitespace(command[index])) {
        index = index + 1;
    }
    if (command[index] != '\0') {
        return -1;
    }
    command[path_end] = '\0';

    command_end = redirect;
    while (command_end > 0 &&
           is_line_whitespace(command[command_end - 1])) {
        command_end = command_end - 1;
    }
    if (command_end == 0) {
        return -1;
    }
    command[command_end] = '\0';
    *path = command + path_start;
    if (append) {
        return 2;
    }
    return 1;
}

int strip_command_redirections(
    char *command,
    char **stdin_path,
    char **stdout_path,
    bool *append_stdout,
    char **stderr_path,
    bool *append_stderr
) {
    int status = strip_redirection(
        command,
        STDERR_FILENO,
        stderr_path
    );

    if (status < 0) {
        return STDERR_FILENO;
    }
    *append_stderr = status == 2;
    status = strip_redirection(command, STDOUT_FILENO, stdout_path);
    if (status < 0) {
        return STDOUT_FILENO;
    }
    *append_stdout = status == 2;
    status = strip_redirection(command, STDIN_FILENO, stdin_path);
    if (status < 0) {
        return STDIN_FILENO;
    }
    return -1;
}

void report_invalid_redirection(int file_descriptor) {
    if (file_descriptor == STDIN_FILENO) {
        shell_write_error_string("error: invalid stdin redirection\n");
    } else if (file_descriptor == STDOUT_FILENO) {
        shell_write_error_string("error: invalid stdout redirection\n");
    } else {
        shell_write_error_string("error: invalid stderr redirection\n");
    }
}

void restore_standard_descriptors(
    bool stdin_redirected,
    bool stdout_redirected,
    bool stderr_redirected
) {
    if (stdin_redirected) {
        dup2(SHELL_SAVED_STDIN_FILENO, STDIN_FILENO);
        close(SHELL_SAVED_STDIN_FILENO);
    }
    if (stdout_redirected) {
        dup2(SHELL_SAVED_STDOUT_FILENO, STDOUT_FILENO);
        close(SHELL_SAVED_STDOUT_FILENO);
    }
    if (stderr_redirected) {
        dup2(SHELL_SAVED_STDERR_FILENO, STDERR_FILENO);
        close(SHELL_SAVED_STDERR_FILENO);
    }
}

bool redirect_standard_input(char *path) {
    int file_descriptor;

    if (dup2(STDIN_FILENO, SHELL_SAVED_STDIN_FILENO) < 0) {
        return false;
    }
    close(STDIN_FILENO);
    file_descriptor = open(path, O_RDONLY);
    if (file_descriptor != STDIN_FILENO) {
        if (file_descriptor >= 0) {
            close(file_descriptor);
        }
        restore_standard_descriptors(true, false, false);
        return false;
    }
    return true;
}

bool redirect_output(
    int target_file_descriptor,
    int saved_file_descriptor,
    char *path,
    bool append
) {
    int opened_file_descriptor;
    int flags = O_WRONLY | O_CREAT;

    if (append) {
        flags = flags | O_APPEND;
    } else {
        flags = flags | O_TRUNC;
    }
    opened_file_descriptor = open(path, flags);
    if (opened_file_descriptor < 0) {
        return false;
    }
    if (dup2(target_file_descriptor, saved_file_descriptor) < 0) {
        close(opened_file_descriptor);
        return false;
    }
    if (dup2(opened_file_descriptor, target_file_descriptor) < 0) {
        close(opened_file_descriptor);
        close(saved_file_descriptor);
        return false;
    }
    close(opened_file_descriptor);
    return true;
}

bool run_process(
    int pid,
    char *arguments,
    bool background,
    char *stdin_path,
    char *stdout_path,
    bool append_stdout,
    char *stderr_path,
    bool append_stderr
) {
    char expanded_arguments[SHELL_COMMAND_BUFFER_CAPACITY];
    bool stdin_redirected = false;
    bool stdout_redirected = false;
    bool stderr_redirected = false;
    bool started;

    if (stdout_path != NULL) {
        if (!redirect_output(
                STDOUT_FILENO,
                SHELL_SAVED_STDOUT_FILENO,
                stdout_path,
                append_stdout
            )) {
            shell_write_error_string("error: could not redirect stdout\n");
            return false;
        }
        stdout_redirected = true;
    }

    if (stderr_path != NULL) {
        if (!redirect_output(
                STDERR_FILENO,
                SHELL_SAVED_STDERR_FILENO,
                stderr_path,
                append_stderr
            )) {
            restore_standard_descriptors(
                false,
                stdout_redirected,
                false
            );
            shell_write_error_string("error: could not redirect stderr\n");
            return false;
        }
        stderr_redirected = true;
    }

    if (stdin_path != NULL) {
        if (!redirect_standard_input(stdin_path)) {
            restore_standard_descriptors(
                false,
                stdout_redirected,
                stderr_redirected
            );
            shell_write_error_string("error: could not redirect stdin\n");
            return false;
        }
        stdin_redirected = true;
    }

    started = run(pid, expand_variables(
                           arguments,
                           expanded_arguments,
                           SHELL_COMMAND_BUFFER_CAPACITY),
                  NULL);

    restore_standard_descriptors(
        stdin_redirected,
        stdout_redirected,
        stderr_redirected
    );

    if (!started) {
        shell_write_error_string("error: could not start process\n");
    } else if (background) {
        last_background_process_id = pid;
    } else {
        set_foreground_process(pid);
        last_command_exit_status = waitpid(pid);
        set_foreground_process(0);
        report_foreground_process_status(
            pid,
            last_command_exit_status
        );
        if (WIFSTOPPED(last_command_exit_status)) {
            last_background_process_id = pid;
        } else if (last_background_process_id == pid) {
            last_background_process_id = 0;
        }
    }
    return started;
}

bool continue_background_process(bool foreground) {
    int pid = last_background_process_id;

    if (pid == 0) {
        last_background_process_id = 0;
        shell_write_error_string("error: no background process\n");
        return false;
    }
    if (foreground) {
        if (set_foreground_process(pid) == -1) {
            last_background_process_id = 0;
            shell_write_error_string("error: no background process\n");
            return false;
        }
    }
    if (kill(pid, SIGCONT) == -1) {
        if (foreground) {
            set_foreground_process(0);
        }
        last_background_process_id = 0;
        shell_write_error_string("error: no background process\n");
        return false;
    }

    if (foreground) {
        last_command_exit_status = waitpid(pid);
        set_foreground_process(0);
        report_foreground_process_status(
            pid,
            last_command_exit_status
        );
        if (!WIFSTOPPED(last_command_exit_status)) {
            last_background_process_id = 0;
        }
    }
    return true;
}

void build_executable_path(char *directory, char *name, char *result) {
    // Builds the same directory/name form used by direct process loading
    strcpy(result, directory);
    strcat(result, "/");
    strcat(result, name);
}

bool build_path_executable_path(
    char *directory,
    char *name,
    char *result
) {
    int length = strlen(directory) + strlen(name) + 2;

    if (directory[0] != '/') {
        length = length + strlen(shell_system_working_directory) + 1;
    }
    if (length > PATH_MAX) {
        return false;
    }
    if (directory[0] == '/') {
        build_executable_path(directory, name, result);
        return true;
    }
    strcpy(result, shell_system_working_directory);
    strcat(result, "/");
    strcat(result, directory);
    strcat(result, "/");
    strcat(result, name);
    return true;
}

int load_from_path(char *name) {
    char *executable_search_path = getenv("PATH");
    int directory_start = 0;
    int path_index = 0;
    char separator;
    int pid;

    while (true) {
        // Finds the end of the next directory in the colon-separated PATH
        while (executable_search_path[path_index] != '\0' &&
               executable_search_path[path_index] != ':') {
            path_index = path_index + 1;
        }

        // Temporarily terminates this entry so normal string helpers can use it
        separator = executable_search_path[path_index];
        executable_search_path[path_index] = '\0';
        if (build_path_executable_path(
            executable_search_path + directory_start,
            name,
            shell_executable_path
        )) {
            pid = load(shell_executable_path);
        } else {
            pid = 0;
        }
        executable_search_path[path_index] = separator;

        // Returns the first process found in PATH order
        if (pid != 0 || separator == 0) {
            return pid;
        }

        path_index = path_index + 1;
        directory_start = path_index;
    }
}

char *read_shell_test_file(char *path, int *size) {
    char *contents;
    int file_descriptor = open(path, O_RDONLY);

    if (file_descriptor < 0) {
        return NULL;
    }
    *size = lseek(file_descriptor, 0, SEEK_END);
    if (*size < 0 || lseek(file_descriptor, 0, SEEK_SET) < 0) {
        close(file_descriptor);
        return NULL;
    }

    contents = (char *)malloc(*size + 1);
    if (contents == NULL ||
        (*size > 0 &&
         read(file_descriptor, contents, *size) != *size)) {
        close(file_descriptor);
        free(contents);
        return NULL;
    }
    close(file_descriptor);
    contents[*size] = '\0';
    return contents;
}

bool run_shell_test(char *test_directory) {
    char capture_path[SHELL_EXECUTABLE_PATH_CAPACITY];
    char input_path[SHELL_EXECUTABLE_PATH_CAPACITY];
    char *input;
    int input_size;
    int index = 0;
    int line_start;
    int output_file_descriptor;
    bool evaluating = true;
    bool passed = true;

    build_executable_path(test_directory, "input.txt", input_path);
    build_executable_path(
        test_directory,
        ".fast_shell_output.txt",
        capture_path
    );

    if (!shell_reset()) {
        return false;
    }
    unsetenv(LOADING_BAR_ENVIRONMENT_VARIABLE);
    input = read_shell_test_file(input_path, &input_size);
    if (input == NULL) {
        shell_reset();
        return false;
    }

    output_file_descriptor = open(
        capture_path,
        O_WRONLY | O_CREAT | O_TRUNC | O_APPEND
    );
    if (output_file_descriptor < 0 ||
        dup2(STDOUT_FILENO, SHELL_TEST_SAVED_STDOUT_FILENO) < 0 ||
        dup2(STDERR_FILENO, SHELL_TEST_SAVED_STDERR_FILENO) < 0) {
        if (output_file_descriptor >= 0) {
            close(output_file_descriptor);
        }
        close(SHELL_TEST_SAVED_STDOUT_FILENO);
        close(SHELL_TEST_SAVED_STDERR_FILENO);
        free(input);
        shell_reset();
        return false;
    }
    if (dup2(output_file_descriptor, STDOUT_FILENO) < 0 ||
        dup2(output_file_descriptor, STDERR_FILENO) < 0) {
        dup2(SHELL_TEST_SAVED_STDOUT_FILENO, STDOUT_FILENO);
        dup2(SHELL_TEST_SAVED_STDERR_FILENO, STDERR_FILENO);
        close(output_file_descriptor);
        close(SHELL_TEST_SAVED_STDOUT_FILENO);
        close(SHELL_TEST_SAVED_STDERR_FILENO);
        free(input);
        shell_reset();
        return false;
    }
    close(output_file_descriptor);

    while (index < input_size && evaluating) {
        line_start = index;
        while (index < input_size &&
               input[index] != '\n' &&
               input[index] != '\r') {
            index = index + 1;
        }
        input[index] = '\0';
        if (index > line_start) {
            if (strcmp(input + line_start, "poweroff.bin") == 0) {
                evaluating = false;
            } else {
                evaluating = eval(input + line_start);
            }
        }
        index = index + 1;
        while (index < input_size &&
               (input[index] == '\n' || input[index] == '\r')) {
            index = index + 1;
        }
    }

    if (dup2(SHELL_TEST_SAVED_STDOUT_FILENO, STDOUT_FILENO) < 0) {
        passed = false;
    }
    if (dup2(SHELL_TEST_SAVED_STDERR_FILENO, STDERR_FILENO) < 0) {
        passed = false;
    }
    close(SHELL_TEST_SAVED_STDOUT_FILENO);
    close(SHELL_TEST_SAVED_STDERR_FILENO);
    free(input);
    if (!shell_reset()) {
        passed = false;
    }
    return passed;
}

bool run_shell_test_manifest(char *path) {
    char *manifest;
    int index = 0;
    int manifest_size;
    int test_start;
    bool passed = true;

    manifest = read_shell_test_file(path, &manifest_size);
    if (manifest == NULL) {
        return false;
    }
    while (index < manifest_size) {
        test_start = index;
        while (index < manifest_size &&
               manifest[index] != '\n' &&
               manifest[index] != '\r') {
            index = index + 1;
        }
        manifest[index] = '\0';
        if (index > test_start &&
            !run_shell_test(manifest + test_start)) {
            passed = false;
        }
        index = index + 1;
        while (index < manifest_size &&
               (manifest[index] == '\n' ||
                manifest[index] == '\r')) {
            index = index + 1;
        }
    }
    free(manifest);
    return passed;
}

bool eval(char *command) {
    char *raw_arguments;
    char *stderr_path;
    char *stdin_path;
    char *stdout_path;
    int export_status;
    int pipeline;
    int pid;
    int redirection_status;
    int operand_status;
    bool append_stdout;
    bool append_stderr;
    bool background;

    command = skip_line_whitespace(command);
    if (*command == '\0') {
        return true;
    }
    if (!quotes_are_balanced(command)) {
        shell_write_error_string("error: unmatched quote\n");
        last_command_exit_status = 1;
        return true;
    }
    pipeline = find_pipeline_operator(command);
    if (pipeline == -2) {
        shell_write_error_string("error: only one pipeline is supported\n");
        last_command_exit_status = 1;
        return true;
    }
    if (pipeline >= 0) {
        return run_pipeline(command, pipeline);
    }

    if (command_matches(command, "exit")) {
        if (command_operand(command, "exit") != NULL) {
            shell_write_error_string("error: exit does not accept arguments\n");
            last_command_exit_status = 1;
            return true;
        }
        return false;
    } else if (command_matches(command, "eval")) {
        raw_arguments = command_operand(command, "eval");
        if (raw_arguments == NULL) {
            last_command_exit_status = 0;
            return true;
        }
        return eval(raw_arguments);
    } else if (command_matches(command, "run-shell-tests")) {
        raw_arguments = command_operand(command, "run-shell-tests");
        if (raw_arguments == NULL) {
            shell_write_error_string(
                "error: run-shell-tests requires a manifest path\n"
            );
            last_command_exit_status = 1;
        } else if (!run_shell_test_manifest(raw_arguments)) {
            shell_write_error_string("error: shell tests failed\n");
            last_command_exit_status = 1;
        } else {
            last_command_exit_status = 0;
        }
    } else if (command_matches(command, "export")) {
        raw_arguments = command_operand(command, "export");
        if (raw_arguments == NULL) {
            shell_write_error_string("error: export requires an assignment\n");
            last_command_exit_status = 1;
        } else {
            export_status = export_environment_variable(raw_arguments);
            if (export_status > 0) {
                shell_write_error_string("error: invalid export\n");
                last_command_exit_status = 1;
            } else if (export_status < 0) {
                shell_write_error_string(
                    "error: could not store environment variable\n"
                );
                last_command_exit_status = 1;
            } else {
                last_command_exit_status = 0;
            }
        }
    } else if (command_matches(command, "cd")) {
        operand_status = single_command_operand(
            command,
            "cd",
            &raw_arguments
        );
        if (operand_status != 1) {
            shell_write_error_string("Usage: cd DIRECTORY\n");
            shell_write_error_string(
                "Change the shell's working directory.\n"
            );
            last_command_exit_status = 1;
        } else if (command_is_help(raw_arguments)) {
            shell_write_string("Usage: cd DIRECTORY\n");
            shell_write_string(
                "Change the shell's working directory.\n"
            );
            last_command_exit_status = 0;
        } else if (chdir(raw_arguments) < 0) {
            shell_write_error_string("cd: could not change directory\n");
            last_command_exit_status = 1;
        } else {
            last_command_exit_status = 0;
        }
    } else if (command_matches(command, "load")) {
        raw_arguments = command_operand(command, "load");
        if (raw_arguments == NULL) {
            shell_write_error_string("error: load requires a path\n");
            last_command_exit_status = 1;
        } else {
            pid = load(raw_arguments);
            if (pid == 0) {
                shell_write_error_string("error: could not load process\n");
                last_command_exit_status = 1;
            } else {
                report_process_created(pid);
                last_command_exit_status = 0;
            }
        }
    } else if (command_matches(command, "run")) {
        raw_arguments = command_operand(command, "run");
        if (raw_arguments == NULL) {
            shell_write_error_string("error: run requires a process ID\n");
            last_command_exit_status = 1;
        } else {
            background = strip_background_operator(command);
            redirection_status = strip_command_redirections(
                command,
                &stdin_path,
                &stdout_path,
                &append_stdout,
                &stderr_path,
                &append_stderr
            );
            if (redirection_status >= 0) {
                report_invalid_redirection(redirection_status);
                last_command_exit_status = 1;
            } else {
                raw_arguments = command_operand(command, "run");
                if (raw_arguments == NULL) {
                    shell_write_error_string(
                        "error: run requires a process ID\n"
                    );
                    last_command_exit_status = 1;
                } else {
                    pid = parse_process_id(raw_arguments);
                    if (!run_process(
                            pid,
                            command_arguments(raw_arguments),
                            background,
                            stdin_path,
                            stdout_path,
                            append_stdout,
                            stderr_path,
                            append_stderr
                        )) {
                        last_command_exit_status = 1;
                    } else if (background) {
                        last_command_exit_status = 0;
                    }
                }
            }
        }
    } else if (command_matches(command, "unload")) {
        raw_arguments = command_operand(command, "unload");
        if (raw_arguments == NULL) {
            shell_write_error_string("error: unload requires a process ID\n");
            last_command_exit_status = 1;
        } else {
            pid = parse_process_id(raw_arguments);
            if (!unload(pid)) {
                shell_write_error_string("error: could not unload process\n");
                last_command_exit_status = 1;
            } else {
                last_command_exit_status = 0;
            }
        }
    } else if (command_matches(command, "fg")) {
        if (command_operand(command, "fg") != NULL) {
            shell_write_error_string("error: fg does not accept arguments\n");
            last_command_exit_status = 1;
        } else if (!continue_background_process(true)) {
            last_command_exit_status = 1;
        }
    } else if (command_matches(command, "bg")) {
        if (command_operand(command, "bg") != NULL) {
            shell_write_error_string("error: bg does not accept arguments\n");
            last_command_exit_status = 1;
        } else if (continue_background_process(false)) {
            last_command_exit_status = 0;
        } else {
            last_command_exit_status = 1;
        }
    } else {
        background = strip_background_operator(command);
        redirection_status = strip_command_redirections(
            command,
            &stdin_path,
            &stdout_path,
            &append_stdout,
            &stderr_path,
            &append_stderr
        );
        if (redirection_status >= 0) {
            report_invalid_redirection(redirection_status);
            last_command_exit_status = 1;
        } else {
            raw_arguments = command_arguments(command);

            if (command_contains_path(command)) {
                pid = load(command);
            } else {
                pid = load_from_path(command);
            }

            if (pid == 0) {
                shell_write_error_string("error: unknown command\n");
                last_command_exit_status = 1;
            } else {
                report_process_created(pid);
                if (!run_process(
                        pid,
                        raw_arguments,
                        background,
                        stdin_path,
                        stdout_path,
                        append_stdout,
                        stderr_path,
                        append_stderr
                    )) {
                    last_command_exit_status = 1;
                }
            }
        }
    }
    return true;
}

int main(int argc, char **argv) {
    char command[SHELL_COMMAND_BUFFER_CAPACITY];
    int command_length;

    if (argc == 2 && command_is_help(argv[1])) {
        shell_usage(STDOUT_FILENO);
        return 0;
    }
    if (argc != 1) {
        shell_usage(STDERR_FILENO);
        return 1;
    }
    if (lseek(STDIN_FILENO, 0, SEEK_CUR) >= 0) {
        unsetenv(LOADING_BAR_ENVIRONMENT_VARIABLE);
    }
    set_foreground_process(0);
    if (prctl(PR_SET_PDEATHSIG, SIGKILL) == -1) {
        shell_write_error_string("error: could not configure shell signals\n");
        return 1;
    }
    initial_shell_environment = clone_environment();
    if (initial_shell_environment == NULL) {
        shell_write_error_string("error: could not save shell environment\n");
        return 1;
    }
    if (getcwd(initial_shell_working_directory, PATH_MAX) == NULL) {
        shell_write_error_string("error: could not save working directory\n");
        return 1;
    }
    if (get_system_working_directory(
            shell_system_working_directory,
            PATH_MAX
        ) == NULL) {
        shell_write_error_string("error: could not find system directory\n");
        return 1;
    }
    while (true) {
        command_length = read_line(
            command,
            SHELL_COMMAND_BUFFER_CAPACITY
        );
        if (command_length < 0) {
            return 0;
        }
        if (command_length > 0) {
            remember_shell_command(command);
            if (!eval(command)) {
                return 0;
            }
        }
    }
}
