// dependencies: ../common/user_command.reti_blocks ../library/unistd/libunistd.reti_blocks

#include "../common/user_command.header"
#include "../library/unistd/unistd.header"

int main(int argc, char **argv) {
    int index = 1;

    if (argc < 2) {
        command_write(STDERR_FILENO, "Usage: touch.bin FILE...\n");
        return 1;
    }
    while (index < argc) {
        if (touch(argv[index]) < 0) {
            command_write(STDERR_FILENO, "touch: could not touch file\n");
            return 1;
        }
        index = index + 1;
    }
    return 0;
}
