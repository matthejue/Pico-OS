// dependencies: ../common/user_command.reti_blocks ../library/unistd/libunistd.reti_blocks

#include "../common/user_command.header"
#include "../library/unistd/unistd.header"

void ps_usage(int file_descriptor) {
    command_write(file_descriptor, "Usage: ps.bin\n");
    command_write(file_descriptor, "List running processes.\n");
}

int main(int argc, char **argv) {
    if (argc == 2 && command_is_help(argv[1])) {
        ps_usage(STDOUT_FILENO);
        return 0;
    }
    if (argc != 1) {
        ps_usage(STDERR_FILENO);
        return 1;
    }
    list_processes();
    return 0;
}
