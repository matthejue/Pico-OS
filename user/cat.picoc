// dependencies: ../common/user_command.reti_blocks ../library/fcntl/libfcntl.reti_blocks ../library/unistd/libunistd.reti_blocks

#include "../common/loading_bar.header"
#include "../common/user_command.header"
#include "../library/fcntl/fcntl.header"
#include "../library/stdlib/stdlib.header"
#include "../library/unistd/unistd.header"

#define CAT_BUFFER_SIZE 64
#define CAT_INPUT_LINE_CAPACITY 80
#define CAT_CTRL_D 4

// Writes the path and error message to stderr through command_write() without loading stdio
void print_path_error(char *path, char *message) {
    command_write(STDERR_FILENO, "cat: ");
    command_write(STDERR_FILENO, path);
    command_write(STDERR_FILENO, ": ");
    command_write(STDERR_FILENO, message);
    command_write(STDERR_FILENO, "\n");
}

void cat_usage(int file_descriptor) {
    command_write(file_descriptor, "Usage: cat.bin [FILE...]\n");
    command_write(
        file_descriptor,
        "Print files, or copy stdin when no file is given.\n"
    );
}

// Echoes an input character to stderr when enabled without loading stdio
void echo_input_character(char character, bool echo_input) {
    if (echo_input) {
        write(STDERR_FILENO, &character, 1);
    }
}

// Writes bytes unchanged to files or escapes terminal controls without loading stdio
int write_file_contents(char *buffer, int count, bool terminal_output) {
    char output[CAT_BUFFER_SIZE * 4];
    char *hex_digits = "0123456789abcdef";
    int index = 0;
    int output_length = 0;
    int value;

    if (!terminal_output) {
        return write(STDOUT_FILENO, buffer, count) != count;
    }

    // Binary terminal controls can hide subsequent output or change the TUI's
    // character set. Display them as text, keeping file copies byte-for-byte.
    while (index < count) {
        value = buffer[index] & 255;
        if ((value >= ' ' && value <= '~') ||
            value == '\n' || value == '\r' || value == '\t') {
            output[output_length] = value;
            output_length = output_length + 1;
        } else {
            output[output_length] = '\\';
            output[output_length + 1] = 'x';
            output[output_length + 2] = hex_digits[value / 16];
            output[output_length + 3] = hex_digits[value % 16];
            output_length = output_length + 4;
        }
        index = index + 1;
    }
    return write(STDOUT_FILENO, output, output_length) != output_length;
}

int copy_file_descriptor(int file_descriptor) {
    char buffer[CAT_BUFFER_SIZE];
    bool terminal_output = lseek(STDOUT_FILENO, 0, SEEK_CUR) < 0;
    int count = read(file_descriptor, buffer, CAT_BUFFER_SIZE);

    while (count > 0) {
        if (write_file_contents(buffer, count, terminal_output) != 0) {
            return 1;
        }
        count = read(file_descriptor, buffer, CAT_BUFFER_SIZE);
    }
    return count < 0;
}

// AI used: GitHub Copilot through GitHub Education
int edit_standard_input(void) {
    char buffer[CAT_INPUT_LINE_CAPACITY];
    char character;
    int length = 0;
    int result;
    bool echo_input = lseek(STDOUT_FILENO, 0, SEEK_CUR) >= 0;

    result = read(STDIN_FILENO, &character, 1);
    while (result == 1 && character != CAT_CTRL_D) {
        if (character == '\b' || character == 127) {
            if (length > 0) {
                length = length - 1;
                if (echo_input) {
                    command_write(STDERR_FILENO, "\b \b");
                }
            }
        } else if (character == '\n' || character == '\r') {
            buffer[length] = '\n';
            if (write(STDOUT_FILENO, buffer, length + 1) < 0) {
                return 1;
            }
            echo_input_character('\n', echo_input);
            length = 0;
        } else if (character >= ' ' &&
                   length < CAT_INPUT_LINE_CAPACITY - 1) {
            buffer[length] = character;
            length = length + 1;
            echo_input_character(character, echo_input);
        }
        result = read(STDIN_FILENO, &character, 1);
    }
    if (length > 0 && write(STDOUT_FILENO, buffer, length) < 0) {
        return 1;
    }
    return result < 0;
}

int print_file(char *path) {
    int file_descriptor = open(path, O_RDONLY);
    int result;

    if (file_descriptor < 0) {
        print_path_error(path, "could not open file");
        return 1;
    }

    result = copy_file_descriptor(file_descriptor);
    close(file_descriptor);
    if (result != 0) {
        print_path_error(path, "could not copy file");
        return 1;
    }
    return 0;
}

int main(int argc, char **argv) {
    int index = 1;
    int status = 0;

    unsetenv(LOADING_BAR_ENVIRONMENT_VARIABLE);
    if (argc == 2 && command_is_help(argv[1])) {
        cat_usage(STDOUT_FILENO);
        return 0;
    }
    if (argc < 2) {
        if (lseek(STDIN_FILENO, 0, SEEK_CUR) >= 0) {
            status = copy_file_descriptor(STDIN_FILENO);
        } else {
            status = edit_standard_input();
        }
        if (status != 0) {
            command_write(STDERR_FILENO, "cat: could not copy stdin\n");
            return 1;
        }
        return 0;
    }
    while (index < argc) {
        if (print_file(argv[index]) != 0) {
            status = 1;
        }
        index = index + 1;
    }
    return status;
}
