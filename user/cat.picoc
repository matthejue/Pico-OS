// dependencies: ../lib/fcntl/libfcntl.reti_blocks ../lib/unistd/libunistd.reti_blocks

#include "../common/loading_bar.header"
#include "../lib/fcntl/fcntl.header"
#include "../lib/stdlib/stdlib.header"
#include "../lib/unistd/unistd.header"

#define CAT_BUFFER_SIZE 64

void print_string(int file_descriptor, char *text) {
    int length = 0;

    while (text[length] != 0) {
        length = length + 1;
    }
    write(file_descriptor, text, length);
}

void print_path_error(char *path, char *message) {
    print_string(STDERR_FILENO, "cat: ");
    print_string(STDERR_FILENO, path);
    print_string(STDERR_FILENO, ": ");
    print_string(STDERR_FILENO, message);
    print_string(STDERR_FILENO, "\n");
}

int print_file(char *path) {
    char buffer[CAT_BUFFER_SIZE];
    int file_descriptor = open(path, O_RDONLY);
    int count;
    int written;
    int result;

    if (file_descriptor < 0) {
        print_path_error(path, "could not open file");
        return 1;
    }

    count = read(file_descriptor, buffer, CAT_BUFFER_SIZE);
    while (count > 0) {
        written = 0;
        while (written < count) {
            result = write(
                STDOUT_FILENO,
                buffer + written,
                count - written
            );
            if (result <= 0) {
                close(file_descriptor);
                print_string(
                    STDERR_FILENO,
                    "cat: could not write output\n"
                );
                return 1;
            }
            written = written + result;
        }
        count = read(file_descriptor, buffer, CAT_BUFFER_SIZE);
    }

    close(file_descriptor);
    if (count < 0) {
        print_path_error(path, "could not read file");
        return 1;
    }
    return 0;
}

int main(int argc, char **argv) {
    int index = 1;
    int status = 0;

    unsetenv(LOADING_BAR_ENVIRONMENT_VARIABLE);
    if (argc < 2) {
        print_string(STDERR_FILENO, "cat: missing file operand\n");
        return 1;
    }
    while (index < argc) {
        if (print_file(argv[index]) != 0) {
            status = 1;
        }
        index = index + 1;
    }
    return status;
}
