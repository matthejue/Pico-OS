// dependencies: ../common/user_command.reti_blocks ../library/fcntl/libfcntl.reti_blocks ../library/unistd/libunistd.reti_blocks

#include "../common/loading_bar.header"
#include "../common/user_command.header"
#include "../library/fcntl/fcntl.header"
#include "../library/stdlib/stdlib.header"
#include "../library/unistd/unistd.header"

#define CAT_BUFFER_SIZE 64

void print_path_error(char *path, char *message) {
    command_write(STDERR_FILENO, "cat: ");
    command_write(STDERR_FILENO, path);
    command_write(STDERR_FILENO, ": ");
    command_write(STDERR_FILENO, message);
    command_write(STDERR_FILENO, "\n");
}

void cat_usage(int file_descriptor) {
    command_write(file_descriptor, "Usage: cat.bin FILE...\n");
    command_write(file_descriptor, "Print one or more files.\n");
}

int print_file(char *path) {
    char buffer[CAT_BUFFER_SIZE];
    int file_descriptor = open(path, O_RDONLY);
    int count;

    if (file_descriptor < 0) {
        print_path_error(path, "could not open file");
        return 1;
    }

    count = read(file_descriptor, buffer, CAT_BUFFER_SIZE);
    while (count > 0) {
        write(STDOUT_FILENO, buffer, count);
        count = read(file_descriptor, buffer, CAT_BUFFER_SIZE);
    }

    close(file_descriptor);
    if (count < 0) {
        print_path_error(path, "could not read file");
        return 1;
    }
    return 0;
}

int main(int argc, char **argv) {
    int index = 1;
    int status = 0;

    unsetenv(LOADING_BAR_ENVIRONMENT_VARIABLE);
    if (argc == 2 && command_is_help(argv[1])) {
        cat_usage(STDOUT_FILENO);
        return 0;
    }
    if (argc < 2) {
        command_write(
            STDERR_FILENO,
            "cat: missing file operand\n"
        );
        cat_usage(STDERR_FILENO);
        return 1;
    }
    while (index < argc) {
        if (print_file(argv[index]) != 0) {
            status = 1;
        }
        index = index + 1;
    }
    return status;
}
