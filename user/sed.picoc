// dependencies: ../common/user_command.reti_blocks ../library/unistd/libunistd.reti_blocks

#include "../common/loading_bar.header"
#include "../common/user_command.header"
#include "../library/stdlib/stdlib.header"
#include "../library/unistd/unistd.header"

bool text_starts_with(char *text, char *pattern, int pattern_length) {
    int pattern_index;

    pattern_index = 0;
    while (pattern_index < pattern_length &&
           text[pattern_index] == pattern[pattern_index]) {
        pattern_index = pattern_index + 1;
    }
    return pattern_index == pattern_length;
}

bool line_contains(char *line, int line_length, char *pattern, int pattern_length) {
    int line_index = 0;

    while (line_index + pattern_length <= line_length) {
        if (text_starts_with(line + line_index, pattern, pattern_length)) {
            return true;
        }
        line_index = line_index + 1;
    }
    return false;
}

void write_substituted_line(
    char *line,
    int line_length,
    char *pattern,
    int pattern_length,
    char *replacement,
    int replacement_length
) {
    int line_index = 0;
    bool replaced = false;

    while (line_index < line_length) {
        if (!replaced &&
            line_index + pattern_length <= line_length &&
            text_starts_with(line + line_index, pattern, pattern_length)) {
            write(STDOUT_FILENO, replacement, replacement_length);
            line_index = line_index + pattern_length;
            replaced = true;
        } else {
            write(STDOUT_FILENO, line + line_index, 1);
            line_index = line_index + 1;
        }
    }
}

void write_replacement(char *text) {
    command_write(STDOUT_FILENO, text);
    command_write(STDOUT_FILENO, "\n");
}

void sed_usage(int file_descriptor) {
    command_write(file_descriptor, "Usage: sed.bin EXPRESSION\n");
    command_write(file_descriptor, "Edit selected lines from stdin.\n");
}

int main(int argc, char **argv) {
    char *expression;
    char *contents;
    char *replacement;
    char *pattern = NULL;
    int pattern_length = 0;
    int replacement_length;
    int replacement_start;
    int addressed_line = 0;
    int command_index = 0;
    int file_size;
    int start = 0;
    int end;
    int line_number = 1;
    int line_length;
    bool selected;
    bool substitution = false;
    char command;

    if (argc == 2 && command_is_help(argv[1])) {
        sed_usage(STDOUT_FILENO);
        return 0;
    }
    if (argc != 2) {
        sed_usage(STDERR_FILENO);
        return 1;
    }
    unsetenv(LOADING_BAR_ENVIRONMENT_VARIABLE);
    expression = argv[1];
    if (expression[0] == 's' && expression[1] == '/') {
        substitution = true;
        pattern = expression + 2;
        command_index = 2;
        while (expression[command_index] != '/') {
            command_index = command_index + 1;
        }
        pattern_length = command_index - 2;
        command_index = command_index + 1;
        replacement_start = command_index;
        replacement = expression + replacement_start;
        while (expression[command_index] != '\0' &&
               expression[command_index] != '/') {
            command_index = command_index + 1;
        }
        replacement_length = command_index - replacement_start;
    } else if (expression[0] == '/') {
        pattern = expression + 1;
        command_index = 1;
        while (expression[command_index] != '/') {
            command_index = command_index + 1;
        }
        pattern_length = command_index - 1;
        command_index = command_index + 1;
    } else {
        while (expression[command_index] >= '0' &&
               expression[command_index] <= '9') {
            addressed_line = addressed_line * 10 +
                expression[command_index] - '0';
            command_index = command_index + 1;
        }
    }
    if (!substitution) {
        command = expression[command_index];
        replacement = expression + command_index + 1;
    }

    file_size = lseek(STDIN_FILENO, 0, SEEK_END);
    if (file_size < 0 || lseek(STDIN_FILENO, 0, SEEK_SET) < 0) {
        command_write(STDERR_FILENO, "sed: could not read stdin\n");
        return 1;
    }
    contents = (char *)malloc(file_size + 1);
    if (contents == NULL ||
        (file_size > 0 &&
         read(STDIN_FILENO, contents, file_size) != file_size)) {
        free(contents);
        command_write(STDERR_FILENO, "sed: could not read stdin\n");
        return 1;
    }
    contents[file_size] = '\0';

    while (start < file_size) {
        end = start;
        while (end < file_size && contents[end] != '\n') {
            end = end + 1;
        }
        line_length = end - start;
        if (end < file_size) {
            end = end + 1;
        }
        selected = addressed_line == line_number ||
            (pattern != NULL && !substitution && line_contains(
                contents + start,
                line_length,
                pattern,
                pattern_length
            ));
        if (!substitution && selected && command == 'i') {
            write_replacement(replacement);
        }
        if (substitution) {
            write_substituted_line(
                contents + start,
                line_length,
                pattern,
                pattern_length,
                replacement,
                replacement_length
            );
            if (end > start + line_length) {
                command_write(STDOUT_FILENO, "\n");
            }
        } else if (!selected || command != 'c') {
            write(STDOUT_FILENO, contents + start, end - start);
        } else {
            write_replacement(replacement);
        }
        if (selected && command == 'a') {
            write_replacement(replacement);
        }
        start = end;
        line_number = line_number + 1;
    }
    free(contents);
    return 0;
}
