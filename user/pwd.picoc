// dependencies: ../common/user_command.reti_blocks ../library/unistd/libunistd.reti_blocks

#include "../common/user_command.header"
#include "../library/unistd/unistd.header"

void pwd_usage(int file_descriptor) {
    command_write(file_descriptor, "Usage: pwd.bin\n");
    command_write(file_descriptor, "Print the working directory.\n");
}

int main(int argc, char **argv) {
    char path[512];

    if (argc == 2 && command_is_help(argv[1])) {
        pwd_usage(STDOUT_FILENO);
        return 0;
    }
    if (argc != 1) {
        pwd_usage(STDERR_FILENO);
        return 1;
    }
    if (getcwd(path, PATH_MAX) == NULL) {
        command_write(STDERR_FILENO, "pwd: could not get directory\n");
        return 1;
    }
    command_write(STDOUT_FILENO, path);
    command_write(STDOUT_FILENO, "\n");
    return 0;
}
