// dependencies: ../common/user_command.reti_blocks ../library/schedule/libschedule.reti_blocks ../library/signal/libsignal.reti_blocks ../library/unistd/libunistd.reti_blocks

#include "../common/user_command.header"
#include "../library/schedule/schedule.header"
#include "../library/signal/signal.header"
#include "../library/stdlib/stdlib.header"
#include "../library/unistd/unistd.header"

bool kill_text_matches(char *left, char *right) {
    int index = 0;

    while (left[index] != '\0' && left[index] == right[index]) {
        index = index + 1;
    }
    return left[index] == right[index];
}

int parse_signal(char *value) {
    int index = 0;

    if (kill_text_matches(value, "SIGINT")) {
        return SIGINT;
    } else if (kill_text_matches(value, "SIGKILL")) {
        return SIGKILL;
    } else if (kill_text_matches(value, "SIGCONT")) {
        return SIGCONT;
    } else if (kill_text_matches(value, "SIGSTOP")) {
        return SIGSTOP;
    } else if (kill_text_matches(value, "SIGTSTP")) {
        return SIGTSTP;
    } else if (kill_text_matches(value, "SIGTTIN")) {
        return SIGTTIN;
    }
    if (value[0] == '\0') {
        return -1;
    }
    while (value[index] >= '0' && value[index] <= '9') {
        index = index + 1;
    }
    if (value[index] != '\0') {
        return -1;
    }
    return atoi(value);
}

int parse_process_id(char *value) {
    int index = 0;

    while (value[index] >= '0' && value[index] <= '9') {
        index = index + 1;
    }
    if (index == 0 || value[index] != '\0') {
        return -1;
    }
    return atoi(value);
}

void kill_write_usage(int file_descriptor) {
    command_write(
        file_descriptor,
        "Usage: kill.bin [SIGNAL] PID\n"
    );
    command_write(
        file_descriptor,
        "SIGNAL may be 0, SIGINT, SIGKILL, SIGCONT, SIGSTOP, SIGTSTP, SIGTTIN, or its number.\n"
    );
}

int main(int argc, char **argv) {
    int process_id;
    int signal_number = SIGKILL;

    if (argc == 2 && command_is_help(argv[1])) {
        kill_write_usage(STDOUT_FILENO);
        return 0;
    }
    if (argc < 2 || argc > 3) {
        kill_write_usage(STDERR_FILENO);
        return 1;
    }
    if (argc == 3) {
        signal_number = parse_signal(argv[1]);
        process_id = parse_process_id(argv[2]);
    } else {
        process_id = parse_process_id(argv[1]);
    }
    if (process_id <= 0) {
        command_write(STDERR_FILENO, "kill: invalid process ID\n");
        kill_write_usage(STDERR_FILENO);
        return 1;
    }
    if (signal_number != 0 &&
        signal_number != SIGINT &&
        signal_number != SIGKILL &&
        signal_number != SIGCONT &&
        signal_number != SIGSTOP &&
        signal_number != SIGTSTP &&
        signal_number != SIGTTIN) {
        command_write(STDERR_FILENO, "kill: invalid signal\n");
        kill_write_usage(STDERR_FILENO);
        return 1;
    }
    if (kill(process_id, signal_number) == -1) {
        command_write(STDERR_FILENO, "kill: process not found\n");
        return 1;
    }
    yield();
    return 0;
}
