// dependencies: ../common/user_command.reti_blocks ../library/stdio/libstdio.reti_blocks ../library/schedule/libschedule.reti_blocks ../library/unistd/libunistd.reti_blocks

#include "../common/user_command.header"
#include "../common/stddef.header"
#include "../library/stdio/stdio.header"
#include "../library/schedule/schedule.header"
#include "../library/stdlib/stdlib.header"
#include "../library/unistd/unistd.header"

#define DEFAULT_COUNT_DELAY 25000

void count_usage(int file_descriptor) {
    command_write(file_descriptor, "Usage: count.bin [DELAY]\n");
    command_write(
        file_descriptor,
        "Count upward with an optional busy-loop delay.\n"
    );
}

int main(int argc, char **argv) {
    int count = 0;
    int count_delay = DEFAULT_COUNT_DELAY;
    int delay;

    if (argc == 2 && command_is_help(argv[1])) {
        count_usage(STDOUT_FILENO);
        return 0;
    }
    if (argc > 2) {
        count_usage(STDERR_FILENO);
        return 1;
    }
    if (argc == 2) {
        count_delay = atoi(argv[1]);
        if (count_delay < 0) {
            command_write(
                STDERR_FILENO,
                "count: delay must not be negative\n"
            );
            count_usage(STDERR_FILENO);
            return 1;
        }
    }

    while (true) {
        printf("\r%d", count);

        delay = count_delay;
        while (delay > 0) {
            delay = delay - 1;
        }

        count = count + 1;
        yield();
    }
}
