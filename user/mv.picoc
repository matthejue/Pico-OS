// dependencies: ../common/user_command.reti_blocks ../library/unistd/libunistd.reti_blocks

#include "../common/user_command.header"
#include "../library/unistd/unistd.header"

void mv_usage(int file_descriptor) {
    command_write(file_descriptor, "Usage: mv.bin SOURCE DESTINATION\n");
    command_write(file_descriptor, "Move or rename a path.\n");
}

int main(int argc, char **argv) {
    if (argc == 2 && command_is_help(argv[1])) {
        mv_usage(STDOUT_FILENO);
        return 0;
    }
    if (argc != 3) {
        mv_usage(STDERR_FILENO);
        return 1;
    }
    if (move(argv[1], argv[2]) < 0) {
        command_write(STDERR_FILENO, "mv: could not move path\n");
        return 1;
    }
    return 0;
}
