#include "unistd.header"
#include "../stdlib/stdlib.header"
#include "../../common/loading_bar.header"
#include "../../common/syscall.header"

int read(int file_descriptor, void *buffer, int count) {
    struct IoRequest request;
    int result;

    request.file_descriptor = file_descriptor;
    request.buffer = (char *)buffer;
    request.count = count;
    request.show_loading_bar =
        getenv(LOADING_BAR_ENVIRONMENT_VARIABLE) != NULL;
    request.transferred = 0;
    request.complete = false;

    while (!request.complete) {
        result = invoke_syscall(SYSCALL_READ, (int)&request);
        if (result <= 0) {
            if (result < 0 && request.transferred == 0) {
                return -1;
            }
            return request.transferred;
        }
        request.transferred = request.transferred + result;
    }
    return request.transferred;
}

int write(int file_descriptor, void *buffer, int count) {
    struct IoRequest request;

    request.file_descriptor = file_descriptor;
    request.buffer = (char *)buffer;
    request.count = count;
    request.show_loading_bar = false;
    return invoke_syscall(SYSCALL_WRITE, (int)&request);
}

int close(int file_descriptor) {
    return invoke_syscall(SYSCALL_CLOSE, file_descriptor);
}

int dup2(int old_file_descriptor, int new_file_descriptor) {
    struct Dup2Request request;

    request.old_file_descriptor = old_file_descriptor;
    request.new_file_descriptor = new_file_descriptor;
    return invoke_syscall(SYSCALL_DUP2, (int)&request);
}

int lseek(int file_descriptor, int offset, int origin) {
    struct SeekRequest request;

    request.file_descriptor = file_descriptor;
    request.offset = offset;
    request.origin = origin;
    return invoke_syscall(SYSCALL_LSEEK, (int)&request);
}
