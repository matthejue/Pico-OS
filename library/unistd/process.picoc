#include "unistd.header"
#include "../stdlib/stdlib.header"
#include "../../common/loading_bar.header"
#include "../../common/syscall.header"
#include "../../common/stddef.header"

int invoke_syscall(int number, int argument) {
    int result;

    asm("LOADIN BAF ACC 3");
    asm("LOADIN BAF IN1 4");
    asm("INT 0");
    asm("STOREIN BAF IN2 0");
    return result;
}

int load(char *path) {
    struct LoadProcessRequest request;
    int result;

    request.path = path;
    request.show_loading_bar =
        getenv(LOADING_BAR_ENVIRONMENT_VARIABLE) != NULL;
    result = invoke_syscall(SYSCALL_LOAD_PROCESS, (int)&request);
    while (result == SYSCALL_LOAD_PROCESS_CONTINUE) {
        result = invoke_syscall(SYSCALL_LOAD_PROCESS, (int)&request);
    }
    return result;
}

bool run(int pid, char *arguments, char **environment) {
    struct RunProcessRequest request;

    request.pid = pid;
    request.arguments = arguments;
    if (environment == NULL) {
        request.environment = current_environment();
    } else {
        request.environment = environment;
    }
    return (bool)invoke_syscall(
        SYSCALL_RUN_PROCESS_WITH_ARGUMENTS,
        (int)&request
    );
}

bool unload(int pid) {
    return (bool)invoke_syscall(SYSCALL_UNLOAD_PROCESS, pid);
}

void list_processes(void) {
    invoke_syscall(SYSCALL_LIST_PROCESSES, 0);
}

int getpid(void) {
    return invoke_syscall(SYSCALL_GETPID, 0);
}

void reset_processes(void) {
    invoke_syscall(SYSCALL_RESET_PROCESSES, 0);
}

int set_foreground_process(int pid) {
    return invoke_syscall(SYSCALL_SET_FOREGROUND_PROCESS, pid);
}
