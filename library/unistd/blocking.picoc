#include "unistd.header"
#include "../../common/syscall.header"

void wait_queue_init(struct wait_queue *wq) {
    wq->head = NULL;
    wq->tail = NULL;
}

void sleep(struct wait_queue *wq) {
    if (wq == NULL) {
        return;
    }

    invoke_syscall(SYSCALL_SLEEP, (int)wq);
}

void wakeup(struct wait_queue *wq) {
    if (wq == NULL) {
        return;
    }

    invoke_syscall(SYSCALL_WAKEUP, (int)wq);
}
