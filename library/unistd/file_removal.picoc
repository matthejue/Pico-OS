#include "unistd.header"
#include "../../common/syscall.header"

int unlink(char *path) {
    if (path == NULL) {
        return -1;
    }
    return invoke_syscall(SYSCALL_UNLINK, (int)path);
}

int rmdir(char *path) {
    if (path == NULL) {
        return -1;
    }
    return invoke_syscall(SYSCALL_RMDIR, (int)path);
}
