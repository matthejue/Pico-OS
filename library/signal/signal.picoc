#include "signal.header"
#include "../../common/syscall.header"

int invoke_signal_syscall(int number, int argument) {
    int result;

    asm("LOADIN BAF ACC 3");
    asm("LOADIN BAF IN1 4");
    asm("INT 0");
    asm("STOREIN BAF ACC 0");
    return result;
}

int kill(int pid, int signal_number) {
    struct KillRequest request;

    request.pid = pid;
    request.signal_number = signal_number;
    return invoke_signal_syscall(SYSCALL_KILL, (int)&request);
}
