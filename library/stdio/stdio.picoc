#include "stdio.header"
#include "../../common/file.header"
#include "../../common/decimal.header"
#include "../../common/stddef.header"
#include "../../common/syscall.header"

#define FOPEN_STREAM_COUNT 5

FILE standard_input_stream;
FILE standard_output_stream;
FILE standard_error_stream;
FILE file_streams[FOPEN_STREAM_COUNT];
bool file_stream_used[FOPEN_STREAM_COUNT];
FILE *standard_input_pointer = NULL;
FILE *standard_output_pointer = NULL;
FILE *standard_error_pointer = NULL;
bool standard_streams_use_file_descriptors = false;

void send_byte_over_uart(int value) {
    asm("LOADIN BAF IN1 3");
    asm("LOADI ACC 0"); // SYSCALL_SEND_BYTE_OVER_UART
    asm("INT 0");
}

int receive_byte_over_uart(void) {
    int value = 0;

    // Supports PicoC-Compiler tests linked with isrs.reti without PicoOS
    asm("LOADI ACC 1"); // Legacy isrs.reti receive-byte syscall
    asm("INT 0");
    asm("STOREIN BAF IN2 0");
    return value;
}

int invoke_stdio_syscall(int number, int argument) {
    int result;

    asm("LOADIN BAF ACC 3");
    asm("LOADIN BAF IN1 4");
    asm("INT 0");
    asm("STOREIN BAF IN2 0");
    return result;
}

void prepare_standard_streams(void) {
    int index;

    if (standard_input_pointer != NULL) {
        return;
    }

    standard_input_stream.file_descriptor = STDIN_FILENO;
    standard_output_stream.file_descriptor = STDOUT_FILENO;
    standard_error_stream.file_descriptor = STDERR_FILENO;
    standard_input_pointer = &standard_input_stream;
    standard_output_pointer = &standard_output_stream;
    standard_error_pointer = &standard_error_stream;
    // Detects PicoOS so compiler tests with isrs.reti can use legacy UART I/O
    // without linking and booting the complete kernel
    standard_streams_use_file_descriptors = invoke_stdio_syscall(
        SYSCALL_FILE_DESCRIPTORS_AVAILABLE,
        0
    ) == 1;

    index = 0;
    while (index < FOPEN_STREAM_COUNT) {
        file_stream_used[index] = false;
        index = index + 1;
    }
}

bool standard_stream_uses_legacy_uart(FILE *stream, int file_descriptor) {
    // Keeps stdio usable in PicoC-Compiler tests linked with isrs.reti
    // without linking and booting the complete kernel
    return !standard_streams_use_file_descriptors &&
           stream->file_descriptor == file_descriptor;
}

FILE *standard_input(void) {
    prepare_standard_streams();
    return standard_input_pointer;
}

FILE *standard_output(void) {
    prepare_standard_streams();
    return standard_output_pointer;
}

FILE *standard_error(void) {
    prepare_standard_streams();
    return standard_error_pointer;
}

int mode_to_flags(char *mode) {
    int flags;
    int index = 0;
    bool update = false;

    if (mode == NULL) {
        return -1;
    }
    while (mode[index] != '\0') {
        if (mode[index] == '+') {
            update = true;
        }
        index = index + 1;
    }

    if (mode[0] == 'r') {
        flags = O_RDONLY;
    } else if (mode[0] == 'w') {
        flags = O_WRONLY | O_CREAT | O_TRUNC;
    } else if (mode[0] == 'a') {
        flags = O_WRONLY | O_CREAT | O_APPEND;
    } else {
        return -1;
    }

    if (update) {
        flags = (flags & (0 - O_ACCMODE - 1)) | O_RDWR;
    }
    return flags;
}

FILE *fopen(char *path, char *mode) {
    struct OpenRequest request;
    int stream_index = 0;
    int file_descriptor;

    prepare_standard_streams();
    while (stream_index < FOPEN_STREAM_COUNT &&
           file_stream_used[stream_index]) {
        stream_index = stream_index + 1;
    }
    if (stream_index == FOPEN_STREAM_COUNT) {
        return NULL;
    }

    request.path = path;
    request.flags = mode_to_flags(mode);
    if (request.flags < 0) {
        return NULL;
    }

    file_descriptor = invoke_stdio_syscall(SYSCALL_OPEN, (int)&request);
    if (file_descriptor < 0) {
        return NULL;
    }

    file_stream_used[stream_index] = true;
    file_streams[stream_index].file_descriptor = file_descriptor;
    return file_streams + stream_index;
}

int fclose(FILE *stream) {
    int stream_index = 0;
    int result;

    prepare_standard_streams();
    if (stream == NULL) {
        return -1;
    }

    result = invoke_stdio_syscall(
        SYSCALL_CLOSE,
        stream->file_descriptor
    );
    while (stream_index < FOPEN_STREAM_COUNT) {
        if (stream == file_streams + stream_index) {
            file_stream_used[stream_index] = false;
            return result;
        }
        stream_index = stream_index + 1;
    }
    return result;
}

int fgetc(FILE *stream) {
    struct IoRequest request;
    char value;

    prepare_standard_streams();
    if (stream == NULL) {
        return -1;
    }

    if (standard_stream_uses_legacy_uart(stream, STDIN_FILENO)) {
        return receive_byte_over_uart();
    }

    request.file_descriptor = stream->file_descriptor;
    request.buffer = &value;
    request.count = 1;
    request.show_loading_bar = false;
    request.transferred = 0;
    request.complete = false;
    if (invoke_stdio_syscall(SYSCALL_READ, (int)&request) != 1) {
        return -1;
    }
    return value & 255;
}

int fputc(int character, FILE *stream) {
    struct IoRequest request;
    char value = character;

    prepare_standard_streams();
    if (stream == NULL) {
        return -1;
    }

    if (standard_stream_uses_legacy_uart(stream, STDOUT_FILENO)) {
        send_byte_over_uart(character);
        return character & 255;
    }

    request.file_descriptor = stream->file_descriptor;
    request.buffer = &value;
    request.count = 1;
    request.show_loading_bar = false;
    if (invoke_stdio_syscall(SYSCALL_WRITE, (int)&request) != 1) {
        return -1;
    }
    return character & 255;
}

int fputs(char *text, FILE *stream) {
    struct IoRequest request;
    int length = 0;
    int index;

    prepare_standard_streams();
    if (text == NULL || stream == NULL) {
        return -1;
    }
    while (text[length] != '\0') {
        length = length + 1;
    }

    if (standard_stream_uses_legacy_uart(stream, STDOUT_FILENO)) {
        index = 0;
        while (index < length) {
            send_byte_over_uart(text[index]);
            index = index + 1;
        }
        return length;
    }

    request.file_descriptor = stream->file_descriptor;
    request.buffer = text;
    request.count = length;
    request.show_loading_bar = false;
    return invoke_stdio_syscall(SYSCALL_WRITE, (int)&request);
}

int write_decimal(FILE *stream, int value) {
    char digits[12];
    int length = append_decimal(digits, value);
    int written = 0;

    while (written < length) {
        if (fputc(digits[written], stream) < 0) {
            return -1;
        }
        written = written + 1;
    }
    return written;
}

int format_argument(int argument_base, int argument_index, int first_argument) {
    return *((int *)(argument_base + first_argument + argument_index));
}

int format_stream(
    FILE *stream,
    char *format,
    int argument_base,
    int first_argument
) {
    int index = 0;
    int argument_index = 0;
    int argument_value;
    int written = 0;
    int count;

    while (format[index] != '\0') {
        if (format[index] != '%') {
            if (fputc(format[index], stream) < 0) {
                return -1;
            }
            written = written + 1;
            index = index + 1;
        } else {
            index = index + 1;
            if (format[index] == 'd') {
                argument_value = format_argument(
                    argument_base,
                    argument_index,
                    first_argument
                );
                count = write_decimal(stream, argument_value);
                argument_index = argument_index + 1;
            } else if (format[index] == 'c') {
                argument_value = format_argument(
                    argument_base,
                    argument_index,
                    first_argument
                );
                count = fputc(argument_value, stream);
                if (count >= 0) {
                    count = 1;
                }
                argument_index = argument_index + 1;
            } else if (format[index] == 's') {
                argument_value = format_argument(
                    argument_base,
                    argument_index,
                    first_argument
                );
                count = fputs((char *)argument_value, stream);
                argument_index = argument_index + 1;
            } else if (format[index] == '%') {
                count = fputc('%', stream);
                if (count >= 0) {
                    count = 1;
                }
            } else {
                count = 0;
            }

            if (count < 0) {
                return -1;
            }
            written = written + count;
            if (format[index] != '\0') {
                index = index + 1;
            }
        }
    }
    return written;
}

int fprintf(FILE *stream, char *format, ...) {
    int argument_base;

    asm("MOVE BAF IN1");
    asm("STOREIN BAF IN1 0");
    return format_stream(stream, format, argument_base, 5);
}

int printf(char *format, ...) {
    int argument_base;

    prepare_standard_streams();
    asm("MOVE BAF IN1");
    asm("STOREIN BAF IN1 0");
    return format_stream(stdout, format, argument_base, 4);
}
