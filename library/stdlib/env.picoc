#include "stdlib.header"
#include "../../common/stddef.header"

char **environ = NULL;

char **current_environment(void) {
    return environ;
}

int environment_variable_length(char *variable) {
    int length = 0;

    while (variable[length] != '\0') {
        length = length + 1;
    }

    return length;
}

char *copy_environment_variable(char *variable) {
    int length = environment_variable_length(variable);
    int index = 0;
    char *copy = (char *)malloc(length + 1);

    if (copy == NULL) {
        return NULL;
    }

    while (index <= length) {
        copy[index] = variable[index];
        index = index + 1;
    }

    return copy;
}

bool environment_variable_matches(
    char *variable,
    char *name,
    int name_length
) {
    int index = 0;

    while (index < name_length && variable[index] == name[index]) {
        index = index + 1;
    }

    return index == name_length && variable[index] == '=';
}

int environment_variable_index(char *name, int name_length) {
    int index = 0;

    while (environ[index] != NULL) {
        if (environment_variable_matches(
                environ[index],
                name,
                name_length)) {
            return index;
        }
        index = index + 1;
    }

    return -1;
}

int store_environment_variable(char *variable, int name_length) {
    int environment_index = environment_variable_index(variable, name_length);
    char **resized_environment;

    if (environment_index != -1) {
        free(environ[environment_index]);
        environ[environment_index] = variable;
        return 0;
    }

    environment_index = 0;
    while (environ[environment_index] != NULL) {
        environment_index = environment_index + 1;
    }

    resized_environment = (char **)realloc(
        environ,
        (environment_index + 2) * sizeof(char *)
    );
    if (resized_environment == NULL) {
        free(variable);
        return -1;
    }
    environ = resized_environment;

    environ[environment_index] = variable;
    environ[environment_index + 1] = NULL;
    return 0;
}

void initialize_environment(char **environment) {
    int count = 0;
    int index = 0;

    if (environment != NULL) {
        while (environment[count] != NULL) {
            count = count + 1;
        }
    }

    environ = (char **)malloc((count + 1) * sizeof(char *));
    while (index < count) {
        environ[index] = copy_environment_variable(environment[index]);
        index = index + 1;
    }
    environ[count] = NULL;
}

char *getenv(char *name) {
    int name_length = environment_variable_length(name);
    int index = environment_variable_index(name, name_length);

    if (index == -1) {
        return NULL;
    }

    return environ[index] + name_length + 1;
}

int setenv(char *name, char *value, bool overwrite) {
    int name_length = environment_variable_length(name);
    int value_length = environment_variable_length(value);
    int environment_index = environment_variable_index(name, name_length);
    int index = 0;
    char *variable;

    if (environment_index != -1 && !overwrite) {
        return 0;
    }

    variable = (char *)malloc(name_length + value_length + 2);
    if (variable == NULL) {
        return -1;
    }

    while (index < name_length) {
        variable[index] = name[index];
        index = index + 1;
    }
    variable[name_length] = '=';

    index = 0;
    while (index <= value_length) {
        variable[name_length + index + 1] = value[index];
        index = index + 1;
    }

    return store_environment_variable(variable, name_length);
}

int unsetenv(char *name) {
    int name_length = environment_variable_length(name);
    int index = environment_variable_index(name, name_length);

    if (index == -1) {
        return 0;
    }

    free(environ[index]);
    while (environ[index] != NULL) {
        environ[index] = environ[index + 1];
        index = index + 1;
    }

    return 0;
}

int putenv(char *variable) {
    int name_length = 0;
    char *copy;

    while (variable[name_length] != '\0' &&
           variable[name_length] != '=') {
        name_length = name_length + 1;
    }
    if (variable[name_length] != '=') {
        return -1;
    }

    copy = copy_environment_variable(variable);
    if (copy == NULL) {
        return -1;
    }

    return store_environment_variable(copy, name_length);
}

int clearenv(void) {
    int index = 0;

    while (environ[index] != NULL) {
        free(environ[index]);
        index = index + 1;
    }
    environ[0] = NULL;
    return 0;
}

char **clone_environment(void) {
    char **copy;
    int count = 0;
    int index = 0;

    while (environ[count] != NULL) {
        count = count + 1;
    }
    copy = (char **)malloc((count + 1) * sizeof(char *));
    if (copy == NULL) {
        return NULL;
    }
    copy[0] = NULL;
    while (index < count) {
        copy[index] = copy_environment_variable(environ[index]);
        if (copy[index] == NULL) {
            destroy_environment(copy);
            return NULL;
        }
        index = index + 1;
        copy[index] = NULL;
    }
    return copy;
}

void destroy_environment(char **environment) {
    int index = 0;

    if (environment == NULL) {
        return;
    }
    while (environment[index] != NULL) {
        free(environment[index]);
        index = index + 1;
    }
    free(environment);
}

int restore_environment(char **environment) {
    int index = 0;

    clearenv();
    while (environment[index] != NULL) {
        if (putenv(environment[index]) != 0) {
            return -1;
        }
        index = index + 1;
    }
    return 0;
}
