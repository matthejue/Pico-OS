#pragma once

#define SYSCALL_SEND_BYTE_OVER_UART 0
#define SYSCALL_RECEIVE_BYTE_OVER_UART 1
#define SYSCALL_SHUTDOWN 2
#define SYSCALL_LOAD_PROCESS 3
#define SYSCALL_LIST_PROCESSES 4
#define SYSCALL_UNLOAD_PROCESS 5
#define SYSCALL_PROCESS_HEAP_START 6
#define SYSCALL_PROCESS_HEAP_SIZE 7
#define SYSCALL_RUN_PROCESS_WITH_ARGUMENTS 8
#define SYSCALL_EXIT 9
#define SYSCALL_WAIT_PROCESS 10
#define SYSCALL_SLEEP 11
#define SYSCALL_WAKEUP 12
#define SYSCALL_YIELD 13

struct RunProcessRequest {
    int pid;
    char *arguments;
    char **environment;
};

struct WaitProcessRequest {
    int pid;
    int *status;
};
