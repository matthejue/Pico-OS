#pragma once

#include "stddef.header"

#define SYSCALL_SHUTDOWN 0
#define SYSCALL_REBOOT 1

#define SYSCALL_LOAD_PROCESS 2
#define SYSCALL_RUN_PROCESS_WITH_ARGUMENTS 3
#define SYSCALL_LIST_PROCESSES 4
#define SYSCALL_UNLOAD_PROCESS 5
#define SYSCALL_EXIT 6
#define SYSCALL_WAITPID 7
#define SYSCALL_GETPID 8
#define SYSCALL_SET_FOREGROUND_PROCESS 9
#define SYSCALL_KILL 10
#define SYSCALL_PRCTL 11

#define SYSCALL_SLEEP 12
#define SYSCALL_WAKEUP 13
#define SYSCALL_YIELD 14

#define SYSCALL_PROCESS_HEAP_START 15
#define SYSCALL_PROCESS_HEAP_SIZE 16
#define SYSCALL_PROCESS_HEAP_FULL 17
#define SYSCALL_SHM_OPEN 18
#define SYSCALL_MMAP 19
#define SYSCALL_SHM_UNLINK 20

#define SYSCALL_FILE_DESCRIPTORS_AVAILABLE 21
#define SYSCALL_OPEN 22
#define SYSCALL_READ 23
#define SYSCALL_WRITE 24
#define SYSCALL_CLOSE 25
#define SYSCALL_LSEEK 26
#define SYSCALL_DUP2 27
#define SYSCALL_SEND_BYTE_OVER_UART 28

#define SYSCALL_CHDIR 29
#define SYSCALL_GETCWD 30
#define SYSCALL_MKDIR 31
#define SYSCALL_READ_DIRECTORY 32
#define SYSCALL_UNLINK 33
#define SYSCALL_RMDIR 34
#define SYSCALL_MOVE 35
#define SYSCALL_TOUCH 36

#define SYSCALL_LOAD_PROCESS_CONTINUE -1

struct LoadProcessRequest {
    char *path;
    bool show_loading_bar;
};

struct RunProcessRequest {
    int pid;
    char *arguments;
    char **environment;
};

struct WaitPidRequest {
    int pid;
    int *status;
};

struct KillRequest {
    int pid;
    int signal_number;
};

struct PrctlRequest {
    // Selects the operation, currently PR_SET_PDEATHSIG
    int option;
    // Supplies an implemented signal number or 0
    int argument;
};

struct ShmOpenRequest {
    char *name;
    size_t size;
};

struct GetCwdRequest {
    char *buffer;
    int size;
};

struct ReadDirectoryRequest {
    char *path;
    char *buffer;
    int capacity;
};

struct MoveRequest {
    char *old_path;
    char *new_path;
};
