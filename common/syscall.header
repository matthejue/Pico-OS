#pragma once

#include "stddef.header"

#define SYSCALL_SEND_BYTE_OVER_UART 0
#define SYSCALL_SHUTDOWN 2
#define SYSCALL_LOAD_PROCESS 3
#define SYSCALL_LIST_PROCESSES 4
#define SYSCALL_UNLOAD_PROCESS 5
#define SYSCALL_PROCESS_HEAP_START 6
#define SYSCALL_PROCESS_HEAP_SIZE 7
#define SYSCALL_RUN_PROCESS_WITH_ARGUMENTS 8
#define SYSCALL_EXIT 9
#define SYSCALL_WAITPID 10
#define SYSCALL_SLEEP 11
#define SYSCALL_WAKEUP 12
#define SYSCALL_YIELD 13
#define SYSCALL_GETPID 14
#define SYSCALL_OPEN 15
#define SYSCALL_READ 16
#define SYSCALL_WRITE 17
#define SYSCALL_CLOSE 18
#define SYSCALL_LSEEK 19
#define SYSCALL_FILE_DESCRIPTORS_AVAILABLE 20
#define SYSCALL_SHM_OPEN 21
#define SYSCALL_MMAP 22
#define SYSCALL_SHM_UNLINK 23
#define SYSCALL_DUP2 24
#define SYSCALL_RESET_PROCESSES 25
#define SYSCALL_KILL 27
#define SYSCALL_PRCTL 29
#define SYSCALL_SET_FOREGROUND_PROCESS 30
#define SYSCALL_PROCESS_HEAP_FULL 31
#define SYSCALL_CHDIR 32
#define SYSCALL_GETCWD 33
#define SYSCALL_MKDIR 34
#define SYSCALL_READ_DIRECTORY 35
#define SYSCALL_UNLINK 36
#define SYSCALL_RMDIR 37
#define SYSCALL_MOVE 38
#define SYSCALL_TOUCH 39
#define SYSCALL_REBOOT 40

#define SYSCALL_LOAD_PROCESS_CONTINUE -1

struct LoadProcessRequest {
    char *path;
    bool show_loading_bar;
};

struct RunProcessRequest {
    int pid;
    char *arguments;
    char **environment;
};

struct WaitPidRequest {
    int pid;
    int *status;
};

struct KillRequest {
    int pid;
    int signal_number;
};

struct PrctlRequest {
    // Selects the operation, currently PR_SET_PDEATHSIG
    int option;
    // Supplies an implemented signal number or 0
    int argument;
};

struct ShmOpenRequest {
    char *name;
    size_t size;
};

struct GetCwdRequest {
    char *buffer;
    int size;
};

struct ReadDirectoryRequest {
    char *path;
    char *buffer;
    int capacity;
};

struct MoveRequest {
    char *old_path;
    char *new_path;
};
