#pragma once

#include "stddef.header"

struct BlockHeader {
    int size;
    bool free;
    struct BlockHeader *next;
};

struct Heap {
    struct BlockHeader *first_block;
};

void heap_init_region(struct Heap *heap, void *start, int cell_count);
void *heap_alloc_from(struct Heap *heap, int size);
void *heap_realloc_from(struct Heap *heap, void *ptr, int size);
void heap_free_from(struct Heap *heap, void *ptr);
