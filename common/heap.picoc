#include "heap.header"

void heap_copy_cells(void *destination, void *source, int count) {
    int *destination_cells = (int *)destination;
    int *source_cells = (int *)source;
    int index = 0;

    while (index < count) {
        destination_cells[index] = source_cells[index];
        index = index + 1;
    }
}

void heap_split_block(struct BlockHeader *block, int size) {
    struct BlockHeader *new_block;

    // Keep the requested part and turn the remaining cells into a free block.
    if (block->size >= size + sizeof(struct BlockHeader) + 1) {
        new_block = (struct BlockHeader *)((int *)(block + 1) + size);

        new_block->size = block->size - size - sizeof(struct BlockHeader);
        new_block->free = true;
        new_block->next = block->next;

        block->size = size;
        block->next = new_block;
    }
}

void heap_merge_free_blocks(struct Heap *heap) {
    struct BlockHeader *current;

    if (heap == NULL) {
        return;
    }

    current = heap->first_block;

    while (current != NULL && current->next != NULL) {
        if (current->free == true && current->next->free == true) {
            current->size = current->size + sizeof(struct BlockHeader) + current->next->size;
            current->next = current->next->next;
        } else {
            current = current->next;
        }
    }
}

void heap_init_region(struct Heap *heap, void *start, int cell_count) {
    if (heap == NULL) {
        return;
    }

    if (start == NULL || cell_count <= sizeof(struct BlockHeader)) {
        heap->first_block = NULL;
        return;
    }

    heap->first_block = (struct BlockHeader *)start;
    heap->first_block->size = cell_count - sizeof(struct BlockHeader);
    heap->first_block->free = true;
    heap->first_block->next = NULL;
}

void *heap_alloc_from(struct Heap *heap, int size) {
    struct BlockHeader *current;

    if (heap == NULL || size <= 0) {
        return NULL;
    }

    current = heap->first_block;

    while (current != NULL) {
        if (current->free == true && current->size >= size) {
            heap_split_block(current, size);
            current->free = false;
            return (void *)(current + 1);
        }

        current = current->next;
    }

    return NULL;
}

void *heap_realloc_from(struct Heap *heap, void *ptr, int size) {
    struct BlockHeader *header;
    void *new_ptr;
    int copy_size;

    if (heap == NULL) {
        return NULL;
    }

    // realloc(ptr, 0) frees the block.
    if (size <= 0) {
        heap_free_from(heap, ptr);
        return NULL;
    }

    // realloc(NULL, size) behaves like malloc(size).
    if (ptr == NULL) {
        return heap_alloc_from(heap, size);
    }

    header = (struct BlockHeader *)ptr - 1;

    // Shrink in place and release any useful tail space.
    if (header->size >= size) {
        heap_split_block(header, size);
        heap_merge_free_blocks(heap);
        return ptr;
    }

    // Grow in place when the following block is free and large enough.
    if (header->next != NULL && header->next->free == true) {
        if (header->size + sizeof(struct BlockHeader) + header->next->size >= size) {
            header->size = header->size + sizeof(struct BlockHeader) + header->next->size;
            header->next = header->next->next;

            heap_split_block(header, size);
            return ptr;
        }
    }

    // Fallback: allocate a new block, copy the old cells, then free the old block.
    new_ptr = heap_alloc_from(heap, size);

    if (new_ptr == NULL) {
        return NULL;
    }

    // Copy only the overlap between the old block and the new requested size.
    copy_size = header->size;
    if (size < copy_size) {
        copy_size = size;
    }

    heap_copy_cells(new_ptr, ptr, copy_size);
    heap_free_from(heap, ptr);

    return new_ptr;
}

void heap_free_from(struct Heap *heap, void *ptr) {
    struct BlockHeader *header;

    if (heap == NULL || ptr == NULL) {
        return;
    }

    header = (struct BlockHeader *)ptr - 1;
    header->free = true;

    heap_merge_free_blocks(heap);
}
