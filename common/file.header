#pragma once

#define STDIN_FILENO 0
#define STDOUT_FILENO 1
#define STDERR_FILENO 2

#define O_RDONLY 0
#define O_WRONLY 1
#define O_RDWR 2
#define O_ACCMODE 3
#define O_CREAT 64
#define O_TRUNC 512
#define O_APPEND 1024

#define SEEK_SET 0
#define SEEK_CUR 1
#define SEEK_END 2

struct OpenRequest {
    char *path;
    int flags;
};

struct IoRequest {
    int file_descriptor;
    char *buffer;
    int count;
};

struct SeekRequest {
    int file_descriptor;
    int offset;
    int origin;
};
