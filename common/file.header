#pragma once

#include "stddef.header"

#define STDIN_FILENO 0
#define STDOUT_FILENO 1
#define STDERR_FILENO 2

#define O_RDONLY 0
#define O_WRONLY 1
#define O_RDWR 2
#define O_ACCMODE 3
#define O_CREAT 64
#define O_TRUNC 512
#define O_APPEND 1024

#define SEEK_SET 0
#define SEEK_CUR 1
#define SEEK_END 2

#define PATH_MAX 512

#define FILE_TYPE_REGULAR 1
#define FILE_TYPE_DIRECTORY 2

struct OpenRequest {
    char *path;
    int flags;
};

struct IoRequest {
    int file_descriptor;
    char *buffer;
    int count;
    bool show_loading_bar;
};

struct SeekRequest {
    int file_descriptor;
    int offset;
    int origin;
    bool show_loading_bar;
};

struct Dup2Request {
    int old_file_descriptor;
    int new_file_descriptor;
};
